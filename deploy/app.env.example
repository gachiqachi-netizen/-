# 运行模式：生产固定 production；见 server/env.py。
ENV=production
# 体验版服务器设 WXACODE_ENV_VERSION=trial；正式上线前改为 release 或删掉。
# 可选值：release / trial / develop；未设置时 ENV=trial 使用 trial，其余使用 release。
# WXACODE_ENV_VERSION=trial
# 容器内部服务端口；见 Dockerfile。
PORT=8800
# 容器内部监听地址；8800 只经宿主机 127.0.0.1 转发。
SERVER_HOST=0.0.0.0
# 数据目录；应用容器挂载 /data。
DATA_DIR=/data
# PostgreSQL：从本次部署自行创建的数据库用户名、密码、库名填写；与下方 DATABASE_URL 一致。
POSTGRES_USER=<数据库用户名>
POSTGRES_PASSWORD=<数据库密码>
POSTGRES_DB=<数据库名>
# PostgreSQL 连接串；凭据必须与上方三项一致。特殊字符先按 URL 规则编码。
DATABASE_URL=postgresql://<数据库用户名>:<数据库密码>@postgres:5432/<数据库名>
# 后台管理口令：负责人生成随机高强度值；只存服务器此文件。
ADMIN_TOKEN=<后台随机口令>
# 微信公众平台小程序后台「开发管理」取得 AppID 和 AppSecret。
WECHAT_APP_ID=<小程序AppID>
WECHAT_APP_SECRET=<小程序AppSecret>
# 微信商户平台「账户中心/商户信息」取得商户号。
WXPAY_MCHID=<商户号>
# 与 WECHAT_APP_ID 填同一个已关联商户号的小程序 AppID。
WXPAY_APPID=<小程序AppID>
# 微信商户平台「API 安全」设置的 32 字节 APIv3 密钥。
WXPAY_API_V3_KEY=<32字节APIv3密钥>
# 微信商户平台「API 安全」商户证书序列号。
WXPAY_CERT_SERIAL=<商户证书序列号>
# 商户 API 证书私钥，文件放 deploy/secrets，容器中路径如下。
WXPAY_PRIVATE_KEY_PATH=/secrets/merchant_private.pem
# 微信支付公钥文件与公钥 ID，从微信商户平台「API 安全」下载/复制。
WXPAY_PLATFORM_PUBLIC_KEY_PATH=/secrets/wechatpay_public.pem
WXPAY_PLATFORM_PUBLIC_KEY_ID=<微信支付公钥ID>
# 如改用微信支付平台证书，填其 /secrets/... 路径，并清空上方两项。
WXPAY_PLATFORM_CERT_PATH=
# 公网 HTTPS 回调：域名来自已备案且配好证书的 API 域名。
WXPAY_NOTIFY_URL=https://<API域名>/api/payments/notify
# 支付通道：生产必须 wechat，不可用 mock。
PAYMENT_PROVIDER=wechat
# 对外 HTTPS 根地址，供图片审核临时取图；使用同一个 API 域名。
PUBLIC_BASE_URL=https://<API域名>
# 图片临时链接签名密钥：负责人生成独立随机值。
MEDIA_LINK_SECRET=<图片签名随机密钥>
# 评价图片默认人工审核；仅配置 on 时送微信异步机审。
IMAGE_SEC_CHECK=off
# 用户手机号散列盐：负责人生成独立随机值，不与其他密钥复用。
PHONE_SALT=<手机号散列随机盐>

# 以下为可选配置；不用时保持空值，不要把示例占位符投入生产。
# 后台会话秒数，默认 28800；按运维策略填写。
ADMIN_SESSION_TTL=28800
# 图片目录；默认 /data/uploads。
UPLOADS_DIR=
# 手部追踪模型目录；只有启用相关本地模型时填写。
MODELS_DIR=
# AI 日志保留天数；默认读代码内置值。
AI_LOGS_RETENTION_DAYS=
# AI 服务商：按实际使用的服务商填写 zerone/openai/claude；不用 AI 时留空。
AI_PROVIDER=
# ZerOne Agent 控制台取得 URL、API Key、Agent 名和超时秒数。
ZERONE_AGENT_URL=
ZERONE_AGENT_API_KEY=
ZERONE_AGENT_NAME=beadloop
ZERONE_AGENT_TIMEOUT=180
# 兼容 OpenAI 的模型服务控制台取得 URL、API Key 和模型名。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-plus
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=
# Anthropic 控制台取得密钥；大陆公众服务不建议使用此项。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 微信公众平台「订阅消息」模板 ID；不用订阅消息时留空。
NOTIFY_TPL_SHIPPED=
NOTIFY_TPL_DELIVERED=
NOTIFY_TPL_REFUNDED=
# 微信公众平台消息校验 Token；不用消息校验时留空。
WECHAT_MSG_TOKEN=

# 生产禁止启用以下开发开关；保持空值。
DEV_LOGIN=
DEMO_ORDERS=
MOCK_PAYMENT_IN_TRIAL=
AI_ALLOW_FALLBACK=
ALLOW_PUBLIC_BIND=
# SQLite 路径；生产使用 DATABASE_URL，此项留空。
DATABASE_PATH=
