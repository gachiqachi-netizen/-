/*
 * 串个珠 设计变量（2026-11-12 重写：全站“白盒”，首页也是）
 *
 * 用法：复制到 miniprogram/styles/tokens.wxss，在 app.wxss 第一行 @import "styles/tokens.wxss";
 * 变量挂在 page 上，自定义组件里可以直接 var(--xxx)（CSS 变量会穿过组件边界继承）。
 * 规则：页面和组件的 wxss 里不出现颜色、字号、字重、圆角、阴影的字面量，一律引用这里的变量。
 * 换算：以 375 宽为准，1px = 2rpx。
 * 预算：颜色 9（实际用 8）、字号 4、字重 2、圆角 2、阴影 1、间距 3。共 26 个变量，上限 30。加变量前先看 03 第 11 节。
 * 第一期不做深色模式。
 */

page {
  /* 颜色 8 个：中性 5 级 + 强调 + 警示红 + 遮罩。预算里的“成功色”没有用，留着名额 */
  --c-bg: #ffffff;                 /* 页面底 */
  --c-surface: #f4f4f4;            /* 卡面：提示底、次按钮底、输入条底、对话气泡、骨架块 */
  --c-line: #e8e8e8;               /* 分隔：1rpx 分隔线、图片加载前的占位块 */
  --c-text-2: #6e6e6e;             /* 次要字（白底对比度 5.1，卡面上 4.6） */
  --c-text: #111111;               /* 主字，也是主按钮底色 */
  --c-accent: #4a7189;             /* 强调（灰蓝）：只表示“轮到你处理”，如待支付、已签收待确认、进度当前步 */
  --c-danger: #c2352b;             /* 警示红：只给材料安全提示和错误 */
  --c-mask: rgba(0, 0, 0, 0.45);   /* 弹层遮罩 */

  /* 字号 4 档 */
  --fs-display: 56rpx;             /* 大标题：首页标题、订单主状态、手围数字 */
  --fs-title: 34rpx;               /* 标题：手串名、弹层标题、合计金额 */
  --fs-body: 28rpx;                /* 正文、按钮、列表 */
  --fs-caption: 24rpx;             /* 辅助字 */

  /* 字重 2 档 */
  --fw-regular: 400;
  --fw-bold: 600;

  /* 行高（跟着字号走，不单独调） */
  --lh-tight: 1.25;                /* 大标题、标题 */
  --lh-body: 1.6;                  /* 正文、辅助字 */

  /* 圆角 2 档 */
  --r-panel: 0rpx;                 /* 只用来看的：照片、列表、版面、弹层，直角 */
  --r-pill: 999rpx;                /* 能点的：按钮、输入条、标签、发送键、头像，胶囊或圆形 */

  /* 阴影 1 种：只给底部操作栏和弹层 */
  --shadow-float: 0 -8rpx 32rpx rgba(0, 0, 0, 0.08);

  /* 间距 3 档 */
  --sp-tight: 16rpx;               /* 紧：同一组里的元素之间 */
  --sp-base: 40rpx;                /* 常规：页面左右边距、列表行上下留白 */
  --sp-section: 64rpx;             /* 段落：区块与区块之间 */

  /* 尺寸 */
  --h-btn: 104rpx;                 /* 按钮唯一的高度 */
  --h-btn-s: 64rpx;                /* 列表内的小号按钮 */
  --h-row: 112rpx;                 /* 列表行最小高度 */

  /* 动效 */
  --dur: 200ms;

  background: var(--c-bg);
  color: var(--c-text);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

/* 没有任何页面可以覆盖这些变量。首页和其他页面是同一套。 */
