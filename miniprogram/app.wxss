@import "styles/tokens.wxss";
page{background:var(--c-bg);color:var(--c-text);font-size:var(--fs-body)}button{font-size:var(--fs-body);border-radius:var(--r-pill);line-height:1.4}button::after{border:0}.wrap{padding:28rpx}.card{border-radius:var(--r-panel);padding:26rpx;margin-bottom:20rpx;background:var(--c-bg)}.title{font-size:var(--fs-title);font-weight:var(--fw-bold)}.sub{color:var(--c-text-2);font-size:var(--fs-caption)}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.primary{background:var(--c-text);color:var(--c-bg)}.muted{color:var(--c-text-2)}.chips{display:flex;gap:12rpx;white-space:nowrap}.chip{display:inline-block;padding:12rpx 22rpx;border:1rpx solid var(--c-line);border-radius:var(--r-pill);margin-right:10rpx;font-size:var(--fs-caption)}.active{color:var(--c-text);border-color:var(--c-text);background:var(--c-bg)}.actions{display:flex;gap:16rpx}.actions button{flex:1}.error{color:var(--c-danger)}
.t-display{font-size:var(--fs-display);line-height:var(--lh-tight);font-weight:var(--fw-bold)}.t-title{font-size:var(--fs-title);line-height:var(--lh-tight);font-weight:var(--fw-bold)}.t-body{font-size:var(--fs-body);line-height:var(--lh-body)}.t-caption{font-size:var(--fs-caption);line-height:var(--lh-body)}.t-2{color:var(--c-text-2)}.t-bold{font-weight:var(--fw-bold)}.t-num{font-variant-numeric:tabular-nums}
