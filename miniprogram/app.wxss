page{background:#fff;color:#1f1b1a;font-size:28rpx}button{font-size:28rpx;border-radius:18rpx;line-height:1.4}button::after{border:0}.wrap{padding:28rpx}.card{border:1rpx solid #eee;border-radius:22rpx;padding:26rpx;margin-bottom:20rpx;background:#fff}.title{font-size:36rpx;font-weight:600}.sub{color:#68625f;font-size:24rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.primary{background:#c8302e;color:#fff}.muted{color:#777}.chips{display:flex;gap:12rpx;white-space:nowrap}.chip{display:inline-block;padding:12rpx 22rpx;border:1rpx solid #ddd;border-radius:999rpx;margin-right:10rpx;font-size:24rpx}.active{color:#c8302e;border-color:#c8302e;background:#fff2f1}.actions{display:flex;gap:16rpx}.actions button{flex:1}.error{color:#b42318}
