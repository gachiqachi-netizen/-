<view class="page">
 <view class="stage {{modelLoading || error ? 'stage-hidden' : ''}}" style="height:{{height}}px">
  <canvas type="2d" id="picture" class="picture" style="width:{{pictureWidth || width}}px;height:{{pictureHeight || height}}px"/>
  <photo-ring wx:if="{{beads.length && catalog.length && !renderFailed}}" id="ring" class="overlay" viewport-width="{{width}}" viewport-height="{{height}}" style="display:block;width:{{width}}px;height:{{height}}px;opacity:{{tracked ? 1 : 0}}" beads="{{beads}}" catalog="{{catalog}}" size="{{size}}" angle="{{angle}}" tilt="{{tilt}}" hide-back="{{false}}" xpos="{{x}}" ypos="{{y}}" bind:unavailable="overlayError"/>
  <view class="wordmark">珠养养<text>ZHU YANG YANG</text></view>
 </view>
 <view wx:if="{{modelLoading && !error}}" class="state">
  <view class="state-title">{{modelProgress}}%</view>
  <view class="state-copy">第一次用要下载手部识别模型，只下一次</view>
  <progress percent="{{modelProgress}}" show-info="{{false}}" stroke-width="4" activeColor="#111111" backgroundColor="#eeeeee"/>
  <view class="state-link" bindtap="photoTryon">不等了，用照片试 ›</view>
 </view>
 <view wx:if="{{error}}" class="state">
  <view class="state-title">{{errorKind==='download' ? '没下载下来' : errorKind==='permission' ? '用不了相机' : errorKind==='unsupported' ? '这台手机用不了实时试戴' : '实时试戴暂时用不了'}}</view>
  <view class="state-copy">{{errorKind==='download' ? '网络不太好，手部识别模型没下完' : errorKind==='permission' ? '去设置里打开相机，或者用照片试' : '可以用照片试'}}</view>
  <button wx:if="{{errorKind==='download'}}" class="primary" bindtap="retry">再试一次</button>
  <button wx:else class="primary" bindtap="photoTryon">用照片试</button>
  <button wx:if="{{errorKind==='permission'}}" class="state-link" open-type="openSetting">去设置打开相机 ›</button>
  <view wx:else class="state-link" bindtap="photoTryon">用照片试 ›</view>
 </view>
 <view wx:if="{{!modelLoading && !error}}" class="bottom">
  <view wx:if="{{frozen}}" class="again" bindtap="toggleFreeze">再来一次</view>
  <view class="status">{{status}}</view>
  <view wx:if="{{!frozen}}" class="actions"><view bindtap="photoTryon">用照片试</view><button class="shutter" disabled="{{!tracked}}" bindtap="toggleFreeze" aria-label="定格"/><view></view></view>
  <view wx:else class="actions frozen-actions"><button bindtap="savePhoto">保存照片</button><button class="primary" bindtap="goOrder">去下单</button></view>
 </view>
 <camera wx:if="{{cameraMounted}}" class="capture" device-position="{{position}}" flash="off" frame-size="medium" bindinitdone="cameraReady" binderror="cameraError"/>
 <canvas class="compute" type="webgl" id="compute"/>
</view>
<privacy-popup scene="打开摄像头进行实时试戴" bind:reject="privacyRejected"/>
