.page{padding:24rpx 32rpx;background:white}.stage{position:relative;width:100%;overflow:hidden;border-radius:24rpx;background:#151515}.picture{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}.overlay{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.status{font-size:28rpx;margin-top:24rpx}.hint{font-size:24rpx;color:#625c58;line-height:1.6;margin:16rpx 0}.error{color:#b42318;margin:20rpx 0}.capture{position:fixed;left:-1000px;top:0;width:320px;height:480px}.compute{position:fixed;left:-1200px;top:0;width:256px;height:256px}

.controls{margin-top:20rpx}.scale-row{font-size:26rpx;margin-top:20rpx}.scale-row slider{margin:20rpx 8rpx}
