.page{min-height:100vh;background:var(--c-bg);color:var(--c-text);display:flex;flex-direction:column}.stage{position:relative;width:100%;overflow:hidden;background:var(--c-text)}.picture{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%)}.overlay{position:absolute;inset:0;pointer-events:none}.wordmark{position:absolute;right:32rpx;bottom:32rpx;color:var(--c-bg);font-family:serif;letter-spacing:8rpx;text-align:center;font-size:24rpx}.wordmark text{display:block;font-size:10rpx;letter-spacing:3rpx;margin-top:6rpx}.bottom{padding:28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));background:var(--c-bg)}.status{text-align:center;color:var(--c-text-2);font-size:24rpx;min-height:44rpx}.actions{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.actions>view{width:140rpx;font-size:26rpx}.shutter{width:112rpx;height:112rpx;border-radius:50%;border:8rpx solid var(--c-text);background:var(--c-bg);padding:0;margin:0}.shutter[disabled]{opacity:.4}.again{font-size:26rpx;padding-bottom:12rpx}.frozen-actions button{flex:1;border-radius:999rpx;font-size:28rpx}.primary{background:var(--c-text);color:var(--c-bg);border-radius:999rpx}.state{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:60rpx 48rpx}.state-title{font-size:72rpx;line-height:1.2}.state-copy{color:var(--c-text-2);font-size:26rpx;margin-top:24rpx}.state progress{width:100%;margin-top:40rpx}.state .primary{width:100%;margin-top:48rpx}.state-link{font-size:26rpx;margin-top:40rpx;background:transparent;border:0;color:var(--c-text)}.capture{position:fixed;left:-1000px;top:0;width:320px;height:480px}.compute{position:fixed;left:-1200px;top:0;width:256px;height:256px}

.stage-hidden{position:absolute;opacity:0;pointer-events:none}
