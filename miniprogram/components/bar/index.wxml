<view class="c-bar-holder" style="height: {{holderHeight}}px;">
  <view class="c-bar">
    <view class="c-bar__top" wx:if="{{layout === 'agreement'}}">
      <slot name="top" />
    </view>
    <view class="c-bar__main {{layout === 'dual' ? 'c-bar__main--dual' : ''}}">
      <view class="c-bar__left">
        <slot name="left" />
      </view>
      <view class="c-bar__btn"><slot name="secondary" wx:if="{{layout === 'dual'}}" />
        <slot />
      </view>
    </view>
  </view>
</view>
