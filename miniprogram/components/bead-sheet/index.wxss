.bead-sheet{position:relative;font-size:var(--fs-body);color:var(--c-text)}.gallery{height:300rpx;background:var(--c-surface);margin:0 calc(-1 * var(--sp-base))}.gallery-slide{height:100%;display:flex;align-items:center;justify-content:center}.gallery image{width:100%;height:100%}.gallery-count{position:absolute;right:0;top:264rpx;font-size:var(--fs-caption);color:var(--c-text-2)}.price{font-size:var(--fs-title);font-weight:var(--fw-bold);margin-top:var(--sp-tight)}.price text,.meaning,.label,.hint{font-size:var(--fs-caption);font-weight:var(--fw-regular);color:var(--c-text-2)}.name{font-weight:var(--fw-bold)}.meaning{margin-top:8rpx}.label{margin-top:var(--sp-base)}.sizes{display:flex;gap:var(--sp-tight);margin-top:var(--sp-tight);flex-wrap:wrap}.size{margin:0;background:var(--c-surface);font-size:var(--fs-caption);border-radius:var(--r-pill)}.size.active,.submit{background:var(--c-text);color:var(--c-bg)}.quantity{display:flex;align-items:center;justify-content:space-between;margin-top:var(--sp-base)}.step{display:flex;align-items:center;gap:24rpx}.step button{width:var(--h-btn-s);height:var(--h-btn-s);line-height:var(--h-btn-s);padding:0;margin:0;border-radius:var(--r-pill)}.hint{text-align:right;margin-top:var(--sp-tight)}.safety{background:var(--c-surface);font-size:var(--fs-caption);padding:var(--sp-tight);margin-top:var(--sp-tight)}.similar{margin-top:var(--sp-tight)}.submit{width:100%;height:var(--h-btn);border-radius:var(--r-pill);font-size:var(--fs-body)}
.gallery-slide c-bead{transform:scale(2.3)}
