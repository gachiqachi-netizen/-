:host{display:block}
.bead{border-radius:var(--r-pill);overflow:hidden;display:flex;align-items:center;justify-content:center}
.bead-s{width:48rpx;height:48rpx}
.bead-m{width:80rpx;height:80rpx}
.bead-l{width:120rpx;height:120rpx}
.bead.fluid{width:100%;height:100%}
.state-loading{background:var(--c-surface)}
.state-off{opacity:0.4}
.img{width:100%;height:100%}
