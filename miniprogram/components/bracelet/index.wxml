<view class="c-bracelet" style="width: {{size}}rpx; height: {{height}}rpx;">
  <view class="c-bracelet__wordmark" wx:if="{{wordmark && mode === 'ring'}}"><c-wordmark tone="line" size="{{wordmarkSize}}" /></view>
  <view
    wx:for="{{rings}}"
    wx:for-item="ring"
    wx:key="idx"
    wx:for-index="ri"
    class="c-bracelet__ring"
    style="width: {{size}}rpx; height: {{size}}rpx; margin-top: -{{size / 2}}rpx; opacity: {{ring.opacity}}; transform: translateY({{ring.ty}}rpx);"
  >
    <view
      wx:for="{{ring.items}}"
      wx:for-item="it"
      wx:key="index"
      class="c-bracelet__pos {{selected === it.index ? 'is-sel' : ''}} {{selected >= 0 && selected !== it.index ? 'is-dim' : ''}}"
      style="left: {{it.x}}rpx; top: {{it.y}}rpx; width: {{it.box}}rpx; height: {{it.box}}rpx;"
    >
      <view class="c-bracelet__beadwrap" style="width: {{it.d}}rpx; height: {{it.d}}rpx;">
        <view wx:if="{{it.metal}}" class="c-bracelet__metal" style="width: {{it.d}}rpx; height: {{it.d}}rpx; background: linear-gradient(90deg, {{it.shade}}, {{it.face}} 45%, {{it.shade}});" />
        <view wx:elif="{{size <= 240}}" class="c-bracelet__sphere" style="width: {{it.d}}rpx; height: {{it.d}}rpx; background: radial-gradient(circle at 32% 28%, {{it.face}}, {{it.shade}});" />
        <bead wx:else bead="{{it.bead}}" size="m" style="width: {{it.d}}rpx; height: {{it.d}}rpx;" />
      </view>
    </view>
  </view>
</view>
