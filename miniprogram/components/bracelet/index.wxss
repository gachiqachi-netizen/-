.c-bracelet {
  position: relative;
  overflow: hidden;
}

.c-bracelet__wordmark {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.c-bracelet__ring {
  position: absolute;
  left: 0;
  top: 50%;
}

.c-bracelet__pos {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
}

.c-bracelet__pos.is-sel {
  border: 3rpx solid var(--c-text);
}

.c-bracelet__pos.is-dim .c-bracelet__beadwrap {
  opacity: 0.35;
}

.c-bracelet__beadwrap {
  flex: none;
}

.c-bracelet__sphere,
.c-bracelet__metal {
  border-radius: var(--r-pill);
  box-sizing: border-box;
}

.c-bracelet__metal {
  border: 1rpx solid var(--c-text-2);
}
