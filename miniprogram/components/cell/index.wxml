<view class="c-cell-row" wx:if="{{!design}}" bindtap="onTap">
  <view class="c-cell-row__label">{{label}}<slot name="label" /></view>
  <view class="c-cell-row__right"><text>{{value}}</text><slot name="value" /><image wx:if="{{arrow}}" class="c-cell-row__arrow" src="../../assets/icons/chevron-right.svg" /><view wx:if="{{switch}}" class="c-cell-row__switch {{checked ? 'is-on' : ''}}" catchtap="onSwitch"><view class="c-cell-row__knob" /></view></view>
</view>
<view class="c-cell" wx:if="{{design}}">
  <view class="c-cell__img">
    <bracelet beads="{{design.beads}}" size="320" />
  </view>
  <view class="c-cell__tx">
    <view class="c-cell__name">{{design.name}}</view>
    <view class="c-cell__line">{{design.line}}</view>
    <view class="c-cell__price" wx:if="{{price}}">{{price}}</view>
  </view>
</view>
