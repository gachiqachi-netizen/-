/* 款式格（稿 03）：名字/寓意/价格字号位置写死，不开放属性改小 */
.c-cell {
  background: var(--c-bg);
  padding-bottom: 24rpx;
}

.c-cell__img {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.c-cell__tx {
  padding: 16rpx 28rpx 0;
}

.c-cell__name {
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-cell__line {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.c-cell__price {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  white-space: nowrap;
}
.c-cell-row { min-height: var(--h-row); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-tight); border-bottom: 1rpx solid var(--c-line); }
.c-cell-row__label { flex: 1; font-size: var(--fs-body); }
.c-cell-row__right { display: flex; align-items: center; gap: var(--sp-tight); color: var(--c-text-2); font-size: var(--fs-body); }
.c-cell-row__arrow { width: var(--sp-tight); height: var(--sp-tight); }
.c-cell-row__switch { width: var(--h-btn-s); height: var(--sp-base); padding: var(--sp-tight); box-sizing: border-box; display: flex; align-items: center; border-radius: var(--r-pill); background: var(--c-line); }
.c-cell-row__switch.is-on { justify-content: flex-end; background: var(--c-text); }
.c-cell-row__knob { width: var(--sp-tight); height: var(--sp-tight); border-radius: var(--r-pill); background: var(--c-bg); }
