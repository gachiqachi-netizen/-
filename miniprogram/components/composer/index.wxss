/* c-composer：AI 输入区（任务卡 C0i，稿 21/24/22）。
   颜色/字号/圆角一律用 tokens.wxss 变量；尺寸用 rpx。 */

/* 快捷回复：一排 chip，超出可横滑 */
.c-composer__chips {
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.c-composer__chip {
  margin-right: 16rpx;
}

/* 输入框大框：圆角 40rpx、浅灰底 */
.c-composer__box {
  padding: 20rpx 24rpx;
  border-radius: 40rpx;
  background: var(--c-surface);
}

/* 最多长到 5 行（28rpx * 1.6 * 5 = 224rpx），超出内部滚动 */
.c-composer__input {
  width: 100%;
  max-height: 224rpx;
  min-height: 45rpx;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--c-text);
  background: transparent;
}

/* 框内下面一排 */
.c-composer__tools {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-composer__left {
  display: flex;
  align-items: center;
  min-width: 0;
}

/* 圆形“+”按钮 / 语音键 / 发送键 */
.c-composer__round {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--r-pill);
  background: var(--c-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.c-composer__round--dark {
  background: var(--c-text);
}

.c-composer__icon {
  width: 40rpx;
  height: 40rpx;
}

/* 条件标签（如“手围 15cm”） */
.c-composer__tag {
  margin-left: 16rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-bg);
  font-size: var(--fs-caption);
  line-height: 56rpx;
  white-space: nowrap;
}

/* 按住说话的面板（稿 22） */
.c-composer__voice {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0 8rpx;
}

.c-composer__wave {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
}

.c-composer__bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: var(--c-text);
  animation: c-composer-wave 900ms ease-in-out infinite;
}

@keyframes c-composer-wave {
  0%,
  100% {
    transform: scaleY(0.4);
  }
  50% {
    transform: scaleY(1.8);
  }
}

.c-composer__hint {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

/* 黑色长按钮“松开 发送” */
.c-composer__send-big {
  width: 100%;
  height: 112rpx;
  border-radius: var(--r-pill);
  background: var(--c-text);
  color: var(--c-bg);
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

/* 资产里没有白色 mic 图标，发送条上的 mic 用反色滤镜 */
.c-composer__send-big-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}
