<view class="c-privacy" wx:if="{{visible}}">
  <view class="c-privacy__mask" />
  <view class="c-privacy__panel">
    <view class="c-privacy__grab" />
    <view class="c-privacy__title">用相机前，请先看一下</view>
    <view class="c-privacy__body">{{scene}}，需要用到你的相机或相册。照片仅在你确认后发送到识别服务；实时手腕画面只在本机处理。</view>
    <view class="c-privacy__link" bindtap="openPrivacy">查看《隐私保护指引》 ›</view>
    <view class="c-privacy__actions">
      <button class="c-btn c-btn--sec" bindtap="reject">先不用</button>
      <button id="agree-btn" class="c-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="agree">同意并继续</button>
    </view>
  </view>
</view>
