.privacy-mask{position:fixed;z-index:10000;inset:0;background:rgba(20,18,17,.5);display:flex;align-items:flex-end;padding:32rpx;box-sizing:border-box}.privacy-card{width:100%;background:#fff;border-radius:32rpx;padding:40rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}.privacy-title{font-size:36rpx;font-weight:600;margin-bottom:20rpx}.privacy-copy{font-size:28rpx;line-height:44rpx;color:#5e5753}.privacy-actions{display:flex;gap:20rpx;margin-top:32rpx}.privacy-actions button{flex:1;margin:0;border-radius:999rpx;font-size:28rpx}.privacy-secondary{background:#f4f2ef;color:#3d3835}.privacy-primary{background:#1f1b1a;color:#fff}
