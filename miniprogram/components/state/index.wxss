.c-state {
  text-align: center;
  padding: 160rpx 64rpx 0;
}

.c-state__title {
  font-size: var(--fs-title);
  font-weight: var(--fw-bold);
  line-height: var(--lh-tight);
}

.c-state__desc {
  margin-top: var(--sp-tight);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.c-state__action {
  width: 320rpx;
  flex: none;
  margin: 40rpx auto 0;
}

.c-state__link {
  display: inline-block;
  margin-top: var(--sp-tight);
}
