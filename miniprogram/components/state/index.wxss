.c-state {
  text-align: center;
  padding: 160rpx 64rpx 0;
}

.c-state__title {
  font-size: var(--fs-display);
  font-weight: var(--fw-bold);
  line-height: var(--lh-tight);
}

.c-state__desc {
  margin-top: var(--sp-tight);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.c-state__action { --state-action-width: 320rpx; }
button.c-btn.c-state__action:not([size=mini]) {
  width: var(--state-action-width);
  flex: none;
  margin: 40rpx auto 0;
  border: 1rpx solid var(--c-line);
}
