.edit-page{min-height:100vh;background:var(--c-surface);color:var(--c-text);padding:16rpx 0 0}.form-card{background:var(--c-bg);margin-bottom:16rpx;padding:0 40rpx}.form-row{min-height:112rpx;display:flex;align-items:center;border-bottom:1rpx solid var(--c-line);gap:20rpx;font-size:var(--fs-body)}.form-row:last-child{border-bottom:0}.label{width:152rpx;flex:none}.form-row input{flex:1;min-width:0;text-align:right;font-size:var(--fs-body)}.region{flex:1;text-align:right}.placeholder,.arrow,.hint{color:var(--c-text-2)}.arrow{font-size:var(--fs-title)}.field-error{color:var(--c-danger);font-size:var(--fs-caption);padding:0 0 16rpx 172rpx}.delete{color:var(--c-danger)}.hint{padding:16rpx 0;font-size:var(--fs-caption)}.error,.state{padding:24rpx 40rpx;color:var(--c-danger);font-size:var(--fs-caption)}.retry{display:block;color:var(--c-text);text-decoration:underline;margin-top:16rpx}
