.edit-surface { min-height: 100vh; background: var(--c-surface); margin: 0 calc(-1 * var(--sp-base)); padding: var(--sp-base); box-sizing: border-box; }
.form-card { padding: 0; }
.form-row { min-height: var(--h-row); display: flex; align-items: center; border-bottom: 1rpx solid var(--c-line); gap: var(--sp-tight); font-size: var(--fs-body); }
.form-row:last-child { border-bottom: 0; }
.label { width: 152rpx; flex: none; }
.form-row input { flex: 1; min-width: 0; text-align: right; font-size: var(--fs-body); }
.region { flex: 1; text-align: right; }
.placeholder, .arrow, .hint { color: var(--c-text-2); }
.arrow { font-size: var(--fs-title); }
.field-error { color: var(--c-danger); font-size: var(--fs-caption); padding: 0 0 var(--sp-tight) 172rpx; }
.hint { padding: var(--sp-tight) 0; font-size: var(--fs-caption); }
.error, .state { padding: var(--sp-base) 0; color: var(--c-danger); font-size: var(--fs-caption); }
.retry { display: block; color: var(--c-text); text-decoration: underline; margin-top: var(--sp-tight); }
