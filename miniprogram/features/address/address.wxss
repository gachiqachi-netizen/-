.address-page{min-height:100vh;background:var(--c-surface);color:var(--c-text);padding:16rpx 0 0}.address-card{background:var(--c-bg);margin:0 0 16rpx}.address-row{display:flex;align-items:center;min-height:144rpx;padding:0 40rpx;border-bottom:1rpx solid var(--c-line)}.address-row:last-child{border-bottom:0}.address-main{flex:1;min-width:0;padding:24rpx 0;font-size:var(--fs-body)}.address-name{font-weight:var(--fw-bold)}.muted,.default,.address-edit{color:var(--c-text-2);font-size:var(--fs-caption)}.address-edit{padding:32rpx 0 32rpx 24rpx;white-space:nowrap}.state{padding:48rpx 40rpx;color:var(--c-text-2);font-size:var(--fs-body)}.retry{display:block;margin-top:16rpx;color:var(--c-text);text-decoration:underline}
