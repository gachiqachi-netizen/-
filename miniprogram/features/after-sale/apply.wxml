<c-page bar="{{option}}">
  <view class="surface">
    <c-card wx:if="{{loading}}"><view class="hint">正在读取申请选项…</view></c-card>
    <c-state wx:if="{{loginRequired}}" title="登录后申请售后" desc="登录后就能查看这笔订单" action="去登录" bind:action="goLogin" />
    <c-state wx:elif="{{error && !option}}" title="暂时不能申请" desc="{{error}}" action="再试一次" bind:action="load" />
    <view wx:elif="{{error}}" class="error">{{error}}</view>
    <block wx:if="{{option}}">
      <c-card><view class="summary">{{option.label}}</view></c-card>
      <c-card><c-cell label="原因" value="{{reason || '请选择原因'}}" arrow="{{true}}" bind:tap="toggleReasons" /><view wx:if="{{reasonOpen}}" class="reasons"><view wx:for="{{reasons}}" wx:key="*this" class="reason" data-reason="{{item}}" bindtap="chooseReason">{{item}}</view></view></c-card>
      <c-card><view class="field"><view>照片 <text class="hint">最多 6 张，质量问题必填</text></view>
      <view class="photos"><view wx:for="{{photos}}" wx:key="path" class="photo"><image src="{{item.path}}" mode="aspectFill" data-index="{{index}}" bindtap="retryPhoto"/><text wx:if="{{item.busy}}">上传中…</text><text wx:if="{{item.error}}" data-index="{{index}}" bindtap="retryPhoto">{{item.error}}</text><text class="remove" data-index="{{index}}" bindtap="removePhoto">×</text></view><view wx:if="{{photos.length < 6}}" class="add" bindtap="addPhoto">＋</view></view>
        <view wx:if="{{photoError}}" class="error">{{photoError}}</view>
      </view></c-card>
      <c-card><view class="field"><view>说明 <text class="hint">选填</text></view><textarea maxlength="500" placeholder="请描述遇到的问题" value="{{note}}" bindinput="inputNote"/></view><c-cell label="退款金额" value="¥{{amount}}" /><view class="field"><view>联系电话</view><input type="number" maxlength="11" value="{{phone}}" bindinput="inputPhone" placeholder="请输入联系电话" /></view><view wx:if="{{option.type === '改手围重串'}}" class="field"><view>新手围（cm）</view><input type="digit" value="{{newWrist}}" bindinput="inputWrist" placeholder="13–20"/></view></c-card>
      <view class="hint footnote">审核通过后，按页面提示寄回。</view>
    </block>
  </view>
  <c-bar wx:if="{{option}}" layout="single"><button class="c-btn {{!reason || submitting ? 'is-off' : ''}}" disabled="{{!reason || submitting}}" loading="{{submitting}}" bindtap="submit">{{submitting ? '正在提交……' : (reason ? '提交申请' : '先选一个原因')}}</button></c-bar>
</c-page>
<privacy-popup kind="photo" scene="上传照片" bind:reject="privacyRejected"/>
