<view class="page">
  <c-state wx:if="{{error && !sale}}" title="售后记录暂时无法读取" desc="{{error}}" action="重试" bindaction="load"/>
  <block wx:if="{{sale}}">
    <view class="card status"><view class="status-label">{{view.label}}</view><view class="hint">{{view.description}}</view>
      <view wx:if="{{view.returning && sale.returnAddress}}" class="address"><text>寄到：{{sale.returnAddress.person}}　{{sale.returnAddress.phone}}　{{sale.returnAddress.address}}</text><text bindtap="copyAddress">复制地址</text></view><view wx:elif="{{view.returning}}" class="hint">寄回地址稍后由客服告知</view>
    </view>
    <view class="card link" bindtap="openHistory"><text>协商历史</text><text>›</text></view>
    <view class="card"><view class="row"><text>售后类型</text><text>{{sale.type}}</text></view><view class="row"><text>原因</text><text>{{sale.reason}}</text></view><view class="row" wx:if="{{sale.refundFen}}"><text>退款金额</text><text>¥{{view.refund}}</text></view><view class="row"><text>申请时间</text><text>{{sale.createdAt}}</text></view><view class="row"><text>售后编号</text><text>{{sale.no}}</text></view><view class="row" wx:if="{{view.contactPhone}}"><text>联系电话</text><text>{{view.contactPhone}}</text></view><view class="row" wx:if="{{view.photos.length}}"><text>申请照片</text><text>{{view.photos.length}} 张</text></view></view>
    <view class="card product" wx:if="{{order}}"><view class="product-name">{{order.designSnapshot.name || order.name}}</view><view class="hint">{{order.designSnapshot.beads.length}} 颗 · 手围 {{order.wrist}}cm</view></view>
    <view class="actions" wx:if="{{view.canCancel || view.canSubmitReturn || view.canReorder || sale.status === 'closed' || (sale.status === 'rejected' && sale.result)}}"><button wx:if="{{view.canCancel}}" bindtap="openCancel">{{cancelLabel}}</button><button wx:if="{{sale.status === 'closed'}}" bindtap="reapply">{{reapplyLabel}}</button><button wx:if="{{view.canReorder}}" bindtap="copyAgain">再串一条</button><text wx:if="{{sale.status === 'rejected' && sale.result}}" class="hint">{{sale.result}}</text><button wx:if="{{view.canSubmitReturn}}" class="primary" bindtap="goReturn">{{returnLabel}}</button></view>
  </block>
</view>
<c-sheet show="{{historyOpen}}" title="协商历史" bindclose="closeHistory"><view class="history" wx:for="{{view.history}}" wx:key="at"><view>{{item.label}}</view><view class="hint">{{item.at}}</view></view></c-sheet>
<c-sheet show="{{cancelOpen}}" title="撤销这次申请？" bindclose="closeCancel"><view class="hint">撤销后可以重新申请</view><view slot="footer" class="confirm-actions"><button bindtap="closeCancel">先不撤销</button><button class="primary" bindtap="confirmCancel">{{cancelLabel}}</button></view></c-sheet>
<c-toast/>
