.page{min-height:100vh;background:var(--c-surface);padding:var(--sp-tight) var(--sp-base) 160rpx;box-sizing:border-box;color:var(--c-text)}.card{background:var(--c-bg);padding:var(--sp-base);margin-bottom:var(--sp-tight)}.status-label{font-size:var(--fs-title);font-weight:var(--fw-bold)}.hint{font-size:var(--fs-caption);color:var(--c-text-2);line-height:var(--lh-body)}.address{display:flex;justify-content:space-between;gap:var(--sp-tight);margin-top:var(--sp-base);font-size:var(--fs-caption)}.address text:last-child{white-space:nowrap}.link,.row{display:flex;justify-content:space-between;align-items:center;min-height:var(--h-row);gap:var(--sp-tight)}.row+.row{border-top:1rpx solid var(--c-line)}.row text:last-child{text-align:right}.product-name{font-weight:var(--fw-bold)}.actions{position:fixed;bottom:0;left:0;right:0;padding:var(--sp-tight) var(--sp-base) calc(var(--sp-tight) + env(safe-area-inset-bottom));background:var(--c-bg);box-shadow:var(--shadow-float);display:flex;justify-content:flex-end;gap:var(--sp-tight)}button{margin:0;border-radius:var(--r-pill);font-size:var(--fs-body)}.primary{background:var(--c-text);color:var(--c-bg)}.history{border-left:2rpx solid var(--c-line);padding:0 0 var(--sp-base) var(--sp-base)}.confirm-actions{display:flex;justify-content:flex-end;gap:var(--sp-tight)}
