.page{min-height:100vh;background:var(--c-surface);padding:var(--sp-tight) var(--sp-base) 160rpx;box-sizing:border-box;color:var(--c-text)}.card{background:var(--c-bg);padding:var(--sp-base);margin-bottom:var(--sp-tight)}.address{position:relative;padding-right:160rpx}.address button{position:absolute;right:var(--sp-base);top:var(--sp-base)}.hint{color:var(--c-text-2);font-size:var(--fs-caption);margin-top:var(--sp-tight)}.row{display:flex;align-items:center;justify-content:space-between;min-height:var(--h-row);gap:var(--sp-tight)}.row+.row{border-top:1rpx solid var(--c-line)}.row input{flex:1;text-align:right}.row button{font-size:var(--fs-caption)}button{border-radius:var(--r-pill);margin:0}.actions{position:fixed;bottom:0;left:0;right:0;background:var(--c-bg);padding:var(--sp-tight) var(--sp-base) calc(var(--sp-tight) + env(safe-area-inset-bottom));display:flex;justify-content:flex-end;box-shadow:var(--shadow-float)}.primary{background:var(--c-text);color:var(--c-bg)}.error{color:var(--c-danger);font-size:var(--fs-caption)}
