<view class="page">
  <view wx:if="{{loading}}" class="hint">正在读取订单…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <block wx:if="{{order}}">
    <view class="summary"><view class="name">{{order.name}}</view><view class="hint">订单 {{order.no}} · 实付 ¥{{order.total}}</view></view>
    <view wx:for="{{types}}" wx:key="type" class="option" data-type="{{item.type}}" bindtap="select">
      <view><view class="option-title">{{item.label}}</view><view class="hint">{{item.description}}</view></view><text>›</text>
    </view>
    <view wx:if="{{!types.length}}" class="empty">已经过了在线申请的时间，请联系客服</view>
    <view class="policy">定制商品非质量问题不支持七天无理由退换。<text bindtap="showPolicy">查看售后政策</text></view>
  </block>
</view>
<c-sheet show="{{policyOpen}}" title="售后政策" maskClose="{{false}}"><view>定制商品非质量问题不支持七天无理由退换。</view><button slot="footer" bindtap="closePolicy">确定</button></c-sheet>
