.surface { min-height: 100vh; background: var(--c-bg); margin: 0 calc(-1 * var(--sp-base)); padding: var(--sp-base); box-sizing: border-box; }
.summary { padding: var(--sp-base) 0; }
.name { font-size: var(--fs-body); font-weight: var(--fw-bold); }
.hint, .policy { font-size: var(--fs-caption); color: var(--c-text-2); }
.hint { margin-top: var(--sp-tight); }
.policy { margin-top: var(--sp-section); }
.policy text { color: var(--c-text); text-decoration: underline; }
.empty { padding: var(--sp-section) 0; color: var(--c-text-2); }
.error { color: var(--c-danger); }
.footer { display: flex; width: 100%; }
