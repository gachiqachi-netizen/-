.page{padding:var(--sp-base)}
.title{font-size:var(--fs-title);font-weight:var(--fw-bold);margin-bottom:var(--sp-section)}
.summary{padding:var(--sp-base);background:var(--c-surface);margin-bottom:var(--sp-section)}
.name,.option-title{font-size:var(--fs-body);font-weight:var(--fw-bold)}
.hint,.policy{font-size:var(--fs-caption);color:var(--c-text-2)}
.option{display:flex;align-items:center;justify-content:space-between;min-height:var(--h-row);border-bottom:1rpx solid var(--c-line)}
.option text{font-size:var(--fs-title)}
.policy{margin-top:var(--sp-section)}
.policy text{color:var(--c-text);text-decoration:underline}
.empty{padding:var(--sp-section) 0;color:var(--c-text-2)}
.error{color:var(--c-danger)}
