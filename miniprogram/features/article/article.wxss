.page { min-height: 100vh; background: var(--c-bg); }
.hero { height: 470rpx; background: var(--c-surface); display: flex; align-items: center; justify-content: center; overflow: hidden; }
.cover { width: 100%; height: 100%; }
.content { padding: 32rpx 40rpx 80rpx; }
.share { display: block; margin: 0 0 24rpx auto; padding: 0; width: fit-content; background: transparent; color: var(--c-text-2); font-size: var(--fs-caption); line-height: 1.5; }
.share::after { border: 0; }
.title { font-size: var(--fs-title); font-weight: var(--fw-bold); color: var(--c-text); margin-bottom: 32rpx; }
.paragraph { font-size: var(--fs-body); color: var(--c-text); line-height: 1.7; margin-bottom: 28rpx; }
.loading { padding: 48rpx 40rpx; font-size: var(--fs-body); color: var(--c-text-2); }
