<view class="page">
  <view wx:if="{{loading}}" class="loading">说明正在加载</view>
  <c-state wx:elif="{{error}}" title="暂时看不到这份说明" desc="{{error}}" action="再试一次" bind:action="load" />
  <view wx:else class="content">
    <view class="title">{{title}}</view>
    <view wx:for="{{sections}}" wx:key="index" class="section">
      <view wx:if="{{item.heading}}" class="heading">{{item.heading}}</view>
      <view class="paragraph">{{item.text}}</view>
    </view>
  </view>
</view>
