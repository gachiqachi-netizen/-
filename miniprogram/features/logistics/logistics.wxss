.page { min-height: 100vh; background: var(--c-surface); padding: 24rpx; box-sizing: border-box; color: var(--c-text); font-size: var(--fs-body); }
.card { background: var(--c-bg); margin-bottom: 20rpx; padding: 0 24rpx; }
.row { min-height: 96rpx; display: flex; align-items: center; gap: 16rpx; border-bottom: 1rpx solid var(--c-line); }
.row:last-child { border-bottom: 0; }
.tracking { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
.destination { flex: 1; text-align: right; color: var(--c-text-2); }
.small { flex: none; width: auto; height: 64rpx; padding: 0 20rpx; font-size: var(--fs-caption); }
.timeline { padding: 20rpx 24rpx; }
.track { display: flex; gap: 20rpx; padding: 16rpx 0; color: var(--c-text-2); }
.dot { width: 14rpx; height: 14rpx; flex: none; border-radius: 50%; background: var(--c-line); margin-top: 12rpx; }
.newest { color: var(--c-text); font-weight: var(--fw-bold); }
.newest .dot { background: var(--c-text); }
.track-detail { line-height: 1.5; }
.track-time { font-size: var(--fs-caption); margin-top: 8rpx; }
.empty-track { padding: 40rpx 24rpx; color: var(--c-text-2); text-align: center; }
.field { min-height: 92rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--c-line); }
.field > text { display: inline-block; width: 150rpx; }
.field input, .field picker { display: inline-block; width: calc(100% - 150rpx); }
.field-error { color: var(--c-danger); font-size: var(--fs-caption); margin-left: 150rpx; }
.option { padding: 28rpx 0; border-bottom: 1rpx solid var(--c-line); }
.hint { color: var(--c-text-2); font-size: var(--fs-caption); padding: 20rpx 0; }
