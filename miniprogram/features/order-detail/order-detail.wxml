<c-page>
  <view class="detail-surface">
    <c-card wx:if="{{loading}}"><view class="order-loading"><c-skeleton shape="line" width="40%" font="title"/><c-skeleton shape="line" width="70%" font="body"/><c-skeleton shape="block" width="100%" ratio="5/2"/><c-skeleton shape="pill" width="100%"/></view></c-card>
    <c-state wx:elif="{{error && !order}}" title="没找到这笔订单" action="重新加载" bind:action="load" />
    <block wx:elif="{{order}}">
      <c-card wx:if="{{paidLanding}}">
        <view class="success-card"><view class="state-title">订单已提交</view><view class="sub">师傅会尽快开始串你的手串，做好后发货。</view><view class="sub">模拟付款，没有扣款</view>
          <view class="success-actions"><button class="c-btn c-btn--sec" bindtap="browse">再逛逛</button><button class="c-btn" bindtap="viewOrder">查看订单</button></view>
        </view>
      </c-card>
      <block wx:else>
        <c-card><view class="state-card"><view class="state-title">{{order.state.label}}</view><view class="sub">{{order.state.desc}}</view></view></c-card>
        <c-card wx:if="{{order.tracking && order.tracking.length}}"><c-cell label="物流" value="{{order.tracking[0].text}}" arrow="{{true}}" data-code="view_logistics" bind:tap="runAction" /></c-card>
        <c-card><view slot="title">收货</view><view class="address">{{order.person}} · {{order.phone}}<view class="sub">{{order.addr}}</view></view></c-card>
        <c-card>
          <view class="product" bindtap="viewProduct"><view class="thumb"><bracelet-thumb beads="{{order.items}}" catalog="{{catalog}}" /></view><view class="product-text"><view class="product-name">{{order.name}}</view><view class="sub product-spec">{{order.beads.length}} 颗 · 手围 {{order.wrist}}cm</view></view></view>
          <view class="qc-photos" wx:if="{{order.qcPhotos.length}}"><view class="qc-photos-title">实拍图</view><scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="qc-photos-scroll"><view class="qc-photos-list"><view class="qc-photo" wx:for="{{order.qcPhotos}}" wx:key="*this" data-index="{{index}}" bindtap="previewQcPhoto"><c-skeleton wx:if="{{!qcPhotoState[index]}}" shape="block" width="100%" ratio="1/1"/><image wx:if="{{qcPhotoState[index] !== 'failed'}}" src="{{item}}" mode="aspectFill" lazy-load="{{true}}" data-index="{{index}}" bindload="qcPhotoLoaded" binderror="qcPhotoFailed"/><text wx:if="{{qcPhotoState[index] === 'failed'}}">图片暂时无法显示</text></view></view></scroll-view></view>
          <c-cell label="材料" value="{{items.length}} 种" arrow="{{true}}" bind:tap="openMaterials" />
          <c-cell label="珠子" value="{{order.goodsPrice}}" />
          <c-cell wx:if="{{order.handworkPrice}}" label="手工费" value="{{order.handworkPrice}}" />
          <c-cell wx:if="{{order.cordPrice}}" label="穿绳" value="{{order.cordPrice}}" />
          <c-cell wx:if="{{order.giftPrice}}" label="礼盒" value="{{order.giftPrice}}" />
          <c-cell label="运费" value="{{order.shippingPrice}}" />
          <c-cell label="{{order.paymentStatus === 'unpaid' ? '应付' : '实付'}}" value="{{order.payable}}" />
        </c-card>
        <c-card><c-cell label="订单号" value="{{order.no}}" arrow="{{true}}" bind:tap="copyNo" /><view wx:if="{{order.createdLabel}}" class="order-time">下单时间 {{order.createdLabel}}</view></c-card>
        <c-card wx:if="{{afterSaleActive || secondaryActions.length}}">
          <c-cell wx:if="{{afterSaleActive}}" label="查看售后" arrow="{{true}}" bind:tap="viewAfterSale" />
          <c-cell wx:for="{{secondaryActions}}" wx:key="code" label="{{item.label}}" arrow="{{true}}" data-code="{{item.code}}" bind:tap="runAction" />
        </c-card>
        <view wx:if="{{error}}" class="error">{{error}}</view>
      </block>
    </block>
  </view>
  <c-bar wx:if="{{order && !paidLanding && primaryAction}}" layout="single"><button class="c-btn" data-code="{{primaryAction.code}}" bindtap="runAction">{{primaryAction.label}}</button></c-bar>
  <c-sheet show="{{sheet === 'payment'}}" title="模拟支付" bind:close="closePayment"><view class="center sub">体验版，不会真的扣款</view><view class="center payment-name">{{order.name}}</view><view class="center payment-amount">{{paymentAmount}}</view><view slot="footer" class="sheet-actions"><button class="c-btn c-btn--sec" data-result="fail" bindtap="finishPayment">支付失败</button><button class="c-btn" data-result="success" bindtap="finishPayment">支付成功</button></view></c-sheet>
  <c-sheet show="{{sheet === 'cancel'}}" title="为什么取消" bind:close="closePayment"><view wx:for="{{cancelReasons}}" wx:key="*this" class="reason" data-reason="{{item}}" bindtap="cancel">{{item}}</view></c-sheet>
  <c-sheet show="{{sheet === 'materials'}}" title="材料" bind:close="closePayment"><view wx:for="{{items}}" wx:key="id" class="material-row"><view class="material-photo"><c-bead bead="{{item}}" size="s" /></view><view class="material-copy"><view>{{item.name}} · {{item.mm}}毫米 · ×{{item.qty}}</view><view class="sub">单价 ¥{{item.unit}}</view></view><text>¥{{item.subtotal}}</text></view></c-sheet>
</c-page>
<c-toast />
