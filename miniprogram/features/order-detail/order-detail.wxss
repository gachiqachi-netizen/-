.detail-surface { min-height: 100vh; background: var(--c-surface); margin: 0 calc(-1 * var(--sp-base)); padding: var(--sp-base); box-sizing: border-box; }
.state-card, .success-card { padding: var(--sp-base) 0; }
.state-title { font-size: var(--fs-title); font-weight: var(--fw-bold); }
.sub { font-size: var(--fs-caption); color: var(--c-text-2); margin-top: var(--sp-tight); }
.address { padding: var(--sp-tight) 0 var(--sp-base); }
.product { display: flex; align-items: center; gap: var(--sp-base); padding: var(--sp-base) 0; }
.thumb { width: 160rpx; height: 160rpx; flex: none; }
.product-text { min-width: 0; flex: 1; text-align: left; }
.product-name { font-weight: var(--fw-bold); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.product-spec { white-space: nowrap; }
.order-time { padding: var(--sp-tight) 0 var(--sp-base); color: var(--c-text-2); font-size: var(--fs-caption); }
.center { text-align: center; }
.payment-name { margin-top: var(--sp-base); }
.payment-amount { font-size: var(--fs-display); font-weight: var(--fw-bold); margin-top: var(--sp-tight); }
.sheet-actions, .success-actions { display: flex; gap: var(--sp-tight); margin-top: var(--sp-base); }
.reason { padding: var(--sp-base) 0; border-bottom: 1rpx solid var(--c-line); }
.error { color: var(--c-danger); margin: var(--sp-base); }
.order-loading { display: flex; flex-direction: column; gap: var(--sp-base); }
