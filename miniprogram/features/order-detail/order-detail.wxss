.page { min-height: 100vh; background: var(--c-bg); padding: 16rpx 16rpx 180rpx; box-sizing: border-box; color: var(--c-text); }
.card { background: var(--c-surface); padding: 32rpx; margin-bottom: 16rpx; }
.state-title { font-size: var(--fs-title); font-weight: var(--fw-bold); }
.section-title, .product-name { font-weight: var(--fw-bold); }
.sub { font-size: var(--fs-caption); color: var(--c-text-2); margin-top: 10rpx; }
.product { display: flex; align-items: center; gap: 20rpx; }
.amount-row { display: flex; justify-content: space-between; padding-top: 24rpx; }
.amount-row:last-child { font-weight: var(--fw-bold); }
.action-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; justify-content: flex-end; gap: 12rpx; padding: 16rpx 24rpx; background: var(--c-surface); }
.action-bar button { margin: 0; }
.center { text-align: center; }
.payment-name { margin-top: 36rpx; }
.payment-amount { font-size: 56rpx; font-weight: var(--fw-bold); margin-top: 8rpx; }
.sheet-actions, .success-actions { display: flex; gap: 16rpx; margin-top: 36rpx; }
.reason { padding: 24rpx 0; border-bottom: 1rpx solid var(--c-line); }
.error { color: var(--c-danger); margin: 16rpx; }
