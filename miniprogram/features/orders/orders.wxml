<view class="orders-page">
  <scroll-view class="tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab {{tab === item.key ? 'on' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="switchTab">
      {{item.label}}<text wx:if="{{counts[item.key]}}" class="tab-n">{{counts[item.key]}}</text>
    </view>
  </scroll-view>

  <!-- 加载中：订单卡片的编号、手串图、文字与操作 -->
  <view class="cards" wx:if="{{loading && !rows.length && !error}}">
    <view class="card order-loading" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <c-skeleton shape="line" width="40%" font="caption"/>
      <view class="order-loading-row"><view class="order-loading-thumb"><c-skeleton shape="block" width="100%" ratio="1/1"/></view><view class="order-loading-copy"><c-skeleton shape="line" width="80%" font="body"/><c-skeleton shape="line" width="50%" font="caption"/></view></view>
      <view class="order-loading-action"><c-skeleton shape="pill" button="small" width="40%"/></view>
    </view>
  </view>

  <!-- 加载失败 -->
  <c-state wx:elif="{{error && !rows.length && !loggedIn}}" title="登录后查看订单" desc="登录后就能看到你的订单" action="去登录" bind:action="goLogin" />
  <c-state wx:elif="{{error && !rows.length}}" title="暂时看不到订单" desc="{{error}}" action="再试一次" bind:action="retry" />

  <!-- 空 -->
  <c-state wx:elif="{{!rows.length}}" title="还没有订单" desc="串好一条，下单后会出现在这里" action="去串一条" bind:action="goDiy" />
  <c-state wx:elif="{{!visible.length}}" title="这里没有订单" desc="试试看看其他状态" />

  <!-- 订单卡片：编号+状态 → 商品行 → 实付 → 按钮靠右 -->
  <view class="cards{{fade ? ' fade-on' : ''}}" wx:else>
    <view class="card order-card" wx:for="{{visible}}" wx:key="no" data-no="{{item.no}}" bindtap="viewDetail">
      <view class="oc-head">
        <text class="oc-no">{{item.no}}</text>
        <text class="oc-status st-{{item.tone}}">{{item.statusLabel}}</text>
      </view>
      <view class="oc-goods">
        <view class="oc-thumb">
          <c-bracelet beads="{{item.visual}}" tier="s" />
        </view>
        <view class="oc-body">
          <view class="oc-name">{{item.name}}</view>
          <view class="oc-meaning" wx:if="{{item.keywords.length}}">{{item.keywords.join(' · ')}}</view>
          <view class="oc-spec">{{item.count}} 颗 · 手围 {{item.wrist}}cm</view>
        </view>
      </view>
      <view class="oc-amount">实付 <text class="oc-price">{{item.payableYuan}}</text></view>
      <view class="oc-actions">
        <button
          wx:if="{{tab === 'after_sale' && item.afterSaleStatus === 'approved'}}"
          class="c-btn c-btn--sec c-btn--s"
          data-no="{{item.no}}"
          catchtap="fillReturn"
        >查看售后</button>
        <button
          wx:if="{{item.action}}"
          class="c-btn c-btn--s{{item.action.secondary ? ' c-btn--sec' : ''}}{{busyNo === item.no ? ' busy' : ''}}"
          data-no="{{item.no}}"
          data-code="{{item.action.code}}"
          catchtap="runAction"
        >{{busyNo === item.no ? '处理中…' : item.action.label}}</button>
      </view>
    </view>
  </view>
</view>

<c-toast />
<c-sheet show="{{confirmNo.length > 0}}" title="确认收货" maskClose="{{false}}"><view>请确认已经收到商品。确认后订单将完成。</view><view slot="footer" class="confirm-actions"><button class="c-btn c-btn--sec" bindtap="closeConfirm">取消</button><button class="c-btn" bindtap="confirmReceipt">确定</button></view></c-sheet>
