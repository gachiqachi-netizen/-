/* C8b 我的订单。版式按 04 第 0.2 节：浅灰底 + 白色卡片 */
page {
  background: var(--c-surface);
}

.orders-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 分栏 */
.tabs {
  position: sticky;
  top: 0;
  z-index: 3;
  white-space: nowrap;
  background: var(--c-surface);
  padding: 20rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.tab {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 28rpx;
  border-radius: var(--r-pill);
  background: var(--c-bg);
  border: 1rpx solid var(--c-line);
  color: var(--c-text-2);
  font-size: 26rpx;
  line-height: 36rpx;
}

.tab.on {
  background: var(--c-text);
  border-color: var(--c-text);
  color: var(--c-bg);
  font-weight: 600;
}

.tab-n {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.75;
}

/* 卡片列表 */
.cards {
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cards.fade-on {
  animation: orders-fade 0.25s ease;
}

@keyframes orders-fade {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: none; }
}

.card {
  background: var(--c-bg);
  border: 1rpx solid var(--c-line);
  border-radius: var(--r-panel);
  padding: 28rpx;
}

.order-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.oc-no {
  font-size: 24rpx;
  color: var(--c-text-2);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-status {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-text);
}

.oc-status.st-attention { color: var(--c-danger); }
.oc-status.st-danger { color: var(--c-danger); }

/* 商品行：缩略图、名字、一句寓意、规格 */
.oc-goods {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.oc-thumb {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: var(--r-panel);
  background: radial-gradient(circle at 50% 42%, var(--c-surface), var(--c-line));
  overflow: hidden;
}

.oc-body {
  flex: 1;
  min-width: 0;
}

.oc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-meaning {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--c-text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-spec {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: var(--c-text-2);
}

.oc-amount {
  text-align: right;
  font-size: 24rpx;
  color: var(--c-text-2);
}

.oc-price {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
  font-variant-numeric: tabular-nums;
}

.oc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

/* 按钮 */
.btn-primary,
.btn-secondary {
  margin: 0;
  border-radius: var(--r-pill);
  font-size: 26rpx;
  line-height: var(--h-btn);
  height: var(--h-btn);
  padding: 0 36rpx;
}

.btn-primary {
  background: var(--c-text);
  border: 0;
  color: var(--c-bg);
}

.btn-primary.busy {
  opacity: 0.5;
}

.btn-secondary {
  background: var(--c-surface);
  border: 1rpx solid var(--c-line);
  color: var(--c-text);
}


.oc-actions button.c-btn { flex: none; }
.oc-actions button.c-btn.busy { opacity: 0.5; }

/* 空 / 错误 */
.empty-card {
  margin: 12rpx 24rpx;
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
}

.empty-sub {
  font-size: 26rpx;
  color: var(--c-text-2);
}

.empty-btn {
  margin-top: 20rpx;
}

.error-card {
  margin: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-color: var(--c-line);
  background: var(--c-surface);
}

.error-text {
  font-size: 26rpx;
  color: var(--c-danger);
  line-height: 40rpx;
}

.error-actions {
  display: flex;
  gap: var(--sp-tight);
}
.error-actions button { flex: 1; }

/* 订单加载占位与真实卡片位置一致 */
.order-loading { display: flex; flex-direction: column; gap: var(--sp-base); }
.order-loading-row { display: flex; align-items: center; gap: var(--sp-base); }
.order-loading-thumb { width: 128rpx; height: 128rpx; flex: none; }
.order-loading-copy { flex: 1; display: flex; flex-direction: column; gap: var(--sp-tight); }
.order-loading-action { display: flex; justify-content: flex-end; }

.confirm-actions { display: flex; width: 100%; gap: var(--sp-tight); }
