/* C8b 我的订单。版式按 04 第 0.2 节：浅灰底 + 白色卡片 */
page {
  background: #f4f4f4;
}

.orders-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 分栏 */
.tabs {
  position: sticky;
  top: 0;
  z-index: 3;
  white-space: nowrap;
  background: #f4f4f4;
  padding: 20rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.tab {
  display: inline-block;
  margin-right: 12rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e4e4e4;
  color: #6e6e6e;
  font-size: 26rpx;
  line-height: 36rpx;
}

.tab.on {
  background: #111;
  border-color: #111;
  color: #fff;
  font-weight: 600;
}

.tab-n {
  font-size: 22rpx;
  margin-left: 6rpx;
  opacity: 0.75;
}

/* 卡片列表 */
.cards {
  padding: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cards.fade-on {
  animation: orders-fade 0.25s ease;
}

@keyframes orders-fade {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: none; }
}

.card {
  background: #fff;
  border: 1rpx solid #e9e8e6;
  border-radius: 24rpx;
  padding: 28rpx;
}

.order-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.oc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.oc-no {
  font-size: 24rpx;
  color: #8a817b;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-status {
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #111;
}

.oc-status.st-attention { color: #c8302e; }
.oc-status.st-danger { color: #b42318; }

/* 商品行：缩略图、名字、一句寓意、规格 */
.oc-goods {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.oc-thumb {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 18rpx;
  background: radial-gradient(circle at 50% 42%, #f5f4f2, #eae7e3);
  overflow: hidden;
}

.oc-body {
  flex: 1;
  min-width: 0;
}

.oc-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1b1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-meaning {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #39745f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oc-spec {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #736b66;
}

.oc-amount {
  text-align: right;
  font-size: 24rpx;
  color: #736b66;
}

.oc-price {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  font-variant-numeric: tabular-nums;
}

.oc-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

/* 按钮 */
.btn-primary,
.btn-secondary {
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 64rpx;
  height: 64rpx;
  padding: 0 36rpx;
}

.btn-primary {
  background: #c8302e;
  border: 0;
  color: #fff;
}

.btn-primary.busy {
  opacity: 0.5;
}

.btn-secondary {
  background: #fff;
  border: 1rpx solid #aaa3a0;
  color: #1f1b1a;
}

.btn-sm {
  line-height: 60rpx;
  height: 60rpx;
  padding: 0 32rpx;
}

/* 空 / 错误 */
.empty-card {
  margin: 12rpx 24rpx;
  text-align: center;
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1b1a;
}

.empty-sub {
  font-size: 26rpx;
  color: #736b66;
}

.empty-btn {
  margin-top: 20rpx;
}

.error-card {
  margin: 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-color: #f0c6c3;
  background: #fff6f5;
}

.error-text {
  font-size: 26rpx;
  color: #b42318;
  line-height: 40rpx;
}

.error-actions {
  display: flex;
  gap: 16rpx;
}

/* 骨架 */
.skeleton-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.sk {
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f2efec 25%, #f8f6f4 50%, #f2efec 75%);
  background-size: 200% 100%;
  animation: sk-sweep 1.2s infinite;
}

@keyframes sk-sweep {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}

.sk-line { height: 28rpx; }
.sk-line.w80 { width: 80%; }
.sk-line.w50 { width: 50%; }
.sk-line.w40 { width: 40%; }
.sk-line.w30 { width: 30%; }
.sk-line.right { align-self: flex-end; }

.sk-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.sk-thumb {
  width: 128rpx;
  height: 128rpx;
  flex: none;
  border-radius: 18rpx;
}

.sk-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
