<view class="page">
  <view class="nav"><text class="back" bindtap="back">‹</text><text>评价</text><text class="back"></text></view>
  <view class="product"><image wx:if="{{image}}" class="thumb" src="{{image}}" mode="aspectFill"/><view wx:else class="thumb"/><view><view class="name">{{name}}</view><view class="hint">{{spec}}</view></view></view>
  <view class="rating"><text>满意度</text><view class="stars"><text wx:for="{{stars}}" wx:key="*this" class="star {{item <= rating ? 'selected' : ''}}" data-rating="{{item}}" bindtap="rate">★</text></view><text class="hint">{{label}}</text></view>
  <view class="input-card"><textarea value="{{content}}" disabled="{{readOnly}}" maxlength="300" placeholder="戴上是什么感觉？说说颜色、大小合不合适" bindinput="input"/><view class="photos"><view wx:for="{{photos}}" wx:key="index" class="photo" data-index="{{index}}" bindtap="retryPhoto"><image wx:if="{{item.status === 'done' && item.url}}" src="{{item.url}}" mode="aspectFill"/><text wx:elif="{{item.status === 'done'}}">已选</text><text wx:elif="{{item.status === 'failed'}}">没传上，点一下重试</text><text wx:else>上传中</text><text wx:if="{{!readOnly}}" class="remove" data-index="{{index}}" catchtap="removePhoto">×</text></view><view wx:if="{{!readOnly && photos.length < 6}}" class="add-photo" bindtap="addPhoto"><text>＋</text><text>加照片</text></view></view></view>
  <view class="photo-hint">最多 6 张照片 · 加张上手照，别人更好挑</view>
  <view class="anonymous"><view><view>匿名评价</view><view class="hint">昵称显示成“小*”</view></view><switch checked="{{anonymous}}" disabled="{{readOnly}}" bindchange="toggleAnonymous"/></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{!readOnly}}" class="bottom"><button class="publish" loading="{{submitting}}" disabled="{{submitting}}" bindtap="publish">发布</button></view>
</view>

<c-toast />
