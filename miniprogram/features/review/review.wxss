.page{min-height:100vh;padding-bottom:160rpx;background:var(--c-bg);color:var(--c-text)}
.nav{display:flex;align-items:center;justify-content:space-between;height:88rpx;padding:0 32rpx;font-size:32rpx;font-weight:600}.back{width:48rpx;font-size:52rpx;font-weight:400}
.product{display:flex;align-items:center;gap:24rpx;padding:28rpx 40rpx;border-bottom:1rpx solid var(--c-line)}.thumb{width:112rpx;height:112rpx;flex:none;background:var(--c-surface)}.name{font-size:30rpx;font-weight:600}.hint,.photo-hint{font-size:24rpx;color:var(--c-text)}
.rating{display:flex;align-items:center;gap:20rpx;padding:32rpx 40rpx;font-size:28rpx}.stars{display:flex;gap:7rpx}.star{font-size:40rpx;color:var(--c-line)}.star.selected{color:var(--c-text)}
.input-card{margin:0 40rpx;padding:28rpx;background:var(--c-surface);min-height:290rpx}.input-card textarea{width:100%;height:150rpx;font-size:28rpx;color:var(--c-text)}.photos{display:flex;flex-wrap:wrap;gap:16rpx}.photo,.add-photo{position:relative;width:120rpx;height:120rpx;display:flex;align-items:center;justify-content:center;text-align:center;font-size:20rpx;color:var(--c-text)}.photo{background:var(--c-bg)}.photo image{width:100%;height:100%}.remove{position:absolute;right:0;top:0;width:36rpx;height:36rpx;line-height:36rpx;border-radius:50%;background:var(--c-text);color:var(--c-bg);font-size:28rpx}.add-photo{border-radius:50%;background:var(--c-bg);flex-direction:column}.add-photo text:first-child{font-size:40rpx}
.photo-hint{padding:16rpx 40rpx}.anonymous{display:flex;justify-content:space-between;align-items:center;padding:28rpx 40rpx;border-bottom:1rpx solid var(--c-line);font-size:28rpx}.hint{margin-top:8rpx}.error{padding:20rpx 40rpx;color:var(--c-text);font-size:24rpx}.bottom{position:fixed;bottom:0;left:0;right:0;padding:20rpx 40rpx;background:var(--c-bg)}.publish{border-radius:999rpx;background:var(--c-text);color:var(--c-bg);font-size:30rpx}
