.product { display: flex; align-items: center; gap: var(--sp-base); padding: var(--sp-base) 0; }
.thumb { width: 144rpx; height: 144rpx; flex: none; }
.product-text { flex: 1; min-width: 0; text-align: left; }
.name { font-size: var(--fs-body); font-weight: var(--fw-bold); }
.hint, .photo-hint { font-size: var(--fs-caption); color: var(--c-text-2); }
.rating { display: flex; align-items: center; gap: var(--sp-tight); padding: var(--sp-base) 0; font-size: var(--fs-body); }
.stars { display: flex; gap: 7rpx; }
.star { font-size: var(--fs-title); color: var(--c-line); }
.star.selected { color: var(--c-text); }
.input-card { padding: var(--sp-base); background: var(--c-surface); min-height: 290rpx; }
.input-card textarea { width: 100%; height: 150rpx; font-size: var(--fs-body); color: var(--c-text); }
.photos { display: flex; flex-wrap: wrap; gap: var(--sp-tight); }
.photo, .add-photo { position: relative; width: 120rpx; height: 120rpx; display: flex; align-items: center; justify-content: center; text-align: center; font-size: var(--fs-caption); color: var(--c-text); }
.photo { background: var(--c-bg); }
.photo image { width: 100%; height: 100%; }
.remove { position: absolute; right: 0; top: 0; width: 36rpx; height: 36rpx; line-height: 36rpx; border-radius: var(--r-pill); background: var(--c-text); color: var(--c-bg); font-size: var(--fs-body); }
.add-photo { border-radius: var(--r-pill); background: var(--c-bg); flex-direction: column; }
.add-photo text:first-child { font-size: var(--fs-title); }
.photo-hint { padding: var(--sp-tight) 0; }
.error { padding: var(--sp-base) 0; color: var(--c-danger); font-size: var(--fs-caption); }
