.page {
  min-height: 100vh;
  background: var(--c-bg);
  box-sizing: border-box;
}

.tabs-top {
  border-bottom: 1rpx solid var(--c-line);
}

.list {
  padding-bottom: 24rpx;
}

/* 单条评价 */
.review {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid var(--c-line);
}
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--c-line);
  flex: none;
}
.review-main {
  flex: 1;
  min-width: 0;
}
.review-meta {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.stars {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  margin-top: 4rpx;
}
.review-text {
  margin-top: 8rpx;
  font-size: var(--fs-body);
}
.photos {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.photo {
  width: 144rpx;
  height: 144rpx;
  background: var(--c-line);
  border-radius: var(--r-panel);
}

.state-wrap {
  padding: 120rpx 0;
}

.sk-wrap {
  padding: 32rpx 40rpx;
}
.sk-line {
  height: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}

.bar-price {
  color: var(--c-text);
}

/* 手围确认弹层 */
.wrist-desc {
  font-size: var(--fs-body);
  color: var(--c-text-2);
  padding: 16rpx 0 32rpx;
}
.wrist-btns {
  display: flex;
  align-items: center;
  gap: var(--sp-tight);
}
.wrist-measure {
  flex: 0 0 240rpx;
}
