.page{min-height:100vh;background:var(--c-bg);color:var(--c-text);font-size:var(--fs-body)}.row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:0 40rpx;border-bottom:1rpx solid var(--c-line)}.row text{color:var(--c-text-2)}.gap{height:20rpx;background:var(--c-surface)}.about{text-align:center;padding:160rpx 40rpx;color:var(--c-text-2);font-size:var(--fs-body)}.about-name{font-size:var(--fs-display);color:var(--c-text);margin-bottom:24rpx}.about-back{margin-top:80rpx;color:var(--c-text)}
