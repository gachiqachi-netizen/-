<view class="shared-page">
  <view class="top" bindtap="home">首页</view>
  <view wx:if="{{loading}}" class="skeleton"><view></view><view></view><view></view></view>
  <view wx:elif="{{deleted}}" class="empty"><view class="empty-title">这条手串看不到了</view><view class="muted">可能已经被主人删除</view><button class="secondary" bindtap="start">我也串一条</button></view>
  <view wx:elif="{{error}}" class="empty"><view class="empty-title">没连上</view><view class="muted">{{error}}</view><button class="secondary" bindtap="home">回首页</button></view>
  <view wx:elif="{{design}}">
    <view class="stage"><bracelet3d beads="{{design.beads}}" catalog="{{catalog}}" selected="{{-1}}"/><view class="stage-mark">珠养养<text>ZHU YANG YANG</text></view></view>
    <view class="intro"><view class="muted">{{authorLabel}}<text wx:if="{{dateLabel}}"> · {{dateLabel}}</text></view><view class="name">{{design.name}}</view><view wx:if="{{meaning}}" class="meaning">{{meaning}}</view><view wx:if="{{tags}}" class="muted">{{tags}}</view></view>
    <view class="section"><view class="heading">每一颗的寓意</view><view wx:for="{{notes}}" wx:key="id" class="note"><view class="note-body"><view class="note-name">{{item.name}}</view><view class="muted">{{item.meaning}}</view></view><view class="muted">×{{item.count}}</view></view></view>
    <view class="brand">珠养养<text>ZHU YANG YANG</text></view>
    <view class="shared-bottom"><button class="secondary" bindtap="start">我也串一条</button><button class="primary" bindtap="use">照这条串一条</button></view>
  </view>
</view>
