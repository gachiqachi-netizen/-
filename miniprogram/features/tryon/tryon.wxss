.tryon-page{min-height:100vh;box-sizing:border-box;background:var(--c-bg);color:var(--c-text);padding-bottom:180rpx}.stage{width:100%;min-height:65vh;background:var(--c-bg);display:flex;align-items:center;justify-content:center;position:relative}.empty-stage{display:flex;flex-direction:column;align-items:center;gap:24rpx;font-size:var(--fs-body);width:70%}.empty-stage button{background:var(--c-text);color:var(--c-bg);border-radius:var(--r-pill);font-size:var(--fs-body)}.photo-stage{display:block;width:100%}.photo-layer{position:relative;width:100%;overflow:hidden}.photo-image,.photo-ring{position:absolute;left:0;top:0;width:100%;height:100%}.compose-canvas{position:fixed;left:-10000px;top:0;pointer-events:none}.align-frame{position:absolute;left:12%;right:12%;top:41%;height:20%;border:2rpx dashed var(--c-text-2);display:flex;align-items:center;justify-content:center;color:var(--c-text-2);font-size:var(--fs-body);pointer-events:none}.stage-mark{position:absolute;right:18rpx;bottom:18rpx}.align-tip{position:absolute;top:60%;font-size:var(--fs-body)}.model-stage{height:65vh;background:var(--c-surface)}.actions,.design-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 40rpx;font-size:var(--fs-body)}.actions{color:var(--c-text-2)}.design-row{border-top:1rpx solid var(--c-line);margin:8rpx 40rpx;padding:22rpx 0}.design-name{font-weight:var(--fw-bold)}.hint{padding:4rpx 40rpx;color:var(--c-text-2);font-size:var(--fs-caption)}.error{padding:20rpx 40rpx;color:var(--c-danger);font-size:var(--fs-caption)}.price{font-size:var(--fs-title);font-weight:var(--fw-bold)}.sheet-row{display:flex;justify-content:space-between;padding:24rpx 8rpx;border-bottom:1rpx solid var(--c-line);font-size:var(--fs-body)}
.empty-stage button{flex:none;min-height:var(--h-btn)}

.hand-stage{width:100%;min-height:65vh;background:var(--c-bg)}.hand-choices{display:flex;justify-content:center;gap:12rpx;padding:22rpx}.hand-choice{padding:10rpx 20rpx;border-radius:var(--r-pill);background:var(--c-surface);color:var(--c-text-2)}.hand-choice.active{background:var(--c-text);color:var(--c-bg)}.hand-hint{text-align:center;color:var(--c-text-2);padding:20rpx}.hand-error{text-align:center;padding:80rpx 30rpx;color:var(--c-danger)}.hand-error button{margin-top:20rpx}
.compute-canvas{position:fixed;left:-10000px;top:0;width:1px;height:1px;pointer-events:none}
.camera-stage{position:absolute;inset:0;width:100%;height:100%;min-height:65vh;overflow:hidden;background:var(--c-text)}
.camera-view{width:100%;height:100%}
.wrist-guide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;color:var(--c-bg);pointer-events:none}
.wrist-outline{width:30%;height:42%;border:3rpx dashed var(--c-bg);border-radius:var(--r-pill);transform:rotate(-45deg);margin-bottom:32rpx}
.guide-pose{font-size:var(--fs-caption);margin-top:8rpx}
.camera-actions{position:absolute;bottom:28rpx;left:0;right:0;display:flex;align-items:center;justify-content:space-around;color:var(--c-bg)}
.camera-shutter{border-radius:var(--r-pill);padding:24rpx 48rpx;background:var(--c-bg);color:var(--c-text)}
.recognition-status{position:absolute;bottom:24rpx;left:0;right:0;text-align:center;color:var(--c-text-2);font-size:var(--fs-caption)}
