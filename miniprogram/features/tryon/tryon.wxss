.tryon-page{min-height:100vh;box-sizing:border-box;background:var(--c-bg);color:var(--c-text);padding-bottom:180rpx}.stage{width:100%;min-height:65vh;background:var(--c-surface);display:flex;align-items:center;justify-content:center;position:relative}.empty-stage{display:flex;flex-direction:column;align-items:center;gap:24rpx;font-size:var(--fs-body)}.empty-stage button{background:var(--c-text);color:var(--c-bg);border-radius:var(--r-pill);font-size:var(--fs-body)}.photo-stage{display:block;max-width:100%}.photo-layer{position:relative;max-width:100%;overflow:hidden}.photo-image,.photo-ring{position:absolute;left:0;top:0;width:100%;height:100%}.compose-canvas{position:fixed;left:-10000px;top:0;pointer-events:none}.align-frame{position:absolute;left:12%;right:12%;top:41%;height:20%;border:2rpx dashed var(--c-text-2);display:flex;align-items:center;justify-content:center;color:var(--c-text-2);font-size:var(--fs-body);pointer-events:none}.stage-mark{position:absolute;right:18rpx;bottom:18rpx}.align-tip{position:absolute;top:60%;font-size:var(--fs-body)}.model-stage{height:65vh;background:var(--c-surface)}.actions,.design-row{display:flex;align-items:center;justify-content:space-between;padding:20rpx 40rpx;font-size:var(--fs-body)}.actions{color:var(--c-text-2)}.design-row{border-top:1rpx solid var(--c-line);margin:8rpx 40rpx;padding:22rpx 0}.design-name{font-weight:var(--fw-bold)}.hint{padding:4rpx 40rpx;color:var(--c-text-2);font-size:var(--fs-caption)}.error{padding:20rpx 40rpx;color:var(--c-danger);font-size:var(--fs-caption)}.price{font-size:var(--fs-title);font-weight:var(--fw-bold)}.sheet-row{display:flex;justify-content:space-between;padding:24rpx 8rpx;border-bottom:1rpx solid var(--c-line);font-size:var(--fs-body)}
