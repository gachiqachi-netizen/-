.works-page { min-height: 100vh; background: var(--c-bg); color: var(--c-text); }
.works-muted { color: var(--c-text-2); }
.works-row { display: flex; align-items: center; border-bottom: 1rpx solid var(--c-line); position: relative; }
.works-open { flex: 1; min-width: 0; }
.works-more { padding: 24rpx 32rpx; font-size: 40rpx; color: var(--c-text-2); }
.works-rename { position: absolute; inset: 0; background: var(--c-bg); display: flex; align-items: center; gap: 24rpx; padding: 0 32rpx; }
.works-rename input { flex: 1; }
.works-state, .works-empty { padding: 64rpx 32rpx; text-align: center; color: var(--c-text-2); font-size: var(--fs-body); }
.works-empty-title { color: var(--c-text); font-size: var(--fs-title); font-weight: var(--fw-bold); margin-bottom: 12rpx; }
.works-link { color: var(--c-text); text-decoration: underline; margin-top: 24rpx; }

.works-share { width: 100%; border: 0; border-radius: 0; background: var(--c-bg); color: var(--c-text); font-size: var(--fs-body); text-align: left; }
.works-share::after { border: 0; }
