/* 临时页布局：只用 tokens 变量 */
.kit {
  padding: var(--sp-base) 0;
}

.h {
  padding: var(--sp-tight) var(--sp-base);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.line {
  display: flex;
  align-items: center;
  gap: var(--sp-tight);
  padding: var(--sp-tight) var(--sp-base);
}

.card {
  border-bottom: 1rpx solid var(--c-line);
}

.card .c-row {
  padding: 0;
}

.card .c-row:last-child {
  border-bottom: 0;
}

.sk {
  height: 160rpx;
  margin: var(--sp-tight) var(--sp-base);
}
