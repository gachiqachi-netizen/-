<view class="kit">
  <view class="h">正常 × 三个尺寸（48 / 80 / 120rpx）</view>
  <view class="row" wx:for="{{beads}}" wx:key="id" wx:for-item="b">
    <bead bead="{{b}}" size="s" />
    <bead bead="{{b}}" size="m" />
    <bead bead="{{b}}" size="l" />
    <text class="n">{{b.name}}</text>
  </view>
  <view class="h">加载中</view>
  <view class="row">
    <bead state="loading" size="s" />
    <bead state="loading" size="m" />
    <bead state="loading" size="l" />
  </view>
  <view class="h">缺货</view>
  <view class="row" wx:if="{{beads.length}}">
    <bead bead="{{beads[0]}}" state="off" size="s" />
    <bead bead="{{beads[0]}}" state="off" size="m" />
    <bead bead="{{beads[0]}}" state="off" size="l" />
  </view>
</view>
