.kit-composer {
  min-height: 100vh;
  background: var(--c-bg);
  display: flex;
  flex-direction: column;
}

.kit-composer__log {
  padding: var(--sp-base);
}

.kit-composer__log-title {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.kit-composer__log-name {
  margin-top: 8rpx;
  font-size: var(--fs-title);
  font-weight: var(--fw-bold);
  line-height: var(--lh-tight);
}

.kit-composer__log-text {
  margin-top: 8rpx;
  font-size: var(--fs-body);
  color: var(--c-text-2);
  word-break: break-all;
}

.kit-composer__demo {
  margin-top: auto;
  padding: var(--sp-base);
  box-shadow: var(--shadow-float);
}
