<view class="kit">
  <view class="h">底部弹层</view>
  <view class="line">
    <button class="c-btn c-btn--s" bindtap="openSheet">打开 sheet</button>
    <button class="c-btn c-btn--s" bindtap="openSheetFixed">maskClose=false</button>
  </view>

  <view class="h">浮动提示（稿 85 五种）</view>
  <view class="col">
    <button class="c-btn c-btn--sec c-btn--s" bindtap="toastSuccess">成功</button>
    <button class="c-btn c-btn--sec c-btn--s" bindtap="toastUndo">带撤销</button>
    <button class="c-btn c-btn--sec c-btn--s" bindtap="toastSimilar">原因 + 出路</button>
    <button class="c-btn c-btn--sec c-btn--s" bindtap="toastRetry">失败 + 再试</button>
    <button class="c-btn c-btn--sec c-btn--s" bindtap="toastSync">状态同步</button>
  </view>

  <view class="h">底部操作栏</view>
  <view class="p">页面底部固定一条 c-bar：左边价格，右边主按钮；原位置有同高占位，内容不被盖。</view>
</view>

<c-sheet show="{{sheetShow}}" title="选一个规格" bind:close="onSheetClose">
  <view class="demo-body">默认插槽：选项列表放这里。内容超过 60% 屏时内部滚动。</view>
  <view slot="footer">
    <button class="c-btn" bindtap="onSheetClose">确定</button>
  </view>
</c-sheet>

<c-sheet show="{{sheetFixedShow}}" title="这个点遮罩不关" mask-close="{{false}}" bind:close="onSheetFixedClose">
  <view class="demo-body">maskClose=false：点遮罩和遮罩外都不关，只能点这里。</view>
  <view slot="footer">
    <button class="c-btn" bindtap="onSheetFixedClose">我知道了</button>
  </view>
</c-sheet>

<c-bar>
  <view slot="left" class="price">合计 ¥78</view>
  <button class="c-btn" bindtap="onBuy">确定</button>
</c-bar>

<c-toast />
