/* 临时页布局：只用 tokens 变量 */
.kit {
  padding: var(--sp-base) 0;
}

.h {
  padding: var(--sp-tight) var(--sp-base);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.line {
  display: flex;
  align-items: center;
  gap: var(--sp-tight);
  padding: var(--sp-tight) var(--sp-base);
}

.col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--sp-tight);
  padding: var(--sp-tight) var(--sp-base);
}

.p {
  padding: var(--sp-tight) var(--sp-base);
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

.demo-body {
  padding: var(--sp-base) 0;
  font-size: var(--fs-body);
  line-height: var(--lh-body);
}

.price {
  font-size: var(--fs-title);
  font-weight: var(--fw-bold);
  line-height: var(--lh-tight);
  white-space: nowrap;
}
