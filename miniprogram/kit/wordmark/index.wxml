<view class="kit">
  <view class="row" wx:for="{{rows}}" wx:key="tone">
    <view class="label">{{item.label}}</view>
    <view class="line{{item.dark ? ' dark' : ''}}">
      <wordmark wx:for="{{sizes}}" wx:for-item="s" wx:key="*this" tone="{{item.tone}}" size="{{s}}" />
    </view>
  </view>
</view>
