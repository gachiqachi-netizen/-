<view class="ai-page">
  <view wx:if="{{messages.length}}" class="ai-chat-tools"><text class="ai-new" bindtap="clear">新对话</text></view>
  <scroll-view class="ai-chat" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="ai-welcome">
      <view class="ai-welcome-title">想要什么感觉，直接说</view>
      <view class="ai-examples"><view wx:for="{{examples}}" wx:key="*this" class="ai-example" data-text="{{item}}" bindtap="example">{{item}}</view></view>
    </view>
    <view wx:for="{{messages}}" wx:key="index" wx:for-item="message" wx:for-index="mi" class="ai-turn">
      <view wx:if="{{message.time}}" class="ai-time">{{message.time}}</view>
      <view wx:if="{{message.role === 'me'}}" class="ai-user-line">
        <text wx:if="{{message.failed}}" class="ai-retry" data-index="{{mi}}" bindtap="retry">重发</text>
        <view class="ai-user" data-index="{{mi}}" bindtap="editMessage" bindlongpress="copyMessage"><image wx:if="{{message.imagePath}}" class="ai-user-image" src="{{message.imagePath}}" mode="aspectFill" data-path="{{message.imagePath}}" catchtap="previewImage" />{{message.text}}</view>
      </view>
      <view wx:else>
        <view wx:if="{{message.seen}}" class="ai-seen">{{message.seen}}</view>
        <view class="ai-answer" data-index="{{mi}}" bindlongpress="copyMessage">{{message.text}}</view>
        <view wx:if="{{message.results.length}}" class="ai-results">
          <view class="ai-result-top" data-message="{{mi}}" bindtap="nextCard">
            <view class="ai-dots"><view wx:for="{{message.results}}" wx:key="index" class="ai-dot {{index === (message.activeIndex || 0) ? 'ai-dot-on' : ''}}" /></view>
            <text>{{(message.activeIndex || 0) + 1}} / {{message.results.length}}　左右滑看另外两条 ›</text>
          </view>
          <scroll-view class="ai-cards" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{message.scrollId}}" data-message="{{mi}}" bindscroll="cardScroll">
            <view class="ai-cards-inner">
              <view wx:for="{{message.results}}" wx:key="index" wx:for-item="result" wx:for-index="ri" id="rec-{{mi}}-{{ri}}" class="ai-card">
                <view class="ai-card-open" data-message="{{mi}}" data-index="{{ri}}" bindtap="openDetail"><view class="ai-art"><c-bracelet beads="{{result.beadObjects}}" tier="m" /></view></view>
                <view class="ai-card-body">
                  <view class="ai-card-heading" data-message="{{mi}}" data-index="{{ri}}" bindtap="openDetail"><text class="ai-card-name">{{result.name}}</text><text class="ai-price" wx:if="{{result.priceText}}">{{result.priceText}}</text></view>
                  <view class="ai-size" wx:if="{{result.count > 0}}">{{result.count}} 颗<text wx:if="{{result.lengthCm}}"> · {{result.lengthCm}}cm</text></view>
                  <view class="ai-meaning" data-message="{{mi}}" data-index="{{ri}}" bindtap="openDetail">{{result.meaning || result.line}}</view>
                  <view class="ai-tags"><text wx:for="{{result.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text></view>
                  <view class="ai-actions"><button class="c-btn c-btn--sec c-btn--s" data-message="{{mi}}" data-index="{{ri}}" bindtap="use">改一改</button><button class="c-btn c-btn--s" data-message="{{mi}}" data-index="{{ri}}" bindtap="order">去下单</button></view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
    <view wx:if="{{busy}}" class="ai-wait"><view class="ai-loading"><c-skeleton shape="block" width="100%" ratio="2/1"/><c-skeleton shape="line" width="80%" font="body"/><c-skeleton shape="line" width="50%" font="caption"/></view></view>
    <view wx:if="{{error}}" class="ai-error">{{error}}</view>
    <view id="chat-end" />
  </scroll-view>
  <view class="ai-composer">
    <scroll-view class="ai-quick" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="ai-quick-inner">
        <view class="c-chip ai-quick-item" bindtap="onTag">手围 {{wrist}}cm</view>
        <view class="c-chip ai-quick-item" wx:for="{{chips}}" wx:key="index" data-text="{{item}}" bindtap="example">{{item}}</view>
      </view>
    </scroll-view>
    <view class="ai-photo-link" bindtap="openPhoto">想做一模一样的？去拍照做同款 ›</view>
    <view class="ai-input-box">
      <view wx:if="{{imagePath}}" class="ai-attachment"><image class="ai-thumb" src="{{imagePath}}" mode="aspectFill" data-path="{{imagePath}}" bindtap="previewImage" /><image class="ai-remove" src="/assets/icons/close.svg" role="button" aria-label="移除图片" bindtap="removeImage" /></view>
      <textarea class="ai-input" value="{{text}}" placeholder="{{hasResults ? '还想怎么改，直接说' : '说说想要的感觉、送谁、预算'}}" auto-height maxlength="500" adjust-position="{{true}}" cursor-spacing="16" bindinput="input" />
      <view class="ai-input-actions"><view class="ai-add" role="button" aria-label="添加图片" bindtap="chooseImage"><image src="/assets/icons/plus.svg" /></view><view class="ai-send {{(!text && !imagePath) || busy ? 'ai-send--off' : ''}}" role="button" aria-label="发送" bindtap="submit"><image src="/assets/icons/up-on.svg" /></view></view>
    </view>
  </view>
  <privacy-popup scene="拍照或选择照片" />
  <c-toast />
</view>
