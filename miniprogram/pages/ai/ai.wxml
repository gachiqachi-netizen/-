<view class="ai-page">
  <view class="ai-nav" style="padding-top:{{navTop}}rpx;height:{{navHeight}}rpx">
    <view wx:if="{{messages.length}}" class="ai-new" bindtap="clear">新对话</view>
    <text>AI 配</text>
  </view>
  <scroll-view class="ai-chat" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="ai-welcome">
      <view class="ai-welcome-title">想要什么感觉，直接说</view>
      <view class="ai-examples"><view wx:for="{{examples}}" wx:key="*this" class="ai-example" data-text="{{item}}" bindtap="example">{{item}}</view></view>
    </view>
    <view wx:for="{{messages}}" wx:key="index" wx:for-item="message" wx:for-index="mi" class="ai-turn">
      <view wx:if="{{message.time}}" class="ai-time">{{message.time}}</view>
      <view wx:if="{{message.role === 'me'}}" class="ai-user-line">
        <text wx:if="{{message.failed}}" class="ai-retry" data-index="{{mi}}" bindtap="retry">重发</text>
        <view class="ai-user" data-index="{{mi}}" bindtap="editMessage" bindlongpress="copyMessage">{{message.text}}</view>
      </view>
      <view wx:else>
        <view class="ai-answer" data-index="{{mi}}" bindlongpress="copyMessage">{{message.text}}</view>
        <view wx:if="{{message.results.length}}" class="ai-results">
          <view class="ai-result-top" data-message="{{mi}}" bindtap="nextCard">
            <view class="ai-dots"><view wx:for="{{message.results}}" wx:key="index" class="ai-dot {{index === (message.activeIndex || 0) ? 'ai-dot-on' : ''}}" /></view>
            <text>{{(message.activeIndex || 0) + 1}} / {{message.results.length}}　左右滑看另外两条 ›</text>
          </view>
          <scroll-view class="ai-cards" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{message.scrollId}}" data-message="{{mi}}" bindscroll="cardScroll">
            <view class="ai-cards-inner">
              <view wx:for="{{message.results}}" wx:key="index" wx:for-item="result" wx:for-index="ri" id="rec-{{mi}}-{{ri}}" class="ai-card">
                <view class="ai-card-open" data-message="{{mi}}" data-index="{{ri}}" bindtap="openDetail"><view class="ai-art"><c-bracelet beads="{{result.beadObjects}}" size="240" /></view></view>
                <view class="ai-card-body">
                  <view class="ai-card-heading"><text class="ai-card-name">{{result.name}}</text><text class="ai-price" wx:if="{{result.price !== ''}}">¥{{result.price}}</text></view>
                  <view class="ai-meaning">{{result.meaning || result.line}}</view>
                  <view class="ai-tags"><text wx:for="{{result.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text></view>
                  <view class="ai-actions"><button class="c-btn c-btn--sec c-btn--s" data-message="{{mi}}" data-index="{{ri}}" bindtap="use">改一改</button><button class="c-btn c-btn--s" data-message="{{mi}}" data-index="{{ri}}" bindtap="order">去下单</button></view>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
    </view>
    <view wx:if="{{busy}}" class="ai-wait"><view>{{waitText}}</view><view class="ai-skeleton"><view class="ai-skeleton-art"/><view class="ai-skeleton-line"/><view class="ai-skeleton-line ai-skeleton-short"/></view></view>
    <view wx:if="{{error}}" class="ai-error">{{error}} <text bindtap="retry" data-index="{{messages.length - 1}}">再试一次</text></view>
    <view id="chat-end" />
  </scroll-view>
  <view class="ai-composer"><c-composer value="{{text}}" placeholder="{{hasResults ? '还想怎么改，直接说' : '说说想要的感觉、送谁、预算…'}}" tag="手围 {{wrist}}cm" chips="{{chips}}" voice="{{false}}" photo="{{false}}" sending="{{busy}}" bind:input="input" bind:send="submit" bind:chip="onChip" bind:tag="onTag" /></view>
  <c-toast />
</view>
