.ai-page { height: 100vh; display: flex; flex-direction: column; background: var(--c-bg); color: var(--c-text); }
.ai-nav { flex: none; position: relative; display: flex; align-items: center; justify-content: center; font-size: var(--fs-title); font-weight: var(--fw-bold); box-sizing: content-box; }
.ai-new { position: absolute; left: var(--sp-base); bottom: 20rpx; font-size: var(--fs-body); font-weight: var(--fw-regular); }
.ai-chat { flex: 1; min-height: 0; box-sizing: border-box; padding: 8rpx var(--sp-base) 24rpx; }
.ai-welcome { padding-top: 104rpx; }
.ai-welcome-title { font-size: var(--fs-display); font-weight: var(--fw-bold); line-height: var(--lh-tight); }
.ai-examples { display: flex; flex-direction: column; gap: var(--sp-tight); margin-top: var(--sp-section); }
.ai-example { width: 100%; box-sizing: border-box; padding: 24rpx 28rpx; border-radius: var(--r-pill); background: var(--c-surface); font-size: var(--fs-body); }
.ai-turn { margin-bottom: 32rpx; }
.ai-time { text-align: center; color: var(--c-text-2); font-size: var(--fs-caption); margin: 8rpx 0 24rpx; }
.ai-user-line { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.ai-user { max-width: 80%; padding: 20rpx 26rpx; border-radius: var(--r-pill); background: var(--c-surface); line-height: var(--lh-body); }
.ai-retry { color: var(--c-text-2); font-size: var(--fs-caption); text-decoration: underline; }
.ai-answer { max-width: 92%; line-height: var(--lh-body); white-space: pre-wrap; margin: 28rpx 0 16rpx; }
.ai-result-top { display: flex; align-items: center; justify-content: space-between; color: var(--c-text-2); font-size: var(--fs-caption); margin: 8rpx 0 16rpx; }
.ai-dots { display: flex; gap: 8rpx; }
.ai-dot { width: 10rpx; height: 10rpx; border-radius: var(--r-pill); background: var(--c-line); }
.ai-dot-on { background: var(--c-text); }
.ai-cards { width: calc(100% + var(--sp-base)); white-space: nowrap; }
.ai-cards-inner { display: inline-flex; gap: 20rpx; padding-right: var(--sp-base); }
.ai-card { width: 580rpx; background: var(--c-bg); border: 1rpx solid var(--c-line); white-space: normal; box-sizing: border-box; }
.ai-art { height: 250rpx; display: flex; align-items: center; justify-content: center; background: var(--c-surface); }
.ai-card-body { padding: 24rpx; }
.ai-card-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.ai-card-name { font-size: var(--fs-title); font-weight: var(--fw-bold); }
.ai-price { font-size: var(--fs-caption); color: var(--c-text-2); }
.ai-meaning { margin-top: 8rpx; font-size: var(--fs-body); }
.ai-tags { display: flex; gap: 12rpx; flex-wrap: wrap; color: var(--c-text-2); font-size: var(--fs-caption); margin-top: 8rpx; }
.ai-actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.ai-actions .c-btn { flex: 1; }
.ai-wait { margin: 24rpx 0; }
.ai-skeleton { margin-top: 20rpx; width: 580rpx; border: 1rpx solid var(--c-line); }
.ai-skeleton-art { height: 250rpx; background: var(--c-surface); }
.ai-skeleton-line { width: 80%; height: 24rpx; background: var(--c-surface); margin: 20rpx; }
.ai-skeleton-short { width: 50%; }
.ai-error { color: var(--c-text-2); margin: 24rpx 0; }
.ai-error text { color: var(--c-text); text-decoration: underline; }
.ai-composer { flex: none; background: var(--c-bg); box-shadow: var(--shadow-float); padding-bottom: env(safe-area-inset-bottom); }
