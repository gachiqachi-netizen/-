.ai-page { height: 100vh; display: flex; flex-direction: column; background: var(--c-bg); color: var(--c-text); }
.ai-chat-tools { display: flex; justify-content: flex-end; padding: var(--sp-tight) var(--sp-base); }
.ai-new { color: var(--c-text-2); font-size: var(--fs-caption); text-decoration: underline; }
.ai-chat { flex: 1; min-height: 0; box-sizing: border-box; padding: 8rpx var(--sp-base) 24rpx; }
.ai-welcome { padding-top: 104rpx; }
.ai-welcome-title { font-size: var(--fs-display); font-weight: var(--fw-bold); line-height: var(--lh-tight); }
.ai-examples { display: flex; flex-direction: column; gap: var(--sp-tight); margin-top: var(--sp-section); }
.ai-example { width: 100%; box-sizing: border-box; padding: 24rpx 28rpx; border-radius: var(--r-pill); background: var(--c-surface); font-size: var(--fs-body); }
.ai-turn { margin-bottom: 32rpx; }
.ai-time { text-align: center; color: var(--c-text-2); font-size: var(--fs-caption); margin: 8rpx 0 24rpx; }
.ai-user-line { display: flex; align-items: center; justify-content: flex-end; gap: 16rpx; }
.ai-user { max-width: 80%; padding: 20rpx 26rpx; border-radius: var(--r-pill); background: var(--c-surface); line-height: var(--lh-body); }
.ai-retry { color: var(--c-text-2); font-size: var(--fs-caption); text-decoration: underline; }
.ai-answer { max-width: 92%; line-height: var(--lh-body); white-space: pre-wrap; margin: 28rpx 0 16rpx; }
.ai-result-top { display: flex; align-items: center; justify-content: space-between; color: var(--c-text-2); font-size: var(--fs-caption); margin: 8rpx 0 16rpx; }
.ai-dots { display: flex; gap: 8rpx; }
.ai-dot { width: 10rpx; height: 10rpx; border-radius: var(--r-pill); background: var(--c-line); }
.ai-dot-on { background: var(--c-text); }
.ai-cards { width: calc(100% + var(--sp-base)); white-space: nowrap; }
.ai-cards-inner { display: inline-flex; gap: 20rpx; padding-right: var(--sp-base); }
.ai-card { width: 580rpx; background: var(--c-bg); border: 1rpx solid var(--c-line); white-space: normal; box-sizing: border-box; }
.ai-art { height: 320rpx; display: flex; align-items: center; justify-content: center; }
.ai-card-body { padding: 24rpx; }
.ai-card-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; }
.ai-card-name { font-size: var(--fs-title); font-weight: var(--fw-bold); }
.ai-price { font-size: var(--fs-caption); color: var(--c-text-2); }
.ai-size { margin-top: 8rpx; color: var(--c-text-2); font-size: var(--fs-caption); }
.ai-meaning { margin-top: 8rpx; font-size: var(--fs-body); }
.ai-tags { display: flex; gap: 12rpx; flex-wrap: wrap; color: var(--c-text-2); font-size: var(--fs-caption); margin-top: 8rpx; }
.ai-actions { display: flex; gap: 12rpx; margin-top: 24rpx; }
.ai-actions .c-btn { flex: 1; }
.ai-wait { margin: 24rpx 0; }
.ai-loading { width: 580rpx; display: flex; flex-direction: column; gap: var(--sp-base); border: 1rpx solid var(--c-line); }
.ai-error { color: var(--c-text-2); margin: 24rpx 0; }
.ai-error text { color: var(--c-text); text-decoration: underline; }
.ai-composer { flex: none; background: var(--c-bg); box-shadow: var(--shadow-float); padding: var(--sp-tight) 0 env(safe-area-inset-bottom); }
.ai-quick { width: 100%; white-space: nowrap; margin-bottom: var(--sp-tight); }
.ai-quick-inner { display: inline-flex; box-sizing: border-box; min-width: 100%; gap: var(--sp-tight); padding: 0 var(--sp-base); }
.ai-quick-item { flex: none; }
.ai-input-row { display: flex; align-items: center; gap: var(--sp-tight); padding: 0 var(--sp-base); }
.ai-input { flex: 1; min-width: 0; height: 80rpx; box-sizing: border-box; padding: 0 28rpx; border-radius: var(--r-pill); background: var(--c-surface); font-size: var(--fs-body); }
.ai-send { width: 80rpx; height: 80rpx; flex: none; display: flex; align-items: center; justify-content: center; border-radius: var(--r-pill); background: var(--c-text); }
.ai-send--off { opacity: .4; }
.ai-send image { width: 40rpx; height: 40rpx; }

.ai-user-image { display: block; width: 120rpx; height: 120rpx; border-radius: var(--r-panel); margin-bottom: 12rpx; }
.ai-seen { color: var(--c-text-2); font-size: var(--fs-caption); margin-top: 24rpx; }
.ai-seen + .ai-answer { margin-top: 8rpx; }
.ai-photo-link { text-align: center; color: var(--c-text-2); font-size: var(--fs-caption); padding: 0 0 14rpx; }
.ai-input-box { margin: 0 var(--sp-base); padding: 16rpx 18rpx; border: 1rpx solid var(--c-line); border-radius: var(--r-pill); background: var(--c-surface); }
.ai-input { display: block; width: 100%; min-height: 64rpx; max-height: 240rpx; padding: 8rpx 10rpx; border: 0; background: transparent; border-radius: var(--r-panel); line-height: var(--lh-body); }
.ai-input-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 4rpx; }
.ai-add { width: 56rpx; height: 56rpx; display: flex; align-items: center; justify-content: center; }
.ai-add image { width: 36rpx; height: 36rpx; }
.ai-send { width: 56rpx; height: 56rpx; }
.ai-send image { width: 32rpx; height: 32rpx; }
.ai-attachment { position: relative; width: 64rpx; height: 64rpx; margin: 0 0 10rpx 8rpx; }
.ai-thumb { width: 64rpx; height: 64rpx; border-radius: var(--r-panel); }
.ai-remove { position: absolute; right: -14rpx; top: -14rpx; width: 28rpx; height: 28rpx; padding: 4rpx; border-radius: var(--r-pill); background: var(--c-bg); }
