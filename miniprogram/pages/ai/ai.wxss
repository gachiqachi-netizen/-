.chat-page{padding:24rpx 32rpx 200rpx;color:#1f1b1a}.chat-tools{display:flex;justify-content:space-between;align-items:center;color:#625c58;font-size:26rpx;margin-bottom:24rpx}.clear{color:#a82522}.welcome{padding:64rpx 8rpx 24rpx}.welcome-title{font-size:40rpx;font-weight:600;line-height:56rpx}.sub{color:#5e5753;font-size:26rpx;line-height:40rpx;margin-top:20rpx}.examples{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.examples button{margin:0;border:1px solid #e6e2dd;background:#fff;border-radius:999px;font-size:28rpx;color:#1f1b1a;padding:0 26rpx;line-height:76rpx}.examples button::after,.refines button::after,.voice::after,.send::after{border:0}.message{margin:24rpx 0;display:flex;flex-direction:column;align-items:flex-start;gap:24rpx}.message.me{align-items:flex-end}.bubble{max-width:85%;padding:24rpx 32rpx;background:#f5f3f1;border-radius:40rpx;border-top-left-radius:12rpx;font-size:30rpx;line-height:44rpx}.me .bubble{background:#1f1b1a;color:#fff;border-radius:40rpx;border-top-right-radius:12rpx}.candidates{width:calc(100% + 64rpx);margin-left:-32rpx;white-space:nowrap}.candidates-inner{display:inline-flex;gap:24rpx;padding:0 32rpx}.candidate{width:440rpx;background:#fff;border:1px solid #ebe8e4;border-radius:24rpx;overflow:hidden;white-space:normal;box-sizing:border-box}.tray{height:296rpx;background:radial-gradient(circle at 50% 42%,#faf9f7,#f3f1ee);display:flex;align-items:center;justify-content:center}.ring{position:relative;width:260rpx;height:260rpx}.bead{position:absolute;width:22rpx;height:22rpx;border-radius:50%;transform:translate(-50%,-50%);box-shadow:1rpx 3rpx 4rpx rgba(0,0,0,.16)}.candidate-body{padding:24rpx;display:flex;flex-direction:column;gap:8rpx}.candidate-title{font-size:30rpx;font-weight:600;line-height:44rpx}.badge,.tag{font-size:22rpx;background:#f5efed;color:#7a4b47;border-radius:6rpx;padding:4rpx 10rpx}.tags{display:flex;gap:8rpx;flex-wrap:wrap}.meaning{font-size:24rpx;line-height:34rpx;color:#5e5753;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:68rpx}.candidate-foot{display:flex;justify-content:space-between;align-items:center;color:#c8302e;font-weight:600}.candidate-foot button{margin:0;background:#fff;border:1px solid #8f8781;border-radius:999px;font-size:24rpx;padding:0 20rpx;line-height:56rpx}.composer{position:fixed;z-index:4;bottom:calc(100rpx + env(safe-area-inset-bottom));left:0;right:0;background:#fff;padding:16rpx 32rpx;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.05)}.refines{white-space:nowrap;margin-bottom:12rpx}.refines-inner{display:inline-flex;gap:8rpx}.refines button{margin:0;background:#fff;border:1px solid #c5bfba;border-radius:999px;font-size:24rpx;padding:0 18rpx;line-height:56rpx}.askbox{display:flex;align-items:center;background:#f7f6f4;border-radius:999px;padding:6rpx;gap:8rpx}.askbox input{flex:1;min-width:0;height:76rpx;font-size:30rpx}.voice,.send{margin:0;width:72rpx;height:72rpx;padding:0;border:0;border-radius:50%;line-height:72rpx;font-size:28rpx}.voice{background:#fff}.send{background:#1f1b1a;color:#fff;font-size:40rpx}.error{color:#b42318;font-size:26rpx;margin:16rpx 0}
/* WeChat buttons have default width and flex sizing; keep the input usable on real phones. */
.askbox .voice,.askbox .send{width:72rpx;min-width:72rpx;max-width:72rpx;flex:0 0 72rpx;box-sizing:border-box}
.askbox input{width:0;flex:1 1 0;min-width:0}
.examples button{width:auto;max-width:100%;flex:0 1 auto;white-space:normal;line-height:1.4;padding:16rpx 26rpx;box-sizing:border-box}
/* Native tab bar is outside the page viewport; do not reserve it twice. */
.composer{bottom:0;box-sizing:border-box}
