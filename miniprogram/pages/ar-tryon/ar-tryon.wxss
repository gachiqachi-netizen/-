.page{padding:24rpx 32rpx;background:#fff}.stage{position:relative;width:100%;overflow:hidden;border-radius:24rpx;background:#151515}.camera,.overlay{position:absolute;inset:0;width:100%;height:100%}.overlay{pointer-events:none}.status{position:absolute;top:16rpx;left:16rpx;padding:10rpx 18rpx;color:#fff;background:rgba(0,0,0,.6);border-radius:12rpx;font-size:24rpx}.hint{font-size:26rpx;color:#625c58;line-height:1.5;margin:24rpx 0}.error{color:#b42318;margin-top:20rpx}
