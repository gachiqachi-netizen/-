<view class="diy">
  <view class="wrist-row"><text>长度按 <text class="strong">{{wrist}}cm</text> 手围计算</text><text class="change" bindtap="wrist">改手围</text></view>
  <view class="resume" wx:if="{{resume}}" bindtap="resume"><view><view class="small muted">上次的设计</view><view class="resume-name">{{resume.name}}</view><view class="small muted">{{resume.beads.length}} 颗 · ¥{{resumePrice}}</view></view><text class="resume-action">继续设计 ›</text></view>
  <view class="section-head"><text class="heading">选个起点</text><text class="small muted">挑好主珠能一键铺满一圈</text></view>
  <view class="starts"><view class="start blank" bindtap="blank"><view class="traybox"><text class="blank-icon">⊕</text></view><view class="body"><view class="nm">从空白开始</view><view class="go">一颗颗挑，挑好主珠一键铺满</view></view></view><view class="start" bindtap="photo"><view class="traybox"><text class="camera-icon">▣</text></view><view class="body"><view class="nm">照着照片串</view><view class="go">拍一张喜欢的手串，认出珠子帮你串好</view></view></view><view class="start" wx:for="{{templates}}" wx:key="id" data-i="{{index}}" bindtap="use"><view class="traybox"><image class="thumb-image" wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"/><bracelet-thumb wx:else style="position:absolute;left:0;top:0;width:100%;height:100%" beads="{{item.beads}}" catalog="{{catalog}}"/></view><view class="body"><view class="nm">{{item.name}}</view><view class="tags"><text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text></view><view class="foot"><text class="price">¥{{item.price}}</text><text class="go">从这款开始 ›</text></view></view></view></view><view class="error" wx:if="{{error}}">{{error}}</view>
</view>
