<view class="workbench">
  <view class="workbench-nav" style="height:{{navHeight}}px;padding-top:{{statusBarHeight}}px;">
    <view wx:if="{{returnSource}}" class="nav-back" style="top:{{menuTop}}px;height:{{menuHeight}}px;" bindtap="back"><image src="/assets/icons/back.svg" /></view>
    <text class="nav-title">自己串</text>
  </view>
  <view class="tray {{trayExpanded ? 'tray-expanded' : ''}}" bindtouchstart="trayTouchStart" bindtouchmove="trayTouchMove" bindtouchend="trayTouchEnd">
    <view class="tray-top"><view class="tray-name" bindtap="openName">{{nameLabel}} ›</view><view class="side-actions"><view class="side-action {{canUndo ? '' : 'is-disabled'}}" bindtap="undo"><image class="tray-symbol" src="/assets/icons/undo.svg" /></view><view class="side-action" bindtap="share"><image class="tray-symbol" src="/assets/icons/share.svg" /></view><view class="side-action" bindtap="toggleMore"><image class="tray-symbol" src="/assets/icons/more.svg" /></view></view></view>
    <view wx:if="{{!items.length}}" class="tray-empty"><view class="empty-ring" style="width:{{emptyRingSize}}rpx;height:{{emptyRingSize}}rpx;"><image class="empty-ring-wordmark" src="/assets/brand/wordmark.svg" /></view></view>
    <view wx:else id="workbench-bracelet" class="bracelet-touch" bindtap="selectTray" bindlongpress="trayLongPress"><view wx:if="{{stackPreview}}" class="stack-extra"><c-bracelet mode="stack" stackBeads="{{stackBeads}}" size="{{330}}" /></view><view class="{{stackPreview ? 'stack-current' : ''}}"><c-bracelet beads="{{items}}" size="{{504}}" circumferenceMm="{{(design.wrist || 16) * 10}}" rotation="{{ringRotation || 0}}" pixelsPerMm="{{scaleRpx}}" selected="{{selected}}" wordmark="{{true}}" /></view><view class="kind-ring" wx:for="{{kindPositions}}" wx:key="index" style="left:{{item.x}}rpx;top:{{item.y}}rpx;width:{{item.box}}rpx;height:{{item.box}}rpx;"></view></view>
    <view class="stack-label" wx:if="{{stackPreview}}" bindtap="closeStackPreview">叠戴预览 · {{stackLabel}}　✕</view>
  </view>
  <view class="bead-flight" wx:if="{{flight}}" style="left:{{flight.x}}px;top:{{flight.y}}px;"><c-bead bead="{{flight.bead}}" size="s" /></view>
  <view class="status"><view class="status-main"><view class="status-summary"><text>{{beadCount}} 颗 · {{lengthMm}}mm · </text><text class="wrist-link" bindtap="openWrist">手围 {{design.wrist}}cm ›</text></view><text class="{{fitState === 'long' ? 'fit-over' : ''}}">{{statusWord}}</text></view><view class="meter {{meterShake ? 'meter-shake' : ''}}"><view class="meter-zone" style="left:{{meterZoneLeft}}%;width:{{meterZoneWidth}}%;"></view><view class="meter-current {{fitState === 'long' ? 'meter-over' : ''}}" style="width:{{meterFill}}%;"></view></view><view class="meter-labels"><text>约 {{scaleLabel}} 倍实物大小</text><text wx:if="{{fitState !== 'ok'}}" class="meter-fit" style="left:{{meterZoneCenter}}%;">合适</text></view></view>
  <view class="feedback-row" wx:if="{{fitState === 'long' && overHint}}"><text>{{overHint}}</text><text bindtap="removeLast">去掉最后一颗</text></view>
  <view class="feedback-row" wx:if="{{selected >= 0 && !selectedKind}}"><text>第 {{selected + 1}} 颗 · {{selectedLabel}}</text><text data-delta="-1" bindtap="move">左移</text><text data-delta="1" bindtap="move">右移</text><text bindtap="replaceSelected">换一颗</text><text bindtap="remove">删除</text></view>
  <view class="feedback-row" wx:if="{{selectedKind}}"><text>已选同种珠子</text><text bindtap="removeKind">全部去掉</text><text bindtap="replaceSelected">换成别的</text></view>
  <view class="picker"><scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="category-rail"><view class="category {{cat === 'picked' ? 'active' : ''}} category-picked" data-id="picked" bindtap="category">已选 <text class="category-count">{{beadCount || ''}}</text></view><view class="category-gap"></view><view class="category {{cat === 'all' ? 'active' : ''}}" data-id="all" bindtap="category">全部</view><view class="category {{cat === item.id ? 'active' : ''}}" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></scroll-view><view class="picker-content"><view class="sizes" wx:if="{{cat !== 'picked'}}"><view class="size {{size === 'all' ? 'active' : ''}}" data-size="all" bindtap="sizeFilter">全部尺寸</view><view class="size {{size == item ? 'active' : ''}}" wx:for="{{sizes}}" wx:key="*this" data-size="{{item}}" bindtap="sizeFilter">{{item}}mm</view></view>
    <c-state wx:if="{{error}}" title="材料暂时没加载出来" desc="{{error}}" action="重试" bindaction="retryCatalog" />
    <view class="bead-loading" wx:elif="{{!catalogReady}}"><view wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this" class="bead-visual"><c-skeleton shape="block" width="100%" ratio="5/4"/></view></view>
    <scroll-view wx:elif="{{cat === 'picked'}}" scroll-y enhanced show-scrollbar="{{false}}" class="picked-scroll"><view class="picked-empty" wx:if="{{!picked.length}}">还没有选珠子</view><view class="picked-item" wx:for="{{picked}}" wx:key="id"><view class="picked-image"><image wx:if="{{item.bead.photoUrl}}" class="picked-photo" src="{{item.bead.photoUrl}}" mode="aspectFit" /><c-bead wx:else class="picked-bead" bead="{{item.bead}}" size="m" fluid="{{true}}" /></view><view class="picked-info"><text>{{item.name}}</text><text class="bead-meta">{{item.bead.mm}}mm · ¥{{item.bead.price}}</text></view><view class="picked-step"><view data-id="{{item.id}}" bindtap="removePickedOne"><image src="/assets/icons/minus.svg" /></view><text>{{item.n}}</text><view data-id="{{item.id}}" bindtap="addPickedOne"><image src="/assets/icons/plus.svg" /></view></view></view></scroll-view>
    <scroll-view wx:else scroll-y enhanced show-scrollbar="{{false}}" class="bead-scroll" scroll-into-view="{{scrollBeadId}}" bindscrolltolower="loadMoreBeads"><view class="bead-grid"><view class="bead-choice {{outOfStockId === item.id ? 'bead-shake' : ''}} {{focusedBeadId === item.id ? 'bead-focused' : ''}}" wx:for="{{displayBeads}}" wx:key="id" id="bead-{{item.id}}" data-id="{{item.id}}" bindtap="add" bindlongpress="inspect"><view class="bead-visual"><image wx:if="{{item.photoUrl}}" class="bead-photo" src="{{item.photoUrl}}" mode="aspectFit" lazy-load="{{true}}" /><c-bead wx:else class="picker-bead" bead="{{item}}" size="m" fluid="{{true}}" /><text class="bead-count" wx:if="{{item.selectedCount}}">{{item.selectedCount}}</text></view><view class="bead-name">{{item.name}}</view><view class="bead-meta">{{item.stock === 'out_of_stock' ? '暂时缺货' : item.mm + 'mm ¥' + item.price}}</view></view></view></scroll-view>
  </view></view>
  <c-bar wx:if="{{beadCount}}" layout="price"><view slot="left">{{handPrice}}</view><button class="c-btn c-btn--block finish" bindtap="finish">串好了</button></c-bar>
  <c-sheet show="{{firstWristOpen}}" title="{{wristConfirmed ? '调整手围' : '先确认手围'}}" maskClose="{{false}}"><view>按 {{design.wrist}}cm 帮你排珠子</view><c-cell label="当前手围" value="{{design.wrist}}cm" /><view slot="footer" class="first-wrist-actions"><button class="c-btn c-btn--sec" bindtap="confirmFirstWrist">就用 {{design.wrist}}cm</button><button class="c-btn" bindtap="measureFirstWrist">量一下</button></view></c-sheet>
  <c-sheet show="{{stackOpen}}" title="和哪几条叠着看" bindclose="closeStack"><view class="stack-help">从你串过的里选，最多两条。只是看效果，不会改这条，也不会一起下单。</view><view class="stack-option" wx:for="{{stackOptions}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseStack"><c-design-row design="{{item}}" catalog="{{catalog}}" sub="{{item.beads.length}} 颗"><view class="stack-check {{item.chosen ? 'is-chosen' : ''}}">{{item.chosen ? '✓' : ''}}</view></c-design-row></view><button slot="footer" class="c-btn stack-submit" bindtap="applyStack">叠上看看</button></c-sheet>
  <c-sheet show="{{moreOpen}}" title="更多" bindclose="toggleMore"><view class="more-option" bindtap="save">保存</view><view class="more-option" bindtap="stack">叠戴</view><view class="more-option" bindtap="works">我的作品 <text class="save-dot" wx:if="{{saveDot}}">●</text> ›</view><view class="more-option" bindtap="reflowWrist">按手围重排</view><view class="more-option" bindtap="openClear">清空手串</view><view class="more-option" bindtap="openCount">按颗数串</view><view class="more-option" bindtap="toggleSound">落珠声　{{soundOn ? '开' : '关'}}</view></c-sheet>
  <c-sheet show="{{countOpen}}" title="按颗数串" bindclose="closeCount"><view class="count-choices"><view wx:for="{{[12,14,18,21]}}" wx:key="*this" data-count="{{item}}" bindtap="count">{{item}} 颗</view></view></c-sheet>
  <c-sheet show="{{nameOpen}}" title="给这条手串起个名字" bindclose="closeName"><view class="name-input-row"><input maxlength="8" value="{{nameDraft}}" placeholder="输入名字" bindinput="nameInput" /><text>{{nameDraft.length}}/8</text></view><view class="name-error" wx:if="{{nameError}}">{{nameError}}</view><view class="name-intro" wx:if="{{nameSuggestions.length}}">按它的寓意，可以叫</view><view class="name-suggestions"><view wx:for="{{nameSuggestions}}" wx:key="*this" data-name="{{item}}" bindtap="chooseName">{{item}}</view></view><button slot="footer" class="c-btn name-submit" bindtap="confirmName">好了</button></c-sheet>
  <c-sheet show="{{safetyOpen}}" title="加之前请了解" bindclose="cancelSafety" maskClose="{{false}}"><view class="safety-head"><c-bead bead="{{safetyBead}}" size="s" /><view><view>{{safetyBead.name}} {{safetyBead.mm}}mm</view><view class="safety-meaning">{{safetyBead.meaning || safetyBead.summary}}</view></view></view><view class="safety-body"><view class="safety-note">{{safetyNote}}</view><view>{{safetyCare}}</view></view><view class="safety-hint">之后再加这颗不再弹出；珠子详情和下单时都能看到这段说明。</view><view slot="footer" class="safety-actions"><button class="c-btn c-btn--sec" bindtap="cancelSafety">不加了</button><button class="c-btn safety-confirm" bindtap="confirmSafety">知道了，继续加</button></view></c-sheet>
  <bead-sheet show="{{detailOpen}}" bead="{{detailBead}}" catalog="{{catalog}}" design="{{design}}" safetyNote="{{detailSafetyNote}}" safetyCare="{{detailSafetyCare}}" bindclose="closeInspect" bindadd="addInspected" bindsimilar="focusSheetSimilar" />
  <c-toast />
  <c-sheet show="{{clearOpen}}" title="清空手串？" bindclose="closeClear"><view>清空后可以撤销恢复。</view><view slot="footer"><button class="c-btn c-btn--sec" bindtap="closeClear">取消</button><button class="c-btn" bindtap="confirmClear">确定</button></view></c-sheet>
</view>
