<view class="workbench">
  <view class="topbar">
    <view class="topbar-back" bindtap="back">‹</view>
    <view class="topbar-title" bindtap="works">我的作品 ›</view>
    <view class="topbar-more" bindtap="toggleMore">···</view>
  </view>
  <view class="tray">
    <view class="tray-name" bindtap="openSettings"><text>{{design.name || '起个名字'}} ›</text><text class="tray-tags" wx:if="{{beadCount >= 6}}">{{tagLine}}</text></view>
    <view class="tray-empty" wx:if="{{!items.length}}">
      <view class="empty-ring"><c-wordmark tone="line" size="s" /></view>
      <view class="empty-hint">从下面挑一颗开始</view>
    </view>
    <c-bracelet wx:else beads="{{items}}" size="{{470}}" selected="{{selected}}" wordmark="{{true}}" />
    <view class="side-actions">
      <view class="side-action {{canUndo ? '' : 'is-disabled'}}" bindtap="undo">↶<text>撤销</text></view>
      <view class="side-action" bindtap="stack">◎<text>叠戴</text></view>
      <view class="side-action" bindtap="share">↗<text>分享</text></view>
      <view class="side-action" bindtap="toggleMore">⋯<text>更多</text></view>
    </view>
  </view>
  <view class="status">
    <view class="status-main"><text>{{beadCount}} 颗 · {{lengthMm}}mm</text><text>{{fit || '还没有珠子'}}</text></view>
    <view class="meter"><view class="meter-zone"></view><view class="meter-dot" style="left: {{meterFill}}%;"></view></view>
  </view>
  <scroll-view scroll-x class="picked-row"><view class="picked-list"><text wx:if="{{!picked.length}}">已选的珠子会排在这里</text><view class="picked-chip" wx:for="{{picked}}" wx:key="id"><c-bead bead="{{item.bead}}" size="s" />{{item.name}} ×{{item.n}}</view></view></scroll-view>
  <view class="picker">
    <view class="picker-head"><text class="picker-title">挑珠子</text><text class="picker-selected" wx:if="{{selected >= 0}}" bindtap="remove">{{selectedLabel}} · 移除</text></view>
    <scroll-view scroll-x class="category-scroll"><view class="categories"><view class="category {{cat === 'all' ? 'active' : ''}}" data-id="all" bindtap="category">全部</view><view class="category {{cat === item.id ? 'active' : ''}}" wx:for="{{cats}}" wx:key="id" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></view></scroll-view>
    <view class="sizes"><view class="size {{size === 'all' ? 'active' : ''}}" data-size="all" bindtap="sizeFilter">全部尺寸</view><view class="size {{size == item ? 'active' : ''}}" wx:for="{{sizes}}" wx:key="*this" data-size="{{item}}" bindtap="sizeFilter">{{item}}mm</view></view>
    <c-state wx:if="{{error}}" title="材料暂时没加载出来" desc="{{error}}" action="重试" bindaction="retryCatalog" />
    <view class="skeleton" wx:elif="{{!catalogReady}}"><view wx:for="{{[1,2,3,4,5,6,7,8]}}" wx:key="*this" class="skeleton-item"></view></view>
    <scroll-view wx:else scroll-y class="bead-scroll"><view class="bead-grid"><view class="bead-choice" wx:for="{{displayBeads}}" wx:key="id" data-id="{{item.id}}" bindtap="add"><view class="bead-visual"><c-bead bead="{{item}}" size="m" /><text class="bead-count" wx:if="{{item.selectedCount}}">{{item.selectedCount}}</text></view><view class="bead-name">{{item.name}}</view><view class="bead-meta">{{item.mm}}mm ¥{{item.price}}</view></view></view></scroll-view>
  </view>
  <view class="bottom" wx:if="{{beadCount}}"><view class="bottom-price"><text>{{handPrice}}</text></view><button class="finish" bindtap="finish">串好了</button></view>
  <view class="more-sheet" wx:if="{{moreOpen}}"><view bindtap="save">保存作品</view><view bindtap="openSettings">设置手围</view><view bindtap="trash">清空手串</view></view>
  <c-toast />
</view>
