.diy{padding:32rpx;display:flex;flex-direction:column;gap:24rpx;color:#1f1b1a}.wrist-row,.section-head,.foot{display:flex;justify-content:space-between;align-items:center;gap:12rpx}.wrist-row{color:#5e5753;font-size:30rpx}.strong{font-weight:600;color:#1f1b1a}.change{font-size:28rpx;color:#5e5753;padding:16rpx 0}.heading{font-size:32rpx;font-weight:600}.small{font-size:26rpx}.muted{color:#736b66}.resume{padding:24rpx 32rpx;border:1rpx solid #e9e8e6;border-radius:24rpx;display:flex;align-items:center;justify-content:space-between}.resume-name{font-size:30rpx;font-weight:600;margin:8rpx 0}.resume-action{color:#c8302e;font-size:26rpx;font-weight:600}.starts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24rpx}.start{border:1rpx solid #e9e8e6;border-radius:24rpx;overflow:hidden;background:#fff}.start.blank{border-color:#c8302e}.traybox{width:100%;height:0;padding-bottom:100%;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 42%,#f8f8f7,#f0efed)}.traybox .thumb-image{position:absolute;inset:0;width:100%;height:100%}.blank-icon,.camera-icon{position:absolute;left:0;top:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:76rpx;color:#a82522}.camera-icon{color:#5e5753}.body{padding:24rpx;display:flex;flex-direction:column;gap:8rpx}.nm{font-size:32rpx;font-weight:600}.blank .nm{color:#a82522}.go{font-size:26rpx;color:#5e5753}.tags{display:flex;gap:8rpx}.tag{font-size:22rpx;color:#5e5753;background:#f4f3f2;border-radius:8rpx;padding:2rpx 8rpx}.price{color:#c8302e;font-size:30rpx;font-weight:600}
