.workbench{min-height:100vh;background:var(--c-bg);color:var(--c-text);display:flex;flex-direction:column}.topbar{height:112rpx;padding-top:env(safe-area-inset-top);display:flex;align-items:center;justify-content:space-between;padding-left:28rpx;padding-right:28rpx}.topbar-back,.topbar-more{font-size:48rpx;width:64rpx;text-align:center}.topbar-title{font-size:var(--fs-body);font-weight:var(--fw-bold)}.tray{height:510rpx;position:relative;display:flex;align-items:center;justify-content:center;background:var(--c-surface)}.tray-empty{display:flex;align-items:center;flex-direction:column;gap:24rpx}.empty-ring{width:360rpx;height:360rpx;border:2rpx dashed var(--c-line);border-radius:50%;display:flex;align-items:center;justify-content:center}.empty-hint{font-size:var(--fs-body);color:var(--c-text-2)}.side-actions{position:absolute;right:24rpx;top:60rpx;display:flex;flex-direction:column;gap:20rpx}.side-action{width:64rpx;text-align:center;font-size:36rpx}.side-action text{display:block;font-size:20rpx;color:var(--c-text-2)}.is-disabled{opacity:.35}.status{padding:22rpx 32rpx;border-bottom:1rpx solid var(--c-line)}.status-main{display:flex;justify-content:space-between;font-size:var(--fs-caption)}.meter{height:8rpx;background:var(--c-line);border-radius:var(--r-pill);margin-top:22rpx;position:relative}.meter-zone{position:absolute;left:43%;width:17%;height:100%;background:var(--c-text-2);border-radius:var(--r-pill)}.meter-dot{position:absolute;top:-8rpx;width:24rpx;height:24rpx;border-radius:50%;background:var(--c-text);transform:translateX(-50%)}.picker{flex:1;min-height:0;padding:22rpx 24rpx 140rpx;display:flex;flex-direction:column}.picker-head{display:flex;justify-content:space-between;align-items:center}.picker-title{font-size:var(--fs-title);font-weight:var(--fw-bold)}.picker-selected{font-size:var(--fs-caption);color:var(--c-text-2)}.category-scroll{white-space:nowrap;margin-top:20rpx;flex-shrink:0}.categories{display:flex;gap:12rpx}.category,.size{padding:10rpx 22rpx;border:1rpx solid var(--c-line);border-radius:var(--r-pill);font-size:var(--fs-caption);white-space:nowrap}.category.active,.size.active{background:var(--c-text);color:var(--c-bg);border-color:var(--c-text)}.sizes{display:flex;gap:12rpx;overflow-x:auto;margin:16rpx 0 20rpx}.bead-scroll{height:430rpx}.bead-grid,.skeleton{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16rpx}.bead-choice{text-align:center;min-width:0}.bead-visual{height:128rpx;position:relative;border-radius:var(--r-panel);background:var(--c-surface);display:flex;align-items:center;justify-content:center}.bead-count{position:absolute;right:4rpx;top:4rpx;font-size:18rpx;color:var(--c-text-2)}.bead-name{font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-top:8rpx}.skeleton-item{height:128rpx;border-radius:50%;background:var(--c-surface)}.bottom{position:fixed;left:0;right:0;bottom:0;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;background:var(--c-bg);border-top:1rpx solid var(--c-line)}.bottom-price{display:flex;flex-direction:column;font-size:var(--fs-body);font-weight:var(--fw-bold)}.bottom-note{font-size:20rpx;font-weight:normal;color:var(--c-text-2)}.finish{margin:0;background:var(--c-text);color:var(--c-bg);min-width:220rpx}.more-sheet{position:fixed;right:24rpx;top:120rpx;background:var(--c-bg);border:1rpx solid var(--c-line);border-radius:var(--r-panel);padding:16rpx;z-index:10}.more-sheet view{padding:14rpx 30rpx}

.tray-name{position:absolute;left:26rpx;top:24rpx;z-index:2;color:var(--c-text-2);font-size:var(--fs-caption);max-width:280rpx}.tray-tags{display:block;margin-top:4rpx;font-size:20rpx}.picked-row{white-space:nowrap;border-bottom:1rpx solid var(--c-line);padding:16rpx 24rpx;color:var(--c-text-2);font-size:var(--fs-caption)}.picked-list{display:flex;align-items:center;gap:12rpx;min-height:64rpx}.picked-chip{display:flex;align-items:center;gap:8rpx;color:var(--c-text);padding:4rpx 12rpx;background:var(--c-surface);border-radius:var(--r-pill)}.bead-meta{font-size:20rpx;color:var(--c-text-2)}
.save-dot{font-size:18rpx;color:var(--c-text)}.fit-over{font-weight:var(--fw-bold)}.feedback-row{min-height:68rpx;display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:0 24rpx;border-bottom:1rpx solid var(--c-line);font-size:var(--fs-caption)}.feedback-row text:not(:first-child){font-weight:var(--fw-bold);white-space:nowrap}.picked-active{background:var(--c-text);color:var(--c-bg)}.bead-focused{outline:2rpx solid var(--c-text)}.bead-shake{animation:bead-shake .35s ease}.meter-shake{animation:bead-shake .35s ease}.bead-flight{position:fixed;z-index:20;transition:left .2s ease-out,top .2s ease-out;pointer-events:none}.safety-head{display:flex;align-items:center;gap:24rpx}.safety-meaning,.safety-hint{font-size:var(--fs-caption);color:var(--c-text-2)}.safety-body{background:var(--c-surface);padding:20rpx;margin:24rpx 0;display:flex;flex-direction:column;gap:12rpx}.safety-note{color:var(--c-danger)}.safety-actions{display:flex;gap:16rpx}.safety-actions button{flex:1}.safety-confirm{background:var(--c-text);color:var(--c-bg)}.detail-body{display:flex;align-items:center;flex-direction:column;gap:16rpx}@keyframes bead-shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-8rpx)}75%{transform:translateX(8rpx)}}
.bracelet-touch{position:relative;width:470rpx;height:470rpx}.kind-ring{position:absolute;border:2rpx solid var(--c-text);border-radius:50%;pointer-events:none}
.tray-expanded{height:75vh;transition:height var(--dur)}.stack-extra{position:absolute;left:70rpx;top:10rpx;pointer-events:none}.stack-current{position:absolute;left:70rpx;top:90rpx}.stack-label{position:absolute;top:16rpx;left:50%;transform:translateX(-50%);z-index:4;padding:8rpx 18rpx;border:1rpx solid var(--c-line);border-radius:var(--r-pill);background:var(--c-bg);font-size:var(--fs-caption);white-space:nowrap}.stack-help{font-size:var(--fs-caption);color:var(--c-text-2);margin:16rpx 0}.stack-option{min-height:120rpx;border-bottom:1rpx solid var(--c-line)}.stack-check{width:42rpx;height:42rpx;border:1rpx solid var(--c-line);border-radius:50%;display:flex;align-items:center;justify-content:center}.stack-check.is-chosen{background:var(--c-text);color:var(--c-bg)}.stack-submit{background:var(--c-text);color:var(--c-bg)}.more-option{min-height:96rpx;display:flex;align-items:center;border-bottom:1rpx solid var(--c-line)}.count-choices{display:flex;flex-wrap:wrap;gap:16rpx;padding:24rpx 0}.count-choices view{padding:16rpx 28rpx;border:1rpx solid var(--c-line);border-radius:var(--r-pill)}
.name-input-row{display:flex;align-items:center;border-bottom:1rpx solid var(--c-line);padding:12rpx 0}.name-input-row input{flex:1;min-height:72rpx;font-size:var(--fs-body)}.name-input-row text{font-size:var(--fs-caption);color:var(--c-text-2)}.name-error{font-size:var(--fs-caption);color:var(--c-danger);margin-top:8rpx}.name-intro{font-size:var(--fs-caption);color:var(--c-text-2);margin:26rpx 0 12rpx}.name-suggestions{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:28rpx}.name-suggestions view{padding:12rpx 20rpx;border:1rpx solid var(--c-line);border-radius:var(--r-pill)}.name-submit{background:var(--c-text);color:var(--c-bg)}
