<view class="studio" wx:if="{{design}}"><view wx:if="{{catalogOffline}}" style="flex-shrink:0;padding:12rpx 24rpx;color:#9b5b18;font-size:24rpx;background:#fff8e8;">正在使用离线示例数据</view>
 <view class="studio-summary"><text bindtap="wristPage">手围 {{design.wrist}}cm ›</text><text>{{design.beads.length}} 颗 · {{length}}cm</text><text bindtap="toggleMore">更多 ···</text></view>
 <view class="preview-area"><bracelet3d id="editor-preview" editable="{{true}}" bind:beaddragstart="dragStart" bind:beaddragmove="dragMove" bind:beaddragend="dragEnd" bind:beaddragcancel="dragCancel" height="344" wx:if="{{!renderFallback}}" beads="{{design.beads}}" catalog="{{catalog}}" selected="{{selected}}" bind:select="select3d" bind:unavailable="renderUnavailable"/><view wx:else class="fallback-ring"><view wx:for="{{items}}" wx:key="sourceIndex" class="bead" data-i="{{item.sourceIndex}}" bindtap="select" style="left:{{item.x}}%;top:{{item.y}}%;background:{{item.c[0]}}"></view></view><view wx:if="{{!items.length}}" class="empty-overlay">点下方材料，开始串珠</view><view class="preview-tools"><view class="tool-hit" role="button" aria-label="音效开关" bindtap="toggleSound"><image class="tool-icon" src="/assets/editor-icons/{{soundOn?'sound':'mute'}}.svg"/></view><view class="tool-hit" role="button" aria-label="翻转手串" bindtap="flip"><image class="tool-icon" src="/assets/editor-icons/flip.svg"/></view><view class="tool-hit" role="button" aria-label="设计设置" bindtap="openSettings"><image class="tool-icon" src="/assets/editor-icons/settings.svg"/></view><view role="button" aria-label="垃圾桶" class="tool-hit trash-target {{dragging?'trash-dragging':''}} {{trashHover?'trash-active':''}}" bindtap="trash"><image class="tool-icon" src="/assets/editor-icons/trash.svg"/><text wx:if="{{dragging}}" class="trash-label">{{trashHover?'松手删除':'拖到这里'}}</text></view></view><view wx:if="{{canUndo}}" class="preview-undo" bindtap="undo">↶ 撤销</view></view>

 <view wx:if="{{dragging}}" class="drag-bead" style="left:{{dragX}}px;top:{{dragY}}px;background:{{dragColor}}"></view>
 <view class="quick-tools" wx:if="{{selected<0}}"><text class="fit-text">{{fit}}</text><button class="fill-btn" wx:if="{{fillCount}}" bindtap="fill">补齐 {{fillCount}} 颗</button></view>
 <view class="quick-tools selected-tools" wx:else><text>第 {{selected+1}} 颗 · 点材料替换</text><button data-delta="-1" bindtap="move">前移</button><button data-delta="1" bindtap="move">后移</button><button bindtap="remove">删除</button><button bindtap="deselect">完成</button></view>
 <view class="material-panel">
  <view class="material-tabs"><view class="{{materialTab==='beads'?'on':''}}" data-tab="beads" bindtap="materialTab">珠子</view><view class="{{materialTab==='accessories'?'on':''}}" data-tab="accessories" bindtap="materialTab">配饰</view><view class="{{materialTab==='cord'?'on':''}}" data-tab="cord" bindtap="materialTab">绳子</view><button bindtap="toggleFilter" wx:if="{{materialTab!=='cord'}}">筛选{{size==='all'?'':' · '+size+'mm'}}</button></view>
  <view class="material-hint" wx:if="{{materialTab!=='cord'}}">点一下添加 · 长按看实拍</view>
  <view class="material-body" wx:if="{{materialTab!=='cord'}}">
   <scroll-view scroll-y class="category-rail"><view class="category {{cat==='all'?'on':''}}" data-id="all" bindtap="category">全部</view><block wx:for="{{cats}}" wx:key="id"><view wx:if="{{materialTab==='beads' && item.id!=='metal'}}" class="category {{cat===item.id?'on':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</view></block></scroll-view>
   <scroll-view scroll-y class="material-scroll"><view class="material-grid"><view wx:for="{{filtered}}" wx:key="id" class="material" data-id="{{item.id}}" bindtap="add" bindlongpress="inspect"><view class="traybox"><image wx:if="{{item.photoUrl}}" class="real" src="{{item.photoUrl}}" mode="aspectFit"/><view wx:else class="dot" style="background:radial-gradient(circle at 30% 25%,{{item.c[0]}},{{item.c[1]}})"></view></view><view class="material-name">{{item.name}}</view><view class="material-spec">{{item.mm}}mm · ¥{{item.price}}</view></view></view><view wx:if="{{!filtered.length}}" class="empty-materials">暂无匹配材料，换个筛选试试</view></scroll-view>
  </view>
  <view class="cord-options" wx:else><button class="{{!design.cord?'chosen':''}}" data-cord="0" bindtap="chooseCord">弹力线<view class="sub">不加价</view></button><button class="{{design.cord===1?'chosen':''}}" data-cord="1" bindtap="chooseCord">编织绳<view class="sub">+¥5，下单时确认</view></button></view>
 </view>
 <view class="studio-footer"><view><view class="price">¥{{price}}</view><view class="tiny">珠子与手工费 · 草稿自动保存</view></view><button class="primary" disabled="{{design.beads.length<6 || !catalogReady || missing}}" bindtap="finish">完成设计</button></view>
 <view class="sheet-mask" wx:if="{{filterOpen}}" bindtap="toggleFilter"><view class="sheet" catchtap="noop"><view class="sheet-head">筛选尺寸<text bindtap="toggleFilter">关闭</text></view><view class="filter-options"><button class="{{size==='all'?'chosen':''}}" data-size="all" bindtap="sizeFilter">全部</button><button wx:for="{{sizes}}" wx:key="*this" class="{{size===item?'chosen':''}}" data-size="{{item}}" bindtap="sizeFilter">{{item}}mm</button></view><button class="primary" bindtap="toggleFilter">查看材料</button></view></view>
 <view class="sheet-mask" wx:if="{{detailBead}}" bindtap="closeInspect"><view class="sheet" catchtap="noop"><view class="sheet-head">{{detailBead.name}} · {{detailBead.mm}}mm<text bindtap="closeInspect">关闭</text></view><image wx:if="{{detailBead.photoUrl}}" class="detail-photo" src="{{detailBead.photoUrl}}" mode="aspectFit"/><view wx:else class="empty-materials">这款材料暂未上传实拍图</view><view>¥{{detailBead.price}} / 颗</view><view class="sub">{{detailBead.meaning}}</view></view></view>
 <view class="sheet-mask" wx:if="{{moreOpen}}" bindtap="toggleMore"><view class="sheet" catchtap="noop"><view class="sheet-head">设计设置<text bindtap="toggleMore">关闭</text></view><input class="nameinput" value="{{design.name}}" maxlength="12" bindinput="rename" placeholder="手串名称"/><view class="sub">{{tags}}</view><view class="filter-options"><button wx:for="{{counts}}" wx:key="*this" data-count="{{item}}" bindtap="count">{{item}} 颗</button></view><button wx:if="{{hasPattern}}" bindtap="refit">按手围重排</button><button bindtap="save">保存并同步云端</button><button disabled="{{design.beads.length<6}}" bindtap="share">分享设计</button><view class="error">{{error}}</view></view></view>
</view>
<view class="sheet-mask" wx:if="{{settingsOpen}}" bindtap="closeSettings"><scroll-view scroll-y class="sheet settings-sheet" catchtap="noop"><view class="sheet-head">个性选择<text bindtap="closeSettings">关闭</text></view><view class="sub">尺寸筛选材料，色系和寓意优先推荐；已有珠子不会自动替换。</view><view>佩戴对象</view><view class="filter-options"><button wx:for="{{prefRecipients}}" wx:key="*this" class="{{prefRecipient===item?'chosen':''}}" data-key="prefRecipient" data-value="{{item}}" bindtap="preference">{{item}}</button></view><view>珠子尺寸</view><view class="filter-options"><button wx:for="{{prefSizes}}" wx:key="*this" class="{{prefSize==item?'chosen':''}}" data-key="prefSize" data-value="{{item}}" bindtap="preference">{{item}}mm</button></view><view>手围</view><view class="filter-options"><button wx:for="{{prefWrists}}" wx:key="*this" class="{{prefWrist==item?'chosen':''}}" data-key="prefWrist" data-value="{{item}}" bindtap="preference">{{item}}cm</button></view><view>色系方向</view><view class="filter-options"><button wx:for="{{prefColors}}" wx:key="*this" class="{{prefColor===item?'chosen':''}}" data-key="prefColor" data-value="{{item}}" bindtap="preference">{{item}}</button></view><view>美好寓意</view><view class="filter-options"><button wx:for="{{prefMeanings}}" wx:key="*this" class="{{prefMeaning===item?'chosen':''}}" data-key="prefMeaning" data-value="{{item}}" bindtap="preference">{{item}}</button></view><button bindtap="resetPreferences">重置</button><button class="primary" bindtap="applyPreferences">确定选择</button></scroll-view></view>
