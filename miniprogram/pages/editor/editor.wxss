.studio{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:#fff;overflow:hidden}.studio-summary{padding:14rpx 24rpx;display:flex;justify-content:space-between;font-size:24rpx;color:#645d59;flex-shrink:0}.preview-area{position:relative;margin:0 20rpx;flex-shrink:0;height:300rpx;overflow:hidden;border-radius:20rpx}.empty-overlay{position:absolute;top:40%;width:100%;text-align:center;pointer-events:none;color:#777}.fallback-ring{height:100%;position:relative}.bead{position:absolute;width:24rpx;height:24rpx;border-radius:50%}.quick-tools{display:flex;align-items:center;gap:10rpx;padding:8rpx 24rpx;min-height:58rpx;box-sizing:border-box;flex-shrink:0;font-size:22rpx}.quick-tools text{flex:1;min-width:0}.quick-tools button{width:auto;margin:0;flex:none;font-size:22rpx;padding:8rpx 14rpx;background:#fff;border:1px solid #e5e1de;border-radius:999rpx}.fit-text{color:#8f632d}.material-panel{display:flex;flex-direction:column;flex:1;min-height:0;background:#faf9f7;border-top:1px solid #eee}.material-tabs{display:flex;align-items:center;padding:0 24rpx;gap:30rpx;flex-shrink:0;height:72rpx}.material-tabs>view{flex:1;text-align:center;font-size:28rpx;padding:16rpx 0;color:#777}.material-tabs .on{color:#222;font-weight:600;border-bottom:4rpx solid #c8302e}.material-tabs button{width:auto;margin:0;padding:8rpx 12rpx;background:transparent;font-size:22rpx;flex:none}.material-hint{text-align:center;color:#8a827d;font-size:20rpx;padding:0 0 8rpx;flex-shrink:0}.material-body{display:flex;flex:1;min-height:0;overflow:hidden}.category-rail{width:100rpx;height:100%;flex:none}.category{padding:22rpx 8rpx;text-align:center;font-size:24rpx;color:#777}.category.on{color:#b82d2b;background:#fbecea;border-left:4rpx solid #c8302e}.material-scroll{height:100%;flex:1;width:0}.material-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;padding:4rpx 16rpx 20rpx 8rpx}.material{background:#fff;border-radius:12rpx;padding:12rpx 6rpx;text-align:center;min-width:0}.traybox{height:90rpx;display:flex;align-items:center;justify-content:center}.real{width:100%;height:100%}.dot{width:62rpx;height:62rpx;border-radius:50%;box-shadow:0 3rpx 5rpx #0002}.material-name{font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.material-spec{font-size:20rpx;color:#777;margin-top:6rpx}.studio-footer{display:flex;align-items:center;justify-content:space-between;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));flex-shrink:0;border-top:1px solid #eee;background:#fff}.price{font-size:32rpx;font-weight:600;color:#c8302e}.tiny{font-size:20rpx;color:#777}.studio-footer button{width:200rpx;margin:0;padding:18rpx 12rpx;font-size:28rpx}.sheet-mask{position:fixed;inset:0;background:#0006;z-index:30;display:flex;align-items:flex-end}.sheet{background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));width:100%;box-sizing:border-box;max-height:78vh;overflow-y:auto}.sheet-head{display:flex;justify-content:space-between;font-size:30rpx;font-weight:600;margin-bottom:26rpx}.sheet-head text{font-size:24rpx;color:#777}.filter-options{display:flex;flex-wrap:wrap;gap:14rpx;margin:24rpx 0}.filter-options button{width:auto;margin:0;font-size:26rpx;padding:14rpx 24rpx}.chosen{color:#b82d2b!important;background:#fbecea!important;border:1px solid #c8302e}.detail-photo{width:100%;height:420rpx}.empty-materials{padding:40rpx 20rpx;color:#777;font-size:26rpx}.nameinput{border-bottom:1px solid #ddd;padding:16rpx 0}.cord-options{display:flex;gap:20rpx;padding:24rpx}.cord-options button{flex:1;width:0;margin:0;padding:30rpx 10rpx;background:#fff}.sheet>button{margin-top:18rpx;width:100%}

.preview-toolbar{display:flex;gap:10rpx;padding:4rpx 20rpx;flex:none}.preview-toolbar button{flex:1;margin:0;padding:0;font-size:23rpx;line-height:64rpx;background:#fff;border:1rpx solid #e5e5e5;border-radius:12rpx}.preview-toolbar .trash-active{background:#c8302e;color:white;border-color:#c8302e}.drag-bead{position:fixed;z-index:100;width:44px;height:44px;border-radius:50%;transform:translate(-50%,-50%);box-shadow:inset -7px -7px 12px #0004,0 6px 15px #0003;pointer-events:none}.settings-sheet{box-sizing:border-box;height:78vh}.settings-sheet .filter-options{margin:12rpx 0 26rpx}

.preview-area{padding:0 88rpx 0 0;box-sizing:border-box;height:344rpx}
.preview-tools{position:absolute;right:0;top:0;width:80rpx;height:344rpx;display:flex;flex-direction:column;align-items:center;justify-content:space-around;z-index:3}
.tool-hit{position:relative;flex:none;width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;box-sizing:border-box;background:#fff}
.tool-icon{display:block;width:36rpx;height:36rpx;flex:none}
.trash-target.trash-dragging{background:#faeae8;border:2rpx dashed #c8302e}
.trash-target.trash-active{background:#f4b8b1;border-style:solid}
.trash-label{position:absolute;right:82rpx;top:16rpx;padding:6rpx 12rpx;white-space:nowrap;background:#faeae8;color:#a52525;border-radius:10rpx;font-size:22rpx}
.preview-undo{position:absolute;left:14rpx;top:12rpx;z-index:3;padding:8rpx 14rpx;border-radius:20rpx;background:#ffffffdd;font-size:23rpx;color:#655d57}
.material-grid{display:flex;flex-wrap:wrap;gap:0;padding:0 8rpx 16rpx;box-sizing:border-box}
.material{flex:none;width:calc(33.333333% - 12rpx);margin:6rpx;padding:12rpx 6rpx;box-sizing:border-box}
.quick-tools button{line-height:1.4;min-height:0}
