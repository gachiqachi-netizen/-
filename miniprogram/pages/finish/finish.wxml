<view class="page" wx:if="{{!loading && !error && !down}}">
  <!-- 图片轮播 -->
  <view class="stage">
    <swiper class="swiper" current="{{current}}" bindchange="onSwiperChange">
      <swiper-item wx:for="{{slides}}" wx:key="index">
        <view class="stage-ring">
          <c-bracelet beads="{{items}}" size="520" wordmark="{{true}}" />
        </view>
      </swiper-item>
    </swiper>
    <view class="tryon-chip" bindtap="tryon">
      <text class="tryon-hand">戴上看看</text>
    </view>
    <view class="gcnt">{{current + 1}}/{{slides.length}}</view>
  </view>

  <!-- 价格卡 -->
  <view class="ocard">
    <view class="price-row">
      <text class="price">{{price}}</text>
      <text class="price-note">{{shippingNote}}</text>
    </view>
    <view class="name">{{design.name}}</view>
    <view class="line" wx:if="{{line}}">{{line}}</view>
    <view class="tags" wx:if="{{tags}}">{{tags}}</view>
  </view>

  <!-- 已选 / 配送 / 服务 -->
  <view class="ocard">
    <view class="rowi" bindtap="openSize">
      <text>已选</text>
      <view class="rv">
        <text wx:if="{{outOfStock}}" class="out">{{outOfStockName}}暂时缺货</text>
        <text wx:else>{{beadsCount}} 颗 · 手围 {{design.wrist}}cm {{fitText}}</text>
        <text class="chevron">›</text>
      </view>
    </view>
    <view class="rowi">
      <text>配送</text>
      <text class="rv">{{shippingRow}}</text>
    </view>
    <view class="rowi">
      <text>服务</text>
      <text class="rv">定制商品 · 质量问题 7 天可退换</text>
    </view>
  </view>

  <!-- 评价：只有热门款有，评价数据要后端（B14），合并前不显示这块 -->
  <!-- <view class="ocard" wx:if="{{showReviews}}"> ... </view> -->

  <!-- 详情：每一颗的寓意 -->
  <view class="ocard">
    <view class="detail-title">详情</view>
    <view class="detail-sub">每一颗的寓意</view>
    <view class="mrow" wx:for="{{counts}}" wx:key="id">
      <c-bead bead="{{item.bead}}" size="m" />
      <view class="mt">
        <view class="mrow-name">{{item.bead.name}}</view>
        <view class="mrow-line" wx:if="{{item.line}}">{{item.line}}</view>
      </view>
      <view class="mrow-count">×{{item.n}}</view>
    </view>
  </view>

  <!-- 底部栏：改一改 / 立即下单（缺货时换一颗再下单） -->
  <c-bar>
    <view class="bar-btns">
      <button class="c-btn c-btn--sec bar-sec" bindtap="edit">改一改</button>
      <button class="c-btn" bindtap="order">{{outOfStock ? '换一颗再下单' : '立即下单'}}</button>
    </view>
  </c-bar>

  <!-- 尺寸和价格弹层 -->
  <c-sheet show="{{showSize}}" title="尺寸和价格" bind:close="closeSize">
    <view class="sheet-row"><text>颗数</text><text class="rv">{{beadsCount}} 颗</text></view>
    <view class="sheet-row"><text>总长</text><text class="rv">{{lengthText}}</text></view>
    <view class="sheet-row" bindtap="goWrist"><text>手围</text><view class="rv"><text>{{design.wrist}}cm，{{fitText}}</text><text class="wrist-edit">改 ›</text></view></view>
    <view class="sheet-row"><text>珠子</text><text class="rv">{{goods}}</text></view>
    <view class="sheet-row last">
      <view class="ship-cell">
        <view>运费</view>
        <view class="ship-sub" wx:if="{{shipSub}}">{{shipSub}}</view>
      </view>
      <text class="rv">{{shipping}}</text>
    </view>
    <view class="sheet-note">页面上的 {{price}} 是到手价，已含运费。示意效果，以实物为准。</view>
  </c-sheet>

  <!-- 手围确认弹层 -->
  <c-sheet show="{{showWrist}}" title="先确认手围" bind:close="closeWrist">
    <view class="wrist-desc">现在按常见的 15cm</view>
    <view class="wrist-btns">
      <button class="c-btn c-btn--sec wrist-measure" bindtap="measureWrist">量一下</button>
      <button class="c-btn" bindtap="confirmWrist">就按 15cm</button>
    </view>
  </c-sheet>

  <c-toast />
</view>

<!-- 加载中：骨架块 -->
<view class="page" wx:if="{{loading}}">
  <view class="stage c-skeleton"></view>
  <view class="ocard">
    <view class="sk-line c-skeleton" style="width:50%"></view>
    <view class="sk-line c-skeleton"></view>
    <view class="sk-line c-skeleton" style="width:70%"></view>
  </view>
  <view class="ocard"><view class="sk-line c-skeleton"></view><view class="sk-line c-skeleton"></view><view class="sk-line c-skeleton"></view></view>
</view>

<!-- 失败 -->
<view class="page" wx:if="{{error && !loading}}">
  <c-state title="加载失败" desc="{{error}}" action="再试一次" bind:action="retry" />
</view>

<!-- 款式已下架 -->
<view class="page" wx:if="{{down}}">
  <c-state title="这条款式下架了" desc="去看看别的款式吧" action="去看看别的" bind:action="goHome" />
</view>
