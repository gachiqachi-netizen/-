.page {
  min-height: 100vh;
  background: var(--c-surface);
  padding-bottom: 24rpx;
  box-sizing: border-box;
}

/* 大图轮播 */
.stage {
  position: relative;
  height: 600rpx;
  background: var(--c-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}
.swiper {
  width: 100%;
  height: 100%;
}
.stage-ring {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tryon-chip {
  position: absolute;
  left: 24rpx;
  bottom: 20rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: var(--r-pill);
  background: var(--c-bg);
  box-shadow: 0 0 0 1rpx var(--c-line);
  font-size: var(--fs-caption);
  display: flex;
  align-items: center;
}
.gcnt {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  font-size: 22rpx;
  background: var(--c-text);
  color: var(--c-bg);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

/* 白卡片 */
.ocard {
  background: var(--c-bg);
  margin: 0 0 16rpx;
  padding: 28rpx 40rpx;
}

/* 价格卡 */
.price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.price {
  font-size: 48rpx;
  font-weight: var(--fw-bold);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}
.price-note {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.name {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: var(--fw-bold);
}
.line {
  margin-top: 4rpx;
  font-size: var(--fs-body);
}
.tags {
  margin-top: 8rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  letter-spacing: 1rpx;
}

/* 已选 / 配送 / 服务 */
.rowi {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  gap: 24rpx;
  font-size: var(--fs-body);
  border-bottom: 1rpx solid var(--c-line);
}
.rowi:last-child {
  border-bottom: 0;
}
.rv {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: var(--c-text-2);
  text-align: right;
}
.out {
  color: var(--c-text);
  font-weight: var(--fw-bold);
}
.chevron {
  color: var(--c-text-2);
}

/* 详情 */
.detail-title {
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
  margin-bottom: 12rpx;
}
.detail-sub {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}
.mrow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0;
}
.mt {
  flex: 1;
  min-width: 0;
}
.mrow-name {
  font-size: var(--fs-body);
  font-weight: var(--fw-bold);
}
.mrow-line {
  margin-top: 4rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.mrow-count {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

/* 底部栏按钮：详情页没有价格，两个按钮铺满整行 */
.c-bar__left {
  display: none;
}
.c-bar__btn {
  flex: 1;
  min-width: 0;
}
.bar-btns {
  display: flex;
  align-items: center;
  gap: var(--sp-tight);
  width: 100%;
}
.bar-sec {
  flex: 0 0 240rpx;
}

/* 尺寸弹层 */
.sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--c-line);
  font-size: var(--fs-body);
}
.sheet-row.last {
  border-bottom: 0;
}
.sheet-row .rv {
  color: var(--c-text);
}
.wrist-edit {
  color: var(--c-text-2);
  margin-left: 8rpx;
}
.ship-cell {
  display: flex;
  flex-direction: column;
}
.ship-sub {
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}
.sheet-note {
  margin-top: 16rpx;
  font-size: var(--fs-caption);
  color: var(--c-text-2);
}

/* 手围确认弹层 */
.wrist-desc {
  font-size: var(--fs-body);
  color: var(--c-text-2);
  padding: 16rpx 0 32rpx;
}
.wrist-btns {
  display: flex;
  align-items: center;
  gap: var(--sp-tight);
}
.wrist-measure {
  flex: 0 0 240rpx;
}

/* 骨架块 */
.sk-line {
  height: 32rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
