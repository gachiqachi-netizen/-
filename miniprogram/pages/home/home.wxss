.home{padding:var(--sp-base);display:flex;flex-direction:column;gap:var(--sp-section);color:var(--c-text)}
.brand{display:flex;justify-content:center;align-items:center;min-height:56rpx}
.banner{height:320rpx}
.slide{box-sizing:border-box;height:296rpx;padding:var(--sp-base);display:flex;align-items:center;background:var(--c-surface);border-radius:var(--r-pill)}
.slide-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:var(--sp-tight);align-items:flex-start}
.slide-title{font-size:var(--fs-display);font-weight:var(--fw-bold);line-height:var(--lh-tight)}
.slide-sub,.slide-go{font-size:var(--fs-caption)}
.slide-sub{color:var(--c-text-2)}
.slide-art{width:240rpx;height:240rpx;flex:none;display:flex;align-items:center;justify-content:center;overflow:hidden}
.thumb-image{width:100%;height:100%}
.quick{display:flex;justify-content:space-between;gap:var(--sp-tight)}
.quick-item{width:25%;display:flex;align-items:center;flex-direction:column;gap:var(--sp-tight);font-size:var(--fs-caption);text-align:center}
.quick-icon{width:88rpx;height:88rpx;border-radius:var(--r-pill);background:var(--c-surface);display:flex;align-items:center;justify-content:center}
.quick-icon image{width:44rpx;height:44rpx}
.section-head{display:flex;align-items:center;flex-wrap:wrap;gap:var(--sp-tight)}
.heading{font-size:var(--fs-title);font-weight:var(--fw-bold)}
.wrist-link{margin-left:auto;font-size:var(--fs-caption);color:var(--c-text-2)}
.offline-note{font-size:var(--fs-caption);color:var(--c-text-2)}
.template-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--sp-tight)}
.tpl{overflow:hidden;background:var(--c-bg);border:1rpx solid var(--c-line);border-radius:var(--r-pill)}
.traybox{width:100%;height:280rpx;background:var(--c-surface);display:flex;align-items:center;justify-content:center;overflow:hidden}
.tpl-body{padding:var(--sp-tight);display:flex;flex-direction:column;gap:8rpx}
.nm{font-size:var(--fs-title);font-weight:var(--fw-bold)}
.meaning{font-size:var(--fs-caption);color:var(--c-text-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.price{font-size:var(--fs-caption);color:var(--c-text-2)}
.error-state,.empty-note{font-size:var(--fs-body);color:var(--c-text-2);text-align:center;padding:var(--sp-base)}
.error-state{display:flex;flex-direction:column;gap:var(--sp-tight);align-items:center}
.retry{color:var(--c-text);border:1rpx solid var(--c-line);border-radius:var(--r-pill);padding:8rpx var(--sp-base)}
.articles{display:flex;flex-direction:column}
.article-row{display:flex;align-items:center;gap:var(--sp-tight);min-height:var(--h-row);border-bottom:1rpx solid var(--c-line)}
.article-image{width:72rpx;height:72rpx;flex:none;background:var(--c-surface)}
.article-copy{display:flex;flex:1;min-width:0;flex-direction:column}
.article-title{font-size:var(--fs-body)}
.article-summary{font-size:var(--fs-caption);color:var(--c-text-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.arrow{color:var(--c-text-2)}
