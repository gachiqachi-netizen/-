.mine-page{min-height:100vh;background:var(--c-bg);color:var(--c-text);font-size:var(--fs-body)}.profile{display:flex;align-items:center;gap:28rpx;padding:24rpx 40rpx 40rpx}.avatar{width:112rpx;height:112rpx;flex:none;padding:0;margin:0;border:0;border-radius:50%;background:var(--c-surface);overflow:hidden}.avatar image{width:100%;height:100%}.profile-text{min-width:0;flex:1}.profile-title,.profile input{font-size:var(--fs-title);font-weight:var(--fw-bold)}.caption{font-size:var(--fs-caption);color:var(--c-text-2);margin-top:8rpx}.gap{height:20rpx;background:var(--c-surface)}.row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:0 40rpx;border-bottom:1rpx solid var(--c-line)}.row .caption{margin:0}.recent{display:flex;align-items:center;gap:28rpx;padding:28rpx 40rpx;border-bottom:1rpx solid var(--c-line)}.recent-thumb{width:112rpx;height:112rpx;background:var(--c-surface);display:flex;align-items:center;justify-content:center}.recent-copy{flex:1}.chevron{color:var(--c-text-2)}
