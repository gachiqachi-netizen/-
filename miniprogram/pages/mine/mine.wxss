.mine-page{min-height:100vh;background:var(--c-bg);color:var(--c-text);font-size:var(--fs-body)}.profile{display:flex;align-items:center;gap:28rpx;padding:24rpx 40rpx 40rpx}.avatar{width:112rpx;height:112rpx;min-width:112rpx;min-height:112rpx;box-sizing:border-box;display:flex;align-items:center;justify-content:center;flex:none;padding:0;margin:0;line-height:1;border:0;border-radius:var(--r-pill);background:var(--c-surface);overflow:hidden}.avatar::after{border:0}.avatar image{width:100%;height:100%}.avatar .avatar-default{width:48rpx;height:48rpx}.profile-text{min-width:0;flex:1}.profile-title,.profile input{font-size:var(--fs-title);font-weight:var(--fw-bold)}.caption{font-size:var(--fs-caption);color:var(--c-text-2);margin-top:8rpx}.gap{height:20rpx;background:var(--c-surface)}.row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:0 40rpx;border-bottom:1rpx solid var(--c-line)}.row .caption{margin:0}

button.c-btn.avatar:not([size=mini]){width:var(--h-btn);height:var(--h-btn);min-width:var(--h-btn);min-height:var(--h-btn);border-radius:var(--r-pill);background:var(--c-surface)}
