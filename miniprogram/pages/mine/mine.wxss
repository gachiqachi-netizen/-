.mine-page{padding:32rpx;color:#1f1b1a}.offline-note{margin:-32rpx -32rpx 24rpx;padding:12rpx 24rpx;color:#9b5b18;font-size:24rpx;background:#fff8e8}.wrist-card{display:flex;align-items:center;justify-content:space-between;padding:32rpx;border:1px solid #e6e2dd;border-radius:24rpx;background:#fff;font-size:28rpx}.wrist-value{color:#a82522}.section-title{font-size:32rpx;font-weight:600;margin:40rpx 0 20rpx}.empty-note{color:#736b66;font-size:26rpx;line-height:40rpx;padding:20rpx 0}.link{color:#a82522}.item{display:flex;align-items:center;gap:24rpx;width:100%;padding:20rpx 0;border-bottom:1px solid #eeeae6}.traybox{width:128rpx;height:128rpx;flex:none;border-radius:18rpx;background:radial-gradient(circle at 50% 42%,#f5f4f2,#eae7e3)}.body{flex:1;min-width:0}.name{font-size:30rpx;font-weight:600}.spec,.note{font-size:24rpx;line-height:36rpx;color:#736b66;margin-top:4rpx}.note{color:#39745f}.chev{font-size:40rpx;color:#a39b96}.cloud-section{margin-top:48rpx}.cloud-heading{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:600}.cloud-heading button{margin:0;background:#fff;border:1px solid #ded8d3}
.order-item{align-items:flex-start}.order-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx}.order-heading .name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.status-badge{flex:none;padding:5rpx 14rpx;border-radius:999rpx;background:#f2efec;color:#655f5a;font-size:21rpx;line-height:30rpx}.status-pending,.status-warning{background:#fff4df;color:#956019}.status-success{background:#e9f5ef;color:#39745f}.status-danger{background:#fff0ef;color:#b42318}.status-muted{background:#f2efec;color:#77706b}.order-note{color:#736b66;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
