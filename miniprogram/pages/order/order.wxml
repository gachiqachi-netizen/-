<c-page>
  <c-state wx:if="{{!design}}" title="没找到要下单的手串" action="去首页看看" bind:action="home" />
  <block wx:else>
    <c-card><view class="address-row {{addressShake ? 'shake' : ''}}" bindtap="manualAddress">
      <view wx:if="{{person}}"><view class="address-name">{{person}}　{{phone}}</view><view class="address-detail">{{addr}}</view></view>
      <view wx:else class="address-label">收货地址</view>
      <view class="address-actions" wx:if="{{!person}}">
        <button class="c-btn c-btn--sec small" catchtap="chooseAddress">用微信地址</button>
        <text class="address-manual" catchtap="manualAddress">手动填写 ›</text>
      </view>
      <text wx:else class="link">修改 ›</text>
    </view></c-card>

    <c-card><view class="summary">
      <view class="bracelet"><c-bracelet beads="{{beads}}" size="144" /></view>
      <view class="summary-text"><view class="name">{{design.name}}</view><view class="meaning">{{design.meaning}}</view><view class="hint">{{design.beads.length}} 颗 · 手围 {{design.wrist}}cm 合适</view></view>
    </view></c-card>
    <c-card><view class="rows">
      <c-cell label="材料" value="{{items.length}} 种" arrow="{{true}}" bind:tap="openMaterials" />
      <c-cell label="穿绳" value="{{cord === 1 ? '编织绳' : '弹力线'}}" arrow="{{true}}" bind:tap="openCord" />
      <c-cell label="送礼" value="礼盒和贺卡" arrow="{{true}}" bind:tap="openGift" />
    </view></c-card>
    <c-card><view class="rows prices">
      <c-cell label="珠子" value="¥{{goods}}" />
      <c-cell wx:if="{{handwork !== '0.00'}}" label="手工费" value="¥{{handwork}}" />
      <c-cell wx:if="{{cord === 1}}" label="穿绳" value="¥{{cordPrice}}" />
      <c-cell wx:if="{{gift}}" label="礼盒" value="¥{{giftPrice}}" />
      <c-cell label="运费" value="{{ship === '0.00' ? '包邮' : '¥' + ship}}"><view slot="label" wx:if="{{shipNote}}" class="hint">{{shipNote}}</view></c-cell>
    </view></c-card>
    <view class="payment-note">提交订单后进入付款，付款前可以再次核对金额。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <c-bar layout="agreement">
      <view slot="top" class="bar-top">
        <view wx:if="{{fit && fit !== '长度基本合适'}}" class="length-note">{{fit}}，确定这样下单？<text class="link" bindtap="edit">回去调整 ›</text></view>
        <view class="agreement {{agreeError ? 'agreement-error' : ''}} {{agreeShake ? 'shake' : ''}}">
          <view class="check {{agreed ? 'checked' : ''}}" bindtap="toggleAgreed">{{agreed ? '✓' : ''}}</view>
          <view class="agreement-text"><text bindtap="toggleAgreed">{{agreeError ? '请先勾选：' : '我已阅读 '}}</text><text class="under" data-type="材料安全说明" bindtap="openRule">材料安全提示</text><text> 和 </text><text class="under" data-type="定制商品说明" bindtap="openRule">定制商品退换说明</text></view>
        </view>
      </view>
      <view slot="left" class="total">¥{{total}}</view>
      <button class="c-btn" loading="{{busy}}" bindtap="submit">{{busy ? '正在提交……' : '提交订单'}}</button>
    </c-bar>
  </block>

  <c-sheet show="{{sheet === 'address'}}" title="收货地址" bind:close="closeSheet">
    <input placeholder="收货人" value="{{person}}" data-key="person" bindinput="input" />
    <input type="number" maxlength="11" placeholder="手机号" value="{{phone}}" data-key="phone" bindinput="input" />
    <input placeholder="详细地址" value="{{addr}}" data-key="addr" bindinput="input" />
    <button slot="footer" class="c-btn" bindtap="closeSheet">好了</button>
  </c-sheet>
  <c-sheet show="{{sheet === 'materials'}}" title="材料" bind:close="closeSheet">
    <view wx:for="{{items}}" wx:key="id" class="sheet-row"><view class="material-photo"><c-bead bead="{{item}}" size="s" /></view><view><view>{{item.name}} · {{item.mm}}毫米 · ×{{item.qty}}</view><view class="hint">单价 ¥{{item.unit}}</view><view class="hint">{{item.explanation}}</view><view wx:if="{{item.safety}}" class="hint">{{item.safety}}</view></view><text>¥{{item.subtotal}}</text></view>
  </c-sheet>
  <c-sheet show="{{sheet === 'safety'}}" title="材料安全提示" bind:close="closeSheet">
    <view class="safety-copy">{{safety}}</view>
  </c-sheet>
  <c-sheet show="{{sheet === 'cord'}}" title="穿绳" bind:close="closeSheet">
    <view class="sheet-row" data-cord="0" bindtap="setCord">弹力线 <text>{{cord === 0 ? '✓' : ''}}</text></view>
    <view class="sheet-row" data-cord="1" bindtap="setCord">编织绳 +¥{{pricing.cordFen / 100}} <text>{{cord === 1 ? '✓' : ''}}</text></view>
  </c-sheet>
  <c-sheet show="{{sheet === 'gift'}}" title="送礼" bind:close="closeSheet">
    <c-cell label="礼盒" value="+¥{{pricing.giftFen / 100}}" switch="{{true}}" checked="{{gift}}" bind:change="setGift" />
    <view class="sheet-label">贺卡留言（选填，最多 50 字）</view>
    <textarea maxlength="50" placeholder="写一句想说的话" value="{{giftNote}}" data-key="giftNote" bindinput="input" />
    <view class="counter">{{giftNote.length}}/50</view>
    <c-cell label="隐藏价格：包裹里不放带价格的单据" switch="{{true}}" checked="{{hidePrice}}" bind:change="toggleHidePrice" />
    <view slot="footer" class="gift-footer"><button class="c-btn" bindtap="finishGift">好了</button></view>
  </c-sheet>
  <c-sheet show="{{sheet === 'price'}}" title="价格有变化" maskClose="{{false}}">
    <view>你挑的时候到现在，有材料调了价。</view>
    <view wx:for="{{quoteChanges}}" wx:key="*this" class="sheet-row">{{item}}</view>
    <view slot="footer" class="sheet-actions"><button class="c-btn c-btn--sec" bindtap="declinePrice">先不下单</button><button class="c-btn" bindtap="acceptPrice">按新价格提交</button></view>
  </c-sheet>
  <c-sheet show="{{sheet === 'payment'}}" title="模拟支付" bind:close="paymentClose">
    <view class="payment-copy">体验版，不会真的扣款</view>
    <view class="payment-name">{{design.name}}</view>
    <view class="payment-amount">¥{{paymentAmount}}</view>
    <view slot="footer" class="sheet-actions"><button class="c-btn c-btn--sec" data-result="fail" bindtap="finishPayment">支付失败</button><button class="c-btn" data-result="success" bindtap="finishPayment">支付成功</button></view>
  </c-sheet>
</c-page>

<c-toast />
