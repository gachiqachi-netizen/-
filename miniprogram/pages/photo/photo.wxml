<view class="photo-page">
  <block wx:if="{{!photo && !permissionDenied}}">
    <view class="camera-stage"><camera class="camera-preview" device-position="back" flash="auto" binderror="cameraError"/><view class="camera-frame"></view></view>
    <view class="hint">把整条手串放进圈里，光线亮一点，认得更准</view>
    <view class="camera-actions"><text bindtap="choose" data-source="album">相册</text><button class="shutter" bindtap="shoot" aria-label="拍照"></button><text></text></view>
  </block>
  <block wx:elif="{{permissionDenied}}">
    <view class="empty-title">用不了相机</view><view class="hint">没有相机权限。可以去设置里打开，或者直接从相册选一张</view>
    <button class="c-btn primary" bindtap="choose" data-source="album">从相册选</button><view class="text-action" bindtap="openSettings">去设置打开相机 ›</view>
  </block>
  <block wx:elif="{{busy}}"><view class="processing"><image src="{{photo}}" mode="aspectFill"/><view>正在一颗一颗地认……</view></view><view class="bottom"><button class="c-btn c-btn--sec" disabled>正在识别……</button><text>识别完成后可以核对珠子</text></view></block>
  <block wx:elif="{{usageOpen}}"><image class="picked-photo" src="{{photo}}" mode="aspectFill"/><view class="shade"></view><view class="usage-sheet"><view class="sheet-title">想怎么用这张照片</view><button class="c-btn c-btn--block" bindtap="useExact">照着做一条一样的</button><view class="hint">尽量还原照片里的每一颗珠子</view><button class="c-btn c-btn--sec c-btn--block" bindtap="useFeeling">照着这个感觉配一条</button><view class="hint">按颜色和气质配一条新的</view></view></block>
  <block wx:elif="{{error && !result}}"><image class="picked-photo" src="{{photo}}" mode="aspectFill"/><view class="empty-title">{{retryable ? '识别暂时没完成' : '这张没认出来'}}</view><view class="hint">{{error}}</view><button wx:if="{{retryable}}" class="c-btn primary" bindtap="recognize">再试一次</button><button wx:else class="c-btn primary" bindtap="retake">重拍一张</button><view class="text-action" bindtap="useFeeling">不重拍，照这个感觉配一条 ›</view></block>
  <block wx:elif="{{result}}">
    <view class="compare"><view><image src="{{photo}}" mode="aspectFill"/><text>你的照片</text></view><view><view class="recreated"><bracelet-thumb beads="{{previewIds}}" catalog="{{catalog}}"/></view><text>我们复原的</text></view></view>
    <view class="result-content"><view wx:if="{{result.source === 'local'}}" class="local-notice">没连上识别服务，下面是按照片颜色估的，材料可能不对，请核对或放到工作台改</view><view class="name-row"><input value="{{name}}" bindinput="rename"/><text>改名</text></view><view wx:if="{{result.source !== 'local'}}" class="meaning">{{result.seen}}</view><view class="hint">{{beadCount}} 颗 · {{length}}mm · 手围 {{wrist}}cm 合适</view><view class="section-title">{{result.source === 'local' ? '按颜色估的珠子' : '认出来的珠子'}}</view>
    <block wx:if="{{matchedKinds.length}}"><view class="matched-row" wx:for="{{matchedKinds}}" wx:key="key" wx:for-item="kind">
      <view class="matched-heading"><text>{{kind.title}} · {{kind.colorName}}</text><text wx:if="{{kind.mmGuess}}">约 {{kind.mmGuess}}mm</text></view>
      <view wx:if="{{!kind.options.length}}" class="text-action" data-role="{{kind.role}}" bindtap="pickMissing">没找到像的，点这里自己挑 ›</view>
      <scroll-view wx:else scroll-x enhanced show-scrollbar="{{false}}" class="candidate-scroll"><view class="candidate-list"><view wx:for="{{kind.options}}" wx:key="id" wx:for-item="candidate" class="candidate {{chosenKinds[kind.role] === candidate.id ? 'selected' : ''}}" data-role="{{kind.role}}" data-id="{{candidate.id}}" bindtap="chooseCandidate"><image wx:if="{{candidate.photoUrl}}" src="{{candidate.photoUrl}}" mode="aspectFit"/><view wx:else class="candidate-color" style="background:{{candidate.c[0] || '#ccc'}}"></view><text>{{candidate.name}}</text><text>{{candidate.mm}}mm</text></view></view></scroll-view>
    </view></block>
    <block wx:else><view class="bead-row" wx:for="{{roles}}" wx:key="key" wx:for-item="role"><view class="bead-info"><text>{{role.name}}</text><text class="hint">{{role.meaning}}</text><view wx:if="{{role.lowConfidence}}" class="hint">可能不准 <button class="c-btn small" data-role="{{role.key}}" bindtap="showAlternatives">换一颗</button></view></view><text>×{{role.count}}</text></view>
    <view wx:if="{{picking}}" class="alternatives"><view class="section-title">换一颗</view><view wx:for="{{alternativeOptions}}" wx:key="id" class="alternative" data-role="{{picking}}" data-id="{{item.id}}" bindtap="chooseRole">{{item.name}} · {{item.mm}}mm</view></view></block>
    <view class="text-action" bindtap="retake">不太像？重拍一张 ›</view><view class="text-action" bindtap="edit">放到工作台改 ›</view></view>
    <c-bar layout="price"><view slot="left">¥{{price}}</view><button wx:if="{{matchedKinds.length}}" class="c-btn c-btn--block" bindtap="edit">按 15cm 排一条</button><button wx:else class="c-btn c-btn--block" bindtap="order">就要这条</button></c-bar>
  </block>
</view>
<privacy-popup scene="拍照或选择手串照片" bind:reject="privacyRejected"/>

<c-toast />
