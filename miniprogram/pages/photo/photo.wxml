<view class="same-page"><view wx:if="{{catalogOffline}}" style="flex-shrink:0;padding:12rpx 24rpx;color:#9b5b18;font-size:24rpx;background:#fff8e8;">正在使用离线示例数据</view>
  <block wx:if="{{!photo && !busy}}"><view class="same-drop" bindtap="choose"><view class="camera">◎</view><view class="drop-title">拍一张喜欢的手串</view><view class="sub">朋友戴的、店里看到的、网上存的图都行</view></view>
    <view class="same-card"><view class="strong">怎么做同款</view><view class="step"><view class="number">1</view><view>认出照片里的珠子<view class="sub">主珠、配珠、金属点缀，从我们的料包里找最像的</view></view></view><view class="step"><view class="number">2</view><view>你看一眼，不对就换<view class="sub">每种珠子都给几颗相近的备选</view></view></view><view class="step"><view class="number">3</view><view>按你的 {{wrist}}cm 手围串好<view class="sub">放到托盘上，还能接着改</view></view></view></view><view class="tips">手串占画面一半以上、背景干净，认得更准。颜色以实物为准。选择照片后会发送至识别服务。</view>
    <view class="bottom"><button class="primary full" bindtap="choose">拍照或从相册选</button></view></block>
  <view wx:if="{{busy}}" class="waiting"><image src="{{photo}}" mode="aspectFill"/><view>正在认珠子…</view></view>
  <block wx:if="{{photo && !busy && !result}}"><view class="waiting"><image src="{{photo}}" mode="aspectFill"/><view>{{error || '没看清照片里的手串，换一张试试？'}}</view></view><view class="bottom"><button class="primary full" bindtap="choose">换一张</button></view></block>
  <block wx:if="{{result && !busy}}"><view class="same-top"><image src="{{photo}}" mode="aspectFill"/><view><view class="by">{{result.source==='local'?'按照片颜色估算':'AI 认出来的'}}</view><view>{{result.seen}}</view><text class="change-photo" bindtap="choose">换一张照片</text></view></view><view class="ring-tray"><bracelet-thumb beads="{{previewIds}}" catalog="{{catalog}}"/></view><view class="section"><text class="strong">认出来的珠子</text><text class="sub">不对就点别的</text></view><view class="same-card"><view class="role" wx:for="{{roles}}" wx:key="key" wx:for-item="role"><view class="role-title">{{role.title}} <text class="sub">{{role.hint}}</text></view><scroll-view scroll-x class="options"><view class="options-inner"><view wx:if="{{role.none}}" class="option {{role.noneActive?'active':''}}" data-role="{{role.key}}" data-id="" bindtap="chooseRole">不加</view><view wx:for="{{role.options}}" wx:key="id" wx:for-item="bead" class="option {{bead.active?'active':''}}" data-role="{{role.key}}" data-id="{{bead.id}}" bindtap="chooseRole"><view class="opt-bead" style="background:radial-gradient(circle at 30% 25%,{{bead.color}},{{bead.dark}})"></view><view>{{bead.name}}</view><view class="muted">{{bead.mm}}mm ¥{{bead.price}}</view></view></view></scroll-view></view><view wx:if="{{selectedAccent || selectedMetal}}" class="role"><view class="role-title">{{selectedAccent?'配珠':'点缀'}}多久出现一次</view><view class="intervals"><button wx:for="{{intervals}}" wx:key="*this" class="interval {{every===item?'active':''}}" data-value="{{item}}" bindtap="interval">每 {{item}} 颗</button></view></view></view><view class="tips">颜色以实物为准。料包里没有一模一样的珠子时，按最接近的配。</view><view class="bottom"><view class="sum"><view class="price">¥{{price}}</view><view class="sub">{{beadCount}} 颗 · {{length}}mm · 按 {{wrist}}cm 手围</view></view><button class="primary" bindtap="edit">放到托盘上改</button></view></block>
</view>
