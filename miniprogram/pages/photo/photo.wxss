.photo-page{min-height:100vh;background:var(--c-bg);color:var(--c-text);font-size:var(--fs-body);padding-bottom:160rpx;box-sizing:border-box}.camera-stage{height:68vh;background:var(--c-surface);display:flex;align-items:center;justify-content:center;position:relative;color:var(--c-text-2)}.camera-frame{width:480rpx;height:480rpx;border:2rpx dashed var(--c-text-2);border-radius:50%;position:absolute}.camera-stage text{align-self:flex-start;margin-top:28rpx}.hint{font-size:var(--fs-caption);color:var(--c-text-2);line-height:var(--lh-body)}.photo-page>.hint{text-align:center;margin:24rpx var(--sp-base)}.camera-actions{position:fixed;bottom:env(safe-area-inset-bottom);left:0;right:0;display:flex;align-items:center;justify-content:space-between;padding:24rpx var(--sp-base);background:var(--c-bg)}.camera-actions text{width:120rpx}.shutter{width:112rpx;height:112rpx;border-radius:50%;border:8rpx solid var(--c-text);background:var(--c-bg);padding:0}.picked-photo{width:100%;height:56vh}.shade{position:fixed;inset:0;background:var(--c-mask)}.usage-sheet{position:fixed;bottom:0;left:0;right:0;background:var(--c-bg);padding:var(--sp-base);box-shadow:var(--shadow-float);z-index:3}.sheet-title,.empty-title,.section-title{font-size:var(--fs-title);font-weight:var(--fw-bold);margin:var(--sp-base) 0}.usage-sheet button{margin:24rpx 0 8rpx}.usage-sheet .hint{margin-bottom:24rpx}.primary{background:var(--c-text);color:var(--c-bg);border-radius:var(--r-pill)}button{border-radius:var(--r-pill);font-size:var(--fs-body)}.processing{padding:var(--sp-base);text-align:center}.processing image{width:100%;height:48vh;margin-bottom:var(--sp-base)}.bottom{position:fixed;bottom:0;left:0;right:0;background:var(--c-bg);box-shadow:var(--shadow-float);padding:20rpx var(--sp-base) calc(20rpx + env(safe-area-inset-bottom));display:flex;align-items:center;gap:12rpx}.bottom button{margin:0}.bottom text{font-size:var(--fs-caption)}.compare{display:flex;gap:8rpx;margin:var(--sp-base)}.compare>view{flex:1;min-width:0;text-align:center}.compare image,.recreated{width:100%;height:400rpx;background:var(--c-surface)}.recreated{display:flex;align-items:center;justify-content:center}.compare text{display:block;margin-top:12rpx}.result-content{padding:0 var(--sp-base)}.name-row{display:flex;align-items:center;gap:12rpx}.name-row input{font-size:var(--fs-title);font-weight:var(--fw-bold);flex:1}.name-row text{font-size:var(--fs-caption)}.meaning{margin:16rpx 0}.bead-row{display:flex;align-items:center;justify-content:space-between;min-height:var(--h-row);border-bottom:1rpx solid var(--c-line)}.bead-info{display:flex;flex-direction:column}.small{display:inline-block;font-size:var(--fs-caption);background:var(--c-surface);height:var(--h-btn-s);line-height:var(--h-btn-s);margin-left:12rpx}.text-action{text-align:center;margin:var(--sp-base);color:var(--c-text-2)}.price{font-size:var(--fs-title);font-weight:var(--fw-bold)}.result-bottom button{font-size:var(--fs-caption);padding:0 20rpx}.alternatives{background:var(--c-surface);padding:16rpx}.alternative{padding:16rpx;border-bottom:1rpx solid var(--c-line)}
.camera-preview{width:100%;height:100%;position:absolute;inset:0}.camera-frame{pointer-events:none}
