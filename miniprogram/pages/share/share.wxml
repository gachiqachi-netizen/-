<view class="share-page">
  <view wx:if="{{loading}}" class="skeleton">正在生成分享海报…</view>
  <view wx:if="{{design}}">
    <view class="snapshot-stage"><bracelet3d id="share3d" beads="{{design.beads}}" catalog="{{catalog}}" selected="{{-1}}" bind:rendered="snapshotReady" bind:unavailable="snapshotUnavailable"/></view>
    <canvas canvas-id="shareCard" class="share-card" style="width:{{width}}px;height:{{height}}px"></canvas>
    <view wx:if="{{albumDenied}}" class="permission" bindtap="openAlbumSettings">没有相册权限，去设置打开 ›</view>
    <view wx:if="{{shareError}}" class="error">{{shareError}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view class="bottom"><button wx:if="{{!shareId}}" class="secondary" loading="{{shareBusy}}" bindtap="prepareShare">准备分享</button><button wx:else class="secondary" open-type="share">发给朋友</button><button class="primary" bindtap="saveCard" loading="{{saveBusy}}" disabled="{{!ready||saveBusy}}">保存图片</button></view>
  </view>
</view>
