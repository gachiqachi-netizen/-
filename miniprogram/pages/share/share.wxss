.share-card{display:block;max-width:100%;margin:0 auto;background:var(--c-bg)}
.snapshot-stage{position:fixed;left:-2000px;top:0;width:300px;height:230px;pointer-events:none}
.permission{text-align:center;font-size:var(--fs-caption);color:var(--c-text-2);margin-bottom:var(--sp-tight)}
.error{color:var(--c-danger);font-size:var(--fs-caption);text-align:center}
.share-loading{width:100%}
