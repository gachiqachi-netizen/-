.share-page{min-height:100vh;padding:24rpx 32rpx 170rpx;background:var(--c-surface);color:var(--c-text)}
.top-more{text-align:right;font-size:24rpx;padding:0 0 16rpx;color:var(--c-text-2)}
.share-card{display:block;max-width:100%;margin:0 auto;background:var(--c-bg)}
.snapshot-stage{position:fixed;left:-2000px;top:0;width:300px;height:230px;pointer-events:none}
.bottom{position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));background:var(--c-bg)}
.bottom button{flex:1;margin:0;border-radius:999rpx;font-size:28rpx}
.secondary{background:var(--c-surface);color:var(--c-text)}
.permission{margin-top:20rpx;text-align:center;font-size:24rpx;color:var(--c-text-2)}
.error{margin-top:16rpx;color:var(--c-danger);font-size:24rpx;text-align:center}
.skeleton{height:900rpx;background:var(--c-line);padding:30rpx}
