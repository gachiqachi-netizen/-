.share-page{padding:24rpx 32rpx 180rpx}.share-card{display:block;max-width:100%;border-radius:24rpx;background:#fff;box-shadow:0 2rpx 12rpx #0001}.notice{text-align:center;margin:18rpx 0;line-height:1.5}.text-button{background:transparent;color:#5e5753;font-size:26rpx}.share-action{background:#fff;color:#a82522;border:1rpx solid #c8302e;border-radius:999rpx;font-size:27rpx;margin:16rpx 0}.bottom{position:fixed;bottom:0;left:0;right:0;z-index:4;display:flex;align-items:center;gap:12rpx;padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));background:#fff;box-shadow:0 -4rpx 16rpx #0001}.bottom button{width:auto;min-width:0;margin:0;padding:16rpx 24rpx;white-space:nowrap}.sum{flex:1;min-width:0}.price{font-size:32rpx;font-weight:700;color:#c8302e}.tiny{font-size:22rpx;color:#736b66}.ghost{background:#fff;border:1rpx solid #aaa;color:#1f1b1a}.preview-label{text-align:center;color:#736b66;font-size:24rpx;margin-bottom:20rpx}.preview-ring{height:440rpx;position:relative;border-radius:24rpx;background:#f8f8f7;margin:24rpx 0}.bead{position:absolute;width:26rpx;height:26rpx;border-radius:50%;transform:translate(-50%,-50%);box-shadow:0 3rpx 6rpx #0002}.block{width:100%;margin-top:16rpx}.error{color:#b42318;font-size:26rpx;margin:12rpx 0}

.snapshot-stage{position:fixed;left:-2000px;top:0;width:300px;height:230px;pointer-events:none}.preview-ring{height:460rpx}
