.stage{height:460rpx;position:relative;margin:24rpx auto;width:100%;background:#fafafa;border-radius:24rpx}.bead{width:24rpx;height:24rpx;position:absolute;border-radius:50%;transform:translate(-50%,-50%);box-shadow:inset -3rpx -3rpx 6rpx #0003}

.wrap{padding-bottom:180rpx}.shared-bottom{position:fixed;bottom:0;left:0;right:0;background:white;display:flex;align-items:center;gap:12rpx;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));z-index:4}.shared-sum{flex:1;color:#c8302e;font-size:32rpx;font-weight:700}.shared-sum .sub{font-weight:400;font-size:22rpx}.shared-bottom button{margin:0;width:auto;padding:0 20rpx;font-size:26rpx}.shared-bottom .ghost{background:#fff;border:1rpx solid #8f8781}
