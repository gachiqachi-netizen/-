.tryon-page{padding:24rpx 32rpx 180rpx;display:flex;flex-direction:column;gap:20rpx}.mode-chips{display:flex;gap:12rpx}.mode{margin:0;padding:10rpx 22rpx;font-size:26rpx;border:1rpx solid #ddd;background:#fff;border-radius:999rpx}.mode.on{background:#fbecea;border-color:#c8302e;color:#a82522}.empty{height:560rpx;display:flex;flex-direction:column;gap:12rpx;align-items:center;justify-content:center;background:#f8f8f7;border-radius:24rpx;font-size:30rpx;text-align:center}.photo-stage{display:block;background:#f8f8f7;border-radius:24rpx;overflow:hidden}.photo-actions{display:flex;gap:16rpx;margin:20rpx 0}.photo-actions button{flex:1;margin:0}.ghost{background:#fff;color:#1f1b1a;border:1rpx solid #aaa}.controls{display:flex;flex-direction:column;gap:12rpx}.slider,.switchrow{display:flex;align-items:center;gap:18rpx;font-size:26rpx}.slider text{width:70rpx}.slider slider{flex:1}.switchrow{justify-content:space-between}.model-stage{height:460rpx;border-radius:24rpx;overflow:hidden}.skin-card{display:flex;align-items:center;justify-content:space-between;margin:20rpx 0}.skins{display:flex;gap:18rpx}.skin{width:52rpx;height:52rpx;border-radius:50%;border:4rpx solid #fff;box-shadow:0 0 0 2rpx #dedbd8}.skin.on{box-shadow:0 0 0 4rpx #c8302e}.summary{margin-top:18rpx;display:grid;gap:8rpx}.bottom{position:fixed;bottom:0;left:0;right:0;z-index:5;display:flex;align-items:center;gap:12rpx;padding:16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));background:white;box-shadow:0 -4rpx 16rpx #0001}.bottom button{margin:0;padding:16rpx 24rpx;white-space:nowrap}.sum{flex:1;min-width:0}.price{font-size:32rpx;font-weight:700;color:#c8302e}.tiny{font-size:22rpx;color:#736b66}.error{color:#b42318;font-size:25rpx}
.mode,.photo-actions button,.bottom button{width:auto;min-width:0}.mode{flex:0 0 auto}.photo-actions button{flex:1 1 0}
.mode{width:180rpx;min-width:180rpx;max-width:180rpx;box-sizing:border-box;flex:0 0 180rpx}
.photo-layer{position:relative;border-radius:24rpx;background:#f8f8f7;overflow:hidden}.photo-image{position:absolute;left:0;top:0;width:100%;height:100%}.photo-ring{position:absolute;left:0;top:0;width:100%;height:100%}.compose-canvas{position:fixed;left:-10000px;top:0;pointer-events:none}

.photo-layer,.photo-stage{margin-left:auto;margin-right:auto;max-width:100%}
.tryon-page{box-sizing:border-box;padding-bottom:calc(200rpx + env(safe-area-inset-bottom))}
