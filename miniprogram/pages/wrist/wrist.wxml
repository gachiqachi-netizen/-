<view class="wrist-page">
  <view wx:if="{{!measured}}" class="intro">还没量过，先按常见的 15cm</view><view wx:else class="intro-spacer"></view>
  <view class="measure-row"><button class="step" disabled="{{min}}" data-step="-0.5" bindtap="step">−</button><view class="measure"><text class="measure-number">{{display}}</text><text class="measure-unit"> cm</text></view><button class="step" disabled="{{max}}" data-step="0.5" bindtap="step">＋</button></view>
  <view class="ruler" bindtouchstart="rulerStart" bindtouchmove="rulerMove" bindtouchend="rulerEnd"><view class="ruler-mark" style="left:{{marker}}%"></view></view>
  <view class="bead-count">按 {{mm}}mm 珠子，大约 {{count}} 颗</view>
  <view class="tabs"><view class="tab {{noTape?'':'on'}}" data-tape="yes" bindtap="tape">有软尺</view><view class="tab {{noTape?'on':''}}" data-tape="no" bindtap="tape">没有软尺</view></view>
  <view wx:if="{{!noTape}}" class="guide">软尺贴着手腕骨绕一圈，不松不紧，读数就是手围。<view class="guide-image">示意图：软尺绕手腕</view></view>
  <view wx:else class="guide steps"><view>1　剪一条纸条，贴着手腕骨绕一圈，不松不紧</view><view>2　在纸条重合的地方做个记号</view><view>3　把纸条放平，用直尺量到记号，就是手围</view></view>
  <view class="bottom"><button class="primary" bindtap="confirm">就按 {{wrist}}cm</button></view>
</view>
