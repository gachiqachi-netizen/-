.wrist-page{min-height:100vh;padding:0 40rpx 180rpx;background:var(--c-bg);color:var(--c-text);box-sizing:border-box}.intro,.intro-spacer{height:80rpx;padding-top:16rpx;text-align:center;color:var(--c-text-2);font-size:24rpx;box-sizing:border-box}.measure-row{display:flex;align-items:center;justify-content:center;gap:48rpx;margin-top:36rpx}.step{width:80rpx;height:80rpx;line-height:76rpx;padding:0;border:1rpx solid var(--c-border);border-radius:50%;background:var(--c-bg);color:var(--c-text);font-size:40rpx}.step[disabled]{opacity:.3}.step::after{border:0}.measure{white-space:nowrap}.measure-number{font-size:96rpx;font-weight:600;line-height:1.2}.measure-unit{font-size:28rpx}.ruler{position:relative;height:48rpx;margin:38rpx 0 0;background:repeating-linear-gradient(90deg,var(--c-border) 0 2rpx,transparent 2rpx 20rpx) center / 100% 24rpx no-repeat}.ruler-mark{position:absolute;top:0;width:4rpx;height:48rpx;background:var(--c-text)}.bead-count{text-align:center;font-size:28rpx;margin-top:24rpx}.tabs{display:flex;border-bottom:1rpx solid var(--c-border);margin-top:48rpx}.tab{flex:1;text-align:center;padding:22rpx 0;color:var(--c-text-2);font-size:28rpx}.tab.on{color:var(--c-text);border-bottom:3rpx solid var(--c-text)}.guide{padding-top:28rpx;font-size:28rpx;line-height:1.7}.guide-image{height:280rpx;margin-top:28rpx;background:var(--c-surface);display:flex;align-items:center;justify-content:center;color:var(--c-text-2)}.steps{display:grid;gap:32rpx}.bottom{position:fixed;left:0;right:0;bottom:0;padding:20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));background:var(--c-bg)}.primary{border-radius:999rpx;background:var(--c-text);color:var(--c-bg);font-size:30rpx}.primary::after{border:0}
