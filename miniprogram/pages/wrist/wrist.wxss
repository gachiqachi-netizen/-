.wrist-page{padding-bottom:180rpx}.intro{font-size:26rpx;color:#5e5753;background:#f8f8f7;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx;line-height:1.6}.wristcard{padding:32rpx}.bigwrist{display:flex;align-items:center;justify-content:center;gap:30rpx}.step{width:88rpx;height:88rpx;line-height:84rpx;padding:0;border:1rpx solid #8f8781;border-radius:50%;background:#fff;font-size:44rpx}.measure{display:flex;align-items:baseline;justify-content:center;width:280rpx}.measure input{font-size:72rpx;font-weight:700;text-align:center;width:180rpx}.measure text{font-size:28rpx;color:#5e5753}.ruler{position:relative;height:56rpx;margin:32rpx 0;background:repeating-linear-gradient(90deg,#8f8781 0 2rpx,transparent 2rpx 20rpx) bottom / 100% 20rpx no-repeat,#f7f6f4;border-radius:12rpx;overflow:hidden}.ruler-fill{position:absolute;height:100%;background:#fbecea;border-right:4rpx solid #c8302e;opacity:.75}.presets{display:flex;justify-content:center;flex-wrap:wrap;gap:12rpx}.preset{width:auto;flex:0 0 auto;font-size:24rpx;line-height:1.4;padding:10rpx 18rpx;margin:0;background:#fff;border:1rpx solid #ddd;border-radius:999rpx}.preset.on{background:#fbecea;border-color:#c8302e;color:#a82522}.guide{display:grid;gap:18rpx;color:#5e5753;line-height:1.55}.guide .title{font-size:32rpx;color:#1f1b1a}.bottom{position:fixed;bottom:0;left:0;right:0;background:#fff;padding:20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eee}.bottom button{margin:0;min-width:200rpx}.wrist-value{font-size:34rpx;font-weight:700}
.step{width:88rpx;min-width:88rpx;max-width:88rpx;flex:none;box-sizing:border-box;margin:0}
