.box { position: relative; }
.string {
  position: absolute;
  border-radius: 50%;
  border: 3rpx solid rgba(200, 60, 40, 0.55);
  box-sizing: border-box;
}
.rot { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.rot.anim { transition: transform 0.25s ease-out; }
.bead {
  position: absolute;
  border-radius: 50%;
  box-shadow: inset -6rpx -8rpx 14rpx rgba(0, 0, 0, 0.35), 0 6rpx 12rpx rgba(0, 0, 0, 0.45);
}
.empty {
  position: absolute; left: 0; right: 0; top: 46%;
  text-align: center; color: #9a8a7a;
}
