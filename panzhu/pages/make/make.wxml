<view class="page">
  <view class="preview">
    <bracelet beads="{{beads}}" size="{{size}}" box="{{560}}" maxScale="{{1.3}}" bind:beadtap="removeAt" />
    <view class="count muted">{{beads.length}} / {{max}} 颗</view>
  </view>

  <view class="tools">
    <view class="tool" bindtap="undo">撤销</view>
    <view class="tool" bindtap="clear">清空</view>
    <view class="tool" bindtap="random">随机搭配</view>
    <view class="sizes">
      <view wx:for="{{sizes}}" wx:key="v" class="sz {{size === item.v ? 'on' : ''}}"
        data-v="{{item.v}}" bindtap="setSize">{{item.t}}</view>
    </view>
  </view>

  <view class="tip muted">点珠子串上去，点手串上的珠子可以取下</view>
  <view class="grid">
    <view wx:for="{{materials}}" wx:key="id" class="cell" data-id="{{item.id}}" bindtap="pick">
      <view class="ball" style="background:{{item.bg}}"></view>
      <view class="nm">{{item.name}}</view>
    </view>
  </view>

  <input class="name" placeholder="给手串起个名字（可不填）" value="{{name}}" bindinput="onName" maxlength="12" />
  <view class="btn" bindtap="save">串好了，去盘</view>
</view>
