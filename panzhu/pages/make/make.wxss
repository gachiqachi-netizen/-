.page { padding: 20rpx 32rpx 60rpx; }
.preview { display: flex; flex-direction: column; align-items: center; }
.count { margin-top: -10rpx; font-size: 24rpx; }
.tools { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 0 10rpx; }
.tool { padding: 12rpx 22rpx; border-radius: 30rpx; background: rgba(255,255,255,0.08); font-size: 26rpx; }
.sizes { display: flex; background: rgba(255,255,255,0.08); border-radius: 30rpx; overflow: hidden; }
.sz { padding: 12rpx 22rpx; font-size: 26rpx; }
.sz.on { background: #e8b86b; color: #2a1a10; }
.tip { font-size: 24rpx; margin: 16rpx 0; text-align: center; }
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 20%; display: flex; flex-direction: column; align-items: center; margin-bottom: 24rpx; }
.ball {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  box-shadow: inset -6rpx -8rpx 14rpx rgba(0,0,0,0.35), 0 6rpx 12rpx rgba(0,0,0,0.45);
}
.cell:active .ball { transform: scale(0.9); }
.nm { font-size: 22rpx; margin-top: 10rpx; color: #d9c9b4; }
.name {
  background: rgba(255,255,255,0.08); border-radius: 20rpx; padding: 20rpx 24rpx;
  margin: 10rpx 0 30rpx; color: #f1e6d6; height: 44rpx;
}
